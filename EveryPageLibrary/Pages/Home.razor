@page "/"
@using EveryPageLibrary.Models
@using EveryPageLibrary.Services
@inject ArchiveService ArchiveService
@inject FederatedBookService FederatedBooks
@inject InternetArchiveBookSource InternetArchive
@inject AuthStateService AuthState
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<!-- ================= HERO: front-page comic strip ================= -->
<section class="relative bg-[#FFFDF7] border-b-2 border-[#1C1917]">
    <div class="absolute inset-0 halftone-soft pointer-events-none" aria-hidden="true"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-12 sm:pt-14 sm:pb-16">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">

            <!-- Panel 1: headline + featured paperbacks -->
            <div class="lg:col-span-7 text-center lg:text-left">
                <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 mb-5">
                    <span class="stamp bg-[#F4C430] text-[#1C1917] shadow-[2px_2px_0px_#1C1917]">For the People, Built by the People</span>
                    <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#57534E]">Free &middot; Open &middot; Daily</span>
                </div>

                <h1 class="font-comic text-5xl sm:text-6xl lg:text-7xl font-bold text-[#1C1917] leading-[0.95] tracking-tight">
                    EveryPage Library
                </h1>

                <div class="zigzag-rule w-44 mt-5 mb-4 mx-auto lg:mx-0" aria-hidden="true"></div>

                <p class="font-serif italic text-lg sm:text-xl text-[#57534E] max-w-xl mx-auto lg:mx-0">
                    &ldquo;Everything Humanity Has Written, Open to Everyone.&rdquo;
                </p>

                <div class="mt-9 max-w-lg mx-auto lg:mx-0">
                    <div class="flex items-center justify-between mb-3">
                        <span class="font-mono text-[11px] font-bold uppercase tracking-[0.18em] text-[#1C1917]">
                            Featured Books
                        </span>
                        @if (books.Count > 3)
                        {
                            <button type="button"
                                    @onclick="ShuffleFeaturedBooks"
                                    class="ink-btn inline-flex items-center gap-1.5 px-2.5 py-1 font-mono text-[11px] font-bold uppercase bg-[#FFFDF7] hover:bg-[#F4C430] text-[#1C1917] rounded-sm">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="16 3 21 3 21 8"></polyline>
                                    <line x1="4" y1="20" x2="21" y2="3"></line>
                                    <polyline points="21 16 21 21 16 21"></polyline>
                                    <line x1="15" y1="15" x2="21" y2="21"></line>
                                    <line x1="4" y1="4" x2="9" y2="9"></line>
                                </svg>
                                Shuffle
                            </button>
                        }
                    </div>

                    @if (featuredBooks.Count > 0)
                    {
                        <div class="grid grid-cols-3 gap-3 sm:gap-5">
                            @for (int idx = 0; idx < featuredBooks.Count; idx++)
                            {
                                var featured = featuredBooks[idx];
                                var spineColor = (idx % 3) switch
                                {
                                    0 => "bg-[#D93829]",
                                    1 => "bg-[#F4C430]",
                                    _ => "bg-[#6BA4B8]"
                                };
                                <button type="button"
                                        @onclick="() => OpenReader(featured)"
                                        title="@featured.Title by @featured.Author"
                                        class="group relative aspect-[2/3] flex text-left overflow-hidden rounded-r-sm rounded-l-[2px] border-2 border-[#1C1917] bg-[#FFFDF7] shadow-[4px_4px_0px_#1C1917] transition-all duration-150 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[6px_6px_0px_#1C1917] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none">
                                    <!-- Spine -->
                                    <div class="relative w-2.5 sm:w-3 shrink-0 @spineColor border-r-2 border-[#1C1917]">
                                        <div class="absolute inset-x-0 top-2 h-[1.5px] bg-[#1C1917]/60"></div>
                                        <div class="absolute inset-x-0 bottom-2 h-[1.5px] bg-[#1C1917]/60"></div>
                                    </div>

                                    <!-- Cover face -->
                                    <div class="relative flex-1 flex flex-col overflow-hidden">
                                        @if (!string.IsNullOrWhiteSpace(featured.CoverUrl))
                                        {
                                            <img src="@featured.CoverUrl"
                                                 alt="@featured.Title"
                                                 loading="lazy"
                                                 class="absolute inset-0 w-full h-full object-cover" />
                                            <span class="absolute top-1.5 left-1.5 px-1 font-mono text-[9px] font-bold bg-[#FFFDF7] border border-[#1C1917]">
                                                No.@((idx + 1).ToString("D2"))
                                            </span>
                                            <div class="relative mt-auto p-2 bg-gradient-to-t from-[#1C1917] via-[#1C1917]/85 to-transparent text-[#FFFDF7]">
                                                <div class="font-serif text-[11px] sm:text-xs font-bold leading-tight line-clamp-2">
                                                    @featured.Title
                                                </div>
                                                <div class="font-mono text-[9px] text-[#F4C430] truncate mt-0.5">
                                                    @featured.Author
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="flex-1 flex flex-col bg-[#FFFDF7]">
                                                <div class="flex items-center justify-between gap-1 px-2 pt-2">
                                                    <span class="font-mono text-[8px] sm:text-[9px] font-bold text-[#57534E]">
                                                        No.@((idx + 1).ToString("D2"))
                                                    </span>
                                                    <span class="w-2 h-2 rounded-full border border-[#1C1917] bg-[#D93829]"></span>
                                                </div>
                                                <span class="mx-2 mt-1.5 self-start max-w-[90%] truncate px-1.5 py-0.5 font-mono text-[8px] sm:text-[9px] font-bold uppercase tracking-wider border border-[#1C1917] bg-[#F2EAD8] text-[#1C1917]">
                                                    @featured.GenreLabel
                                                </span>

                                                <div class="my-auto px-2.5 py-2">
                                                    <div class="font-serif text-xs sm:text-sm font-bold text-[#1C1917] leading-snug line-clamp-3 group-hover:text-[#D93829] transition-colors">
                                                        @featured.Title
                                                    </div>
                                                </div>

                                                <div class="zigzag-band zigzag-band-sm" aria-hidden="true"></div>
                                                <div class="px-2 py-1.5 bg-[#F2EAD8] font-mono text-[9px] sm:text-[10px] text-[#57534E] truncate">
                                                    @featured.Author
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-3 gap-3 sm:gap-5">
                            @for (int i = 0; i < 3; i++)
                            {
                                <div class="aspect-[2/3] rounded-sm border-2 border-[#1C1917]/25 skeleton-ink"></div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Panel 2: ink illustration -->
            <div class="lg:col-span-5 flex justify-center lg:justify-end select-none">
                <figure class="w-full max-w-sm bg-[#FAF6EC] border-2 border-[#1C1917] shadow-[4px_4px_0px_#1C1917] rounded-sm overflow-hidden">
                    <div class="flex items-center justify-between px-3 py-1.5 border-b-2 border-[#1C1917] bg-[#FFFDF7] font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-[#57534E]">
                        <span>Panel 01</span>
                        <span>The Reading Hall</span>
                    </div>
                    <div class="halftone px-4 pt-4 pb-2">
                        <svg class="w-full h-auto" viewBox="0 0 260 180" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Ink drawing of an open book on a stack of books under a small rain cloud">
                            <!-- rain cloud -->
                            <path d="M30 50 Q22 36 38 32 Q40 18 56 21 Q66 9 80 19 Q96 15 98 30 Q110 34 104 50 Z" fill="#FFFDF7" stroke="#1C1917" stroke-width="2.5" stroke-linejoin="round"/>
                            <g stroke="#6BA4B8" stroke-width="2.5" stroke-linecap="round">
                                <line x1="44" y1="58" x2="40" y2="68"/>
                                <line x1="58" y1="58" x2="54" y2="72"/>
                                <line x1="72" y1="58" x2="68" y2="68"/>
                                <line x1="86" y1="58" x2="82" y2="72"/>
                            </g>
                            <!-- loose pages -->
                            <g transform="rotate(-12 190 34)">
                                <rect x="178" y="20" width="24" height="30" fill="#FFFDF7" stroke="#1C1917" stroke-width="2"/>
                                <line x1="182" y1="27" x2="198" y2="27" stroke="#1C1917" stroke-width="1.5"/>
                                <line x1="182" y1="33" x2="196" y2="33" stroke="#1C1917" stroke-width="1.5"/>
                                <line x1="182" y1="39" x2="194" y2="39" stroke="#1C1917" stroke-width="1.5"/>
                            </g>
                            <g transform="rotate(14 224 52)">
                                <rect x="212" y="38" width="22" height="28" fill="#FFFDF7" stroke="#1C1917" stroke-width="2"/>
                                <line x1="216" y1="45" x2="230" y2="45" stroke="#1C1917" stroke-width="1.5"/>
                                <line x1="216" y1="51" x2="227" y2="51" stroke="#1C1917" stroke-width="1.5"/>
                            </g>
                            <g stroke="#1C1917" stroke-width="2" stroke-linecap="round">
                                <line x1="160" y1="34" x2="168" y2="26"/>
                                <line x1="164" y1="46" x2="174" y2="42"/>
                            </g>
                            <!-- book stack -->
                            <rect x="44" y="140" width="172" height="20" fill="#D93829" stroke="#1C1917" stroke-width="2.5"/>
                            <line x1="58" y1="140" x2="58" y2="160" stroke="#1C1917" stroke-width="2"/>
                            <line x1="202" y1="140" x2="202" y2="160" stroke="#1C1917" stroke-width="2"/>
                            <rect x="56" y="122" width="148" height="18" fill="#6BA4B8" stroke="#1C1917" stroke-width="2.5"/>
                            <line x1="70" y1="122" x2="70" y2="140" stroke="#1C1917" stroke-width="2"/>
                            <line x1="190" y1="122" x2="190" y2="140" stroke="#1C1917" stroke-width="2"/>
                            <rect x="50" y="104" width="160" height="18" fill="#F4C430" stroke="#1C1917" stroke-width="2.5"/>
                            <path d="M74 115 L82 110 L90 115 L98 110 L106 115 L114 110 L122 115 L130 110 L138 115 L146 110 L154 115 L162 110 L170 115 L178 110 L186 115" stroke="#1C1917" stroke-width="2.5" fill="none"/>
                            <!-- open book -->
                            <path d="M130 104 Q104 86 70 92 L70 64 Q104 58 130 78 Z" fill="#FFFDF7" stroke="#1C1917" stroke-width="2.5" stroke-linejoin="round"/>
                            <path d="M130 104 Q156 86 190 92 L190 64 Q156 58 130 78 Z" fill="#FFFDF7" stroke="#1C1917" stroke-width="2.5" stroke-linejoin="round"/>
                            <line x1="130" y1="78" x2="130" y2="104" stroke="#1C1917" stroke-width="2"/>
                            <g stroke="#57534E" stroke-width="1.6" stroke-linecap="round" fill="none">
                                <path d="M80 74 Q102 70 122 82"/>
                                <path d="M80 82 Q102 78 122 90"/>
                                <path d="M180 74 Q158 70 138 82"/>
                                <path d="M180 82 Q158 78 138 90"/>
                            </g>
                            <!-- ink sparks -->
                            <g stroke="#1C1917" stroke-width="2.2" stroke-linecap="round">
                                <line x1="130" y1="58" x2="130" y2="46"/>
                                <line x1="112" y1="60" x2="105" y2="51"/>
                                <line x1="148" y1="60" x2="155" y2="51"/>
                            </g>
                            <line x1="16" y1="160" x2="244" y2="160" stroke="#1C1917" stroke-width="3" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <figcaption class="px-3 py-2 border-t-2 border-[#1C1917] bg-[#FFFDF7] text-center font-mono text-[11px] text-[#57534E]">
                        Rainy day? Open a book. Everything else can wait.
                    </figcaption>
                </figure>
            </div>
        </div>
    </div>

    <div class="zigzag-band" aria-hidden="true"></div>
</section>

<!-- ================= MAIN READING HALL ================= -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">

    <!-- Card Catalog: search + facets -->
    <section class="bg-[#FFFDF7] border-2 border-[#1C1917] shadow-[4px_4px_0px_#1C1917] rounded-sm mb-10" aria-label="Search and filters">
        <div class="flex items-center justify-between gap-3 px-4 sm:px-5 py-2.5 border-b-2 border-[#1C1917] bg-[#F2EAD8]">
            <h2 class="font-comic text-lg sm:text-xl font-bold text-[#1C1917]">The Card Catalog</h2>
            <span class="hidden sm:inline font-mono text-[11px] uppercase tracking-[0.18em] text-[#57534E]">Search &middot; Filter &middot; Read</span>
        </div>

        <div class="p-4 sm:p-5">
            <div class="flex flex-col sm:flex-row items-stretch gap-3">
                <form @onsubmit="ApplySearch" class="flex-1 flex items-stretch gap-2">
                    <div class="relative flex-1">
                        <svg class="w-4 h-4 text-[#57534E] absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input type="text"
                               @bind="searchQuery"
                               aria-label="Search the library"
                               placeholder="Search Standard Ebooks, Project Gutenberg, Open Library, Internet Archive, Wikibooks, Sacred Texts..."
                               class="ink-field w-full h-12 text-base pl-11 pr-10 rounded-sm shadow-[2px_2px_0px_#1C1917]" />
                        @if (!string.IsNullOrWhiteSpace(searchQuery))
                        {
                            <button type="button"
                                    @onclick="ClearSearch"
                                    aria-label="Clear search"
                                    class="absolute right-2.5 top-1/2 -translate-y-1/2 w-7 h-7 inline-flex items-center justify-center rounded-sm text-[#57534E] hover:text-[#1C1917] hover:bg-[#F2EAD8]">
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                </svg>
                            </button>
                        }
                    </div>
                    <button type="submit"
                            class="ink-btn h-12 px-5 text-sm font-comic font-bold uppercase bg-[#F4C430] hover:bg-[#e5b522] text-[#1C1917] rounded-sm">
                        Search
                    </button>
                </form>

                <button type="button"
                        @onclick="TriggerUploadDrawer"
                        class="ink-btn h-12 inline-flex items-center justify-center gap-2 px-5 text-sm font-comic font-bold uppercase bg-[#D93829] hover:bg-[#c22e20] text-[#FFFDF7] rounded-sm whitespace-nowrap">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" aria-hidden="true">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span>Upload PDF</span>
                </button>
            </div>
        </div>

        <div class="border-t-2 border-dashed border-[#1C1917]/30 px-4 sm:px-5 py-5 space-y-5">
            <!-- Primary Domain / Subject -->
            <div>
                <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
                    <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-[#57534E]">
                        Primary Domain / Subject (@BookGenres.DomainTags.Count Non-Overlapping Domains)
                    </span>
                    <button type="button"
                            @onclick="() => showAllTags = !showAllTags"
                            class="font-mono text-xs font-bold text-[#D93829] hover:underline underline-offset-2">
                        @(showAllTags ? "Compact Domains \u25B2" : "Show All 15 Domains \u25BC")
                    </button>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    @foreach (var domain in VisibleDomains)
                    {
                        <button type="button"
                                @onclick="() => SelectCategory(domain)"
                                aria-pressed="@(selectedCategory == domain ? "true" : "false")"
                                class='ink-btn px-3.5 py-1.5 rounded-full text-xs font-mono font-bold @(selectedCategory == domain ? "bg-[#1C1917] text-[#F4C430]" : "bg-[#FFFDF7] hover:bg-[#F4C430]/40 text-[#1C1917]")'>
                            @domain
                        </button>
                    }
                </div>
            </div>

            <!-- Independent facet selectors -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
                <div>
                    <label class="block font-mono text-[10px] font-bold uppercase tracking-wider text-[#57534E] mb-1">Form &amp; Structure</label>
                    <select @bind="selectedForm" class="ink-field ink-select w-full text-xs font-mono py-2 pl-2.5 rounded-sm">
                        <option value="All">All Forms</option>
                        @foreach (var tag in BookGenres.FormTags)
                        {
                            <option value="@tag">@tag</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block font-mono text-[10px] font-bold uppercase tracking-wider text-[#57534E] mb-1">Factuality</label>
                    <select @bind="selectedFactuality" class="ink-field ink-select w-full text-xs font-mono py-2 pl-2.5 rounded-sm">
                        <option value="All">All Factuality</option>
                        @foreach (var tag in BookGenres.FactualityTags)
                        {
                            <option value="@tag">@tag</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block font-mono text-[10px] font-bold uppercase tracking-wider text-[#57534E] mb-1">Target Audience</label>
                    <select @bind="selectedAudience" class="ink-field ink-select w-full text-xs font-mono py-2 pl-2.5 rounded-sm">
                        <option value="All">All Audiences</option>
                        @foreach (var tag in BookGenres.AudienceTags)
                        {
                            <option value="@tag">@tag</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block font-mono text-[10px] font-bold uppercase tracking-wider text-[#57534E] mb-1">Era of Origin</label>
                    <select @bind="selectedEra" class="ink-field ink-select w-full text-xs font-mono py-2 pl-2.5 rounded-sm">
                        <option value="All">All Eras</option>
                        @foreach (var tag in BookGenres.EraTags)
                        {
                            <option value="@tag">@tag</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block font-mono text-[10px] font-bold uppercase tracking-wider text-[#57534E] mb-1">Rights &amp; Access</label>
                    <select @bind="selectedRights" class="ink-field ink-select w-full text-xs font-mono py-2 pl-2.5 rounded-sm">
                        <option value="All">All Access Tiers</option>
                        @foreach (var tag in BookGenres.RightsTags)
                        {
                            <option value="@tag">@tag</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </section>

    <!-- Shelf header -->
    <div class="flex items-end justify-between gap-3 mb-5">
        <div>
            <span class="font-mono text-[11px] font-bold uppercase tracking-[0.18em] text-[#57534E]">The Shelf</span>
            <h2 class="font-comic text-2xl sm:text-3xl font-bold text-[#1C1917] leading-tight">
                @(selectedCategory == "All" ? "Every Domain" : selectedCategory)
            </h2>
        </div>
        @if (!isInitialLoading)
        {
            <span class="stamp bg-[#FFFDF7] text-[#1C1917] shadow-[2px_2px_0px_#1C1917]">@FilteredBooks.Count on shelf</span>
        }
    </div>

    @if (isInitialLoading && books.Count == 0)
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @for (int i = 0; i < 12; i++)
            {
                <BookCardSkeleton />
            }
        </div>
    }
    else if (FilteredBooks.Count == 0)
    {
        <div class="max-w-md mx-auto my-14">
            <div class="speech-bubble p-7 sm:p-8 text-center">
                <h3 class="font-comic text-2xl font-bold text-[#1C1917] mb-2">No Index Cards Match These Axes</h3>
                <p class="text-base text-[#57534E] mb-5">
                    No editions match that exact combination of facets. Loosen one of the 6 taxonomy filters or load more cards!
                </p>
                <button type="button"
                        @onclick="ResetFilters"
                        class="ink-btn px-5 py-2 text-sm font-comic font-bold uppercase bg-[#F4C430] text-[#1C1917] rounded-sm">
                    Reset Facet Filters
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var book in FilteredBooks)
            {
                <BookCard Book="book"
                          IsAuditor="@AuthState.IsAuditor"
                          IsDownloading="@(downloadingBookKey == GetBookKey(book))"
                          OnRead="OpenReader"
                          OnDownload="b => DownloadBook(b, null)"
                          OnEdit="OpenEditModal"
                          OnSeal="PromptSeal" />
            }

            @if (isLoadingMore)
            {
                @for (int i = 0; i < 6; i++)
                {
                    <BookCardSkeleton />
                }
            }
        </div>

        <div @ref="scrollSentinel" class="h-14 mt-8 flex items-center justify-center">
            @if (!hasMorePages)
            {
                <div class="flex items-center gap-3 w-full max-w-md">
                    <span class="flex-1 border-t-2 border-dashed border-[#1C1917]/30"></span>
                    <p class="font-mono text-xs uppercase tracking-widest text-[#57534E] whitespace-nowrap">
                        End of shelf &middot; @FilteredBooks.Count books
                    </p>
                    <span class="flex-1 border-t-2 border-dashed border-[#1C1917]/30"></span>
                </div>
            }
        </div>
    }
</div>

<!-- Download status toast -->
@if (!string.IsNullOrWhiteSpace(downloadToastMessage))
{
    <div role="status" aria-live="polite"
         class="fixed bottom-5 right-5 z-50 max-w-sm bg-[#FFFDF7] border-2 border-[#1C1917] shadow-[4px_4px_0px_#1C1917] rounded-sm overflow-hidden animate-modal-in">
        <div class="h-1.5 border-b-2 border-[#1C1917] @(downloadToastIsWarning ? "bg-[#D93829]" : "bg-[#F4C430]")"></div>
        <div class="p-3.5 flex items-start gap-3">
            <span class="stamp shrink-0 @(downloadToastIsWarning ? "bg-[#D93829] text-[#FFFDF7]" : "bg-[#F4C430] text-[#1C1917]")">
                @(downloadToastIsWarning ? "Note" : "Done")
            </span>
            <div class="flex-1 text-xs font-mono text-[#1C1917] leading-snug pt-0.5">
                @downloadToastMessage
            </div>
            <button type="button" @onclick="() => downloadToastMessage = null" aria-label="Dismiss"
                    class="text-xs font-mono font-bold text-[#57534E] hover:text-[#1C1917]">&#x2715;</button>
        </div>
    </div>
}

<CodexReaderModal Book="selectedBookForReader"
                  IsOpen="isReaderOpen"
                  OnClose="() => isReaderOpen = false"
                  OnDownloadFormat="args => DownloadBook(args.Book, args.Format)"
                  OnRequestSignIn="() => isAuthModalOpen = true" />

<UploadTomeDrawer IsOpen="isUploadDrawerOpen"
                  OnClose="() => isUploadDrawerOpen = false"
                  OnTomeInscribed="HandleTomeInscribed" />

<AuthModal IsOpen="isAuthModalOpen"
           OnClose="() => isAuthModalOpen = false"
           OnAuthenticated="HandleAuthenticated" />

<EditTomeModal IsOpen="isEditModalOpen"
               Book="bookToEdit"
               OnClose="() => isEditModalOpen = false"
               OnSaved="HandleBookUpdated" />

@if (isSealPromptOpen && bookToSeal != null)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#1C1917]/60 flex items-center justify-center p-4 animate-modal-in" role="dialog" aria-modal="true">
        <div class="w-full max-w-md bg-[#FFFDF7] border-2 border-[#1C1917] shadow-[6px_6px_0px_#1C1917] rounded-sm overflow-hidden">
            <div class="px-6 py-4 border-b-2 border-[#1C1917] bg-[#D93829] text-[#FFFDF7]">
                <span class="font-mono text-[11px] font-bold uppercase tracking-[0.18em] opacity-90">Moderation</span>
                <h3 class="font-comic text-2xl font-bold leading-tight">Remove Index Card?</h3>
            </div>
            <div class="p-6 space-y-4">
                <p class="text-base text-[#1C1917]">
                    Deleting <strong class="font-serif">@bookToSeal.Title</strong> removes it from the public shelf. You can restore it anytime from Site Audit.
                </p>
                <div>
                    <label class="block text-[11px] font-mono font-bold uppercase tracking-wider text-[#57534E] mb-1">Reason</label>
                    <input type="text"
                           @bind="sealReason"
                           class="ink-field w-full text-sm p-2.5 rounded-sm" />
                </div>
                <div class="flex items-center justify-end gap-3 pt-3 border-t-2 border-dashed border-[#1C1917]/25">
                    <button type="button" @onclick="() => isSealPromptOpen = false" class="ink-btn px-4 py-1.5 text-xs font-mono font-bold uppercase bg-[#FFFDF7] text-[#1C1917] rounded-sm">Cancel</button>
                    <button type="button" @onclick="ConfirmSealBook" class="ink-btn px-4 py-1.5 text-xs font-mono font-bold uppercase bg-[#D93829] text-[#FFFDF7] rounded-sm">Confirm Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Book> books = new();
    private List<Book> featuredBooks = new();

    private string selectedCategory = "All";
    private string selectedForm = "All";
    private string selectedFactuality = "All";
    private string selectedAudience = "All";
    private string selectedEra = "All";
    private string selectedRights = "All";

    private string searchQuery = "";
    private bool showAllTags = false;

    private bool isInitialLoading = true;
    private bool isLoadingMore = false;
    private bool hasMorePages = true;
    private int currentPage = 1;
    private int loadVersion = 0;

    private string? downloadingBookKey;
    private string? downloadToastMessage;
    private bool downloadToastIsWarning;

    private ElementReference scrollSentinel;
    private DotNetObjectReference<Home>? dotNetRef;
    private CancellationTokenSource? loadCts;

    private bool isReaderOpen = false;
    private Book? selectedBookForReader;

    private bool isUploadDrawerOpen = false;
    private bool isAuthModalOpen = false;

    private bool isEditModalOpen = false;
    private Book? bookToEdit;

    private bool isSealPromptOpen = false;
    private Book? bookToSeal;
    private string sealReason = "";

    private IEnumerable<string> VisibleDomains =>
        showAllTags ? BookGenres.Filters : BookGenres.Filters.Take(9);

    private void ShuffleFeaturedBooks()
    {
        if (books.Count == 0)
        {
            featuredBooks.Clear();
            return;
        }

        featuredBooks = books
            .OrderBy(_ => Random.Shared.Next())
            .Take(3)
            .ToList();
    }

    private List<Book> FilteredBooks => books.Where(b =>
        (selectedForm == "All" || b.FormTag.Equals(selectedForm, StringComparison.OrdinalIgnoreCase)) &&
        (selectedFactuality == "All" || b.FactualityTag.Equals(selectedFactuality, StringComparison.OrdinalIgnoreCase)) &&
        (selectedAudience == "All" || b.AudienceTag.Equals(selectedAudience, StringComparison.OrdinalIgnoreCase)) &&
        (selectedEra == "All" || b.EraTag.Equals(selectedEra, StringComparison.OrdinalIgnoreCase)) &&
        (selectedRights == "All" || b.RightsTag.Equals(selectedRights, StringComparison.OrdinalIgnoreCase))
    ).ToList();

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += HandleAuthStateChange;
        await LoadFirstPageAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (books.Count > 0 && hasMorePages)
        {
            dotNetRef ??= DotNetObjectReference.Create(this);
            try
            {
                await JSRuntime.InvokeVoidAsync("EveryPageLibrary.observeSentinel", scrollSentinel, dotNetRef);
            }
            catch { }
        }
    }

    [JSInvokable]
    public async Task OnScrollBottomReached()
    {
        if (!isInitialLoading && !isLoadingMore && hasMorePages)
        {
            await LoadNextPageAsync();
        }
    }

    private void HandleAuthStateChange() => InvokeAsync(StateHasChanged);

    private static string GetBookKey(Book b) =>
        !string.IsNullOrWhiteSpace(b.ExternalId) ? b.ExternalId! : $"{b.Id}|{b.Title}|{b.Author}";

    private async Task LoadFirstPageAsync()
    {
        loadCts?.Cancel();
        loadCts = new CancellationTokenSource();
        var token = loadCts.Token;
        var version = ++loadVersion;

        isInitialLoading = true;
        isLoadingMore = false;
        currentPage = 1;
        hasMorePages = true;
        books.Clear();
        StateHasChanged();

        try
        {
            var localTask = ArchiveService.GetBooksAsync(selectedCategory, searchQuery, 60);

            var localBooks = await localTask;
            if (token.IsCancellationRequested || version != loadVersion) return;

            if (localBooks.Count > 0)
            {
                books = new List<Book>(localBooks);
                if (featuredBooks.Count == 0) ShuffleFeaturedBooks();
                isInitialLoading = false;
                StateHasChanged();
            }

            _ = FederatedBooks.PrefetchPageAsync(searchQuery, selectedCategory, page: 2, token);

            var webBooks = await FederatedBooks.SearchPagedAsync(
                searchQuery,
                selectedCategory,
                page: 1,
                onPartialBatchReady: partial =>
                {
                    if (token.IsCancellationRequested || version != loadVersion) return;
                    isInitialLoading = false;
                    MergeAndRender(localBooks, partial);
                    if (featuredBooks.Count < 3) ShuffleFeaturedBooks();
                },
                cancellationToken: token);

            if (token.IsCancellationRequested || version != loadVersion) return;

            isInitialLoading = false;
            MergeAndRender(localBooks, webBooks);
            ShuffleFeaturedBooks();
            hasMorePages = webBooks.Count >= 8;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading catalog: {ex.Message}");
        }
        finally
        {
            if (!token.IsCancellationRequested && version == loadVersion)
            {
                isInitialLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task LoadNextPageAsync()
    {
        if (isLoadingMore || isInitialLoading || !hasMorePages) return;

        var version = loadVersion;
        var nextPage = currentPage + 1;
        var isAlreadyCached = FederatedBooks.IsCached(searchQuery, selectedCategory, nextPage);

        isLoadingMore = true;
        if (!isAlreadyCached) StateHasChanged();

        try
        {
            var moreBooks = await FederatedBooks.SearchPagedAsync(
                searchQuery,
                selectedCategory,
                nextPage,
                onPartialBatchReady: partial =>
                {
                    if (version != loadVersion) return;
                    AppendUniqueBooks(partial);
                    InvokeAsync(StateHasChanged);
                });

            if (version != loadVersion) return;

            if (moreBooks.Count == 0)
            {
                hasMorePages = false;
            }
            else
            {
                currentPage = nextPage;
                AppendUniqueBooks(moreBooks);
                _ = FederatedBooks.PrefetchPageAsync(searchQuery, selectedCategory, currentPage + 1);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading page {nextPage}: {ex.Message}");
        }
        finally
        {
            if (version == loadVersion)
            {
                isLoadingMore = false;
                StateHasChanged();
            }
        }
    }

    private void AppendUniqueBooks(List<Book> incoming)
    {
        var existingKeys = new HashSet<string>(books.Select(GetBookKey), StringComparer.OrdinalIgnoreCase);
        foreach (var item in incoming)
        {
            if (existingKeys.Add(GetBookKey(item)))
            {
                books.Add(item);
            }
        }
    }

    private void MergeAndRender(List<Book> localBooks, List<Book> webBooks)
    {
        var seenExternal = new HashSet<string>(
            localBooks.Where(b => !string.IsNullOrWhiteSpace(b.ExternalId)).Select(b => b.ExternalId!),
            StringComparer.OrdinalIgnoreCase);

        var combined = new List<Book>(localBooks.Count + webBooks.Count);
        combined.AddRange(localBooks);

        foreach (var ext in webBooks)
        {
            if (!string.IsNullOrWhiteSpace(ext.ExternalId) && !seenExternal.Add(ext.ExternalId))
                continue;

            combined.Add(ext);
        }

        books = combined;
        InvokeAsync(StateHasChanged);
    }

    private async Task SelectCategory(string category) { selectedCategory = category; await LoadFirstPageAsync(); }
    private async Task ApplySearch() => await LoadFirstPageAsync();
    private async Task ClearSearch() { searchQuery = ""; await LoadFirstPageAsync(); }

    private async Task ResetFilters()
    {
        selectedCategory = "All";
        selectedForm = "All";
        selectedFactuality = "All";
        selectedAudience = "All";
        selectedEra = "All";
        selectedRights = "All";
        searchQuery = "";
        await LoadFirstPageAsync();
    }

    private void OpenReader(Book book) { selectedBookForReader = book; isReaderOpen = true; }

    private async Task DownloadBook(Book book, string? preferredFormat)
    {
        var key = GetBookKey(book);
        if (downloadingBookKey == key) return;

        downloadingBookKey = key;
        downloadToastIsWarning = false;
        downloadToastMessage = $"Checking download options for \"{book.Title}\"...";
        StateHasChanged();

        try
        {
            var safeTitle = SanitizeFileName(book.Title);
            bool success = false;
            string toastText = "";

            // 1. Local plain-text books
            if (!string.IsNullOrWhiteSpace(book.ContentText) && string.IsNullOrWhiteSpace(book.PdfUrl) && string.IsNullOrWhiteSpace(book.EpubUrl))
            {
                var manuscript = $"EVERYPAGE LIBRARY\nTITLE: {book.Title}\nAUTHOR: {book.Author}\n\n{book.Synopsis}\n\n{book.ContentText}";
                success = await JSRuntime.InvokeAsync<bool>("EveryPageLibrary.downloadTextFile", $"{safeTitle}.txt", manuscript);
                toastText = $"Saved \"{book.Title}.txt\" to your Downloads folder!";
            }
            // 2. Community PDFs hosted on Supabase Storage -> direct PDF download
            else if (book.IsIndexed && !string.IsNullOrWhiteSpace(book.PdfUrl))
            {
                success = await JSRuntime.InvokeAsync<bool>("EveryPageLibrary.downloadDirectBlob", book.PdfUrl, $"{safeTitle}.pdf");
                if (!success)
                {
                    success = await JSRuntime.InvokeAsync<bool>("EveryPageLibrary.openSourcePage", book.PdfUrl);
                }
                toastText = $"Downloaded \"{book.Title}.pdf\"!";
            }
            // 3. Wikibooks -> Wikimedia REST API generates a direct PDF textbook
            else if (book.ExternalId?.StartsWith("wb-", StringComparison.OrdinalIgnoreCase) == true && !string.IsNullOrWhiteSpace(book.PdfUrl))
            {
                success = await JSRuntime.InvokeAsync<bool>("EveryPageLibrary.openSourcePage", book.PdfUrl);
                toastText = $"Started Wikibooks PDF export for \"{book.Title}\"!";
            }
            // 4. Standard Ebooks -> open Standard Ebooks catalog page (1-click EPUB/AZW3/Kepub)
            else if (book.ExternalId?.StartsWith("se-", StringComparison.OrdinalIgnoreCase) == true)
            {
                var targetUrl = book.FileUrl ?? book.EpubUrl;
                success = await JSRuntime.InvokeAsync<bool>("EveryPageLibrary.openSourcePage", targetUrl);
                toastText = $"Opened Standard Ebooks page for \"{book.Title}\" (1 click to save EPUB/AZW3/Kepub).";
            }
            // 5. Internet Archive, Open Library & Sacred Texts -> verify availability & open 1-click download page
            else if (!string.IsNullOrWhiteSpace(ExtractArchiveIdentifier(book)))
            {
                var archiveId = ExtractArchiveIdentifier(book)!;
                var resolved = await InternetArchive.ResolveDownloadFilesAsync(archiveId);

                if (resolved.IsRestricted)
                {
                    downloadToastIsWarning = true;
                    downloadToastMessage = $"\"{book.Title}\" is Controlled-Lending (borrow-only, not downloadable). Click \"Read Book\" to view online.";
                    return;
                }

                book.PdfUrl = resolved.PdfUrl;
                book.EpubUrl = resolved.EpubUrl;

                var targetUrl = preferredFormat?.ToLowerInvariant() switch
                {
                    "pdf" when !string.IsNullOrWhiteSpace(resolved.PdfUrl) => resolved.PdfUrl!,
                    "epub" when !string.IsNullOrWhiteSpace(resolved.EpubUrl) => resolved.EpubUrl!,
                    _ => $"https://archive.org/details/{Uri.EscapeDataString(archiveId)}"
                };

                success = await JSRuntime.InvokeAsync<bool>("EveryPageLibrary.openSourcePage", targetUrl);
                toastText = $"Opened {book.SourceBadge} download page for \"{book.Title}\" (1 click to save).";
            }
            // 6. Project Gutenberg -> open official ebook landing page
            else if (book.ExternalId?.StartsWith("pg-", StringComparison.OrdinalIgnoreCase) == true)
            {
                var pgId = book.ExternalId["pg-".Length..];
                var targetUrl = !string.IsNullOrWhiteSpace(pgId)
                    ? $"https://www.gutenberg.org/ebooks/{Uri.EscapeDataString(pgId)}"
                    : book.FileUrl;

                success = await JSRuntime.InvokeAsync<bool>("EveryPageLibrary.openSourcePage", targetUrl);
                toastText = $"Opened Project Gutenberg page for \"{book.Title}\" (1 click to save).";
            }
            // 7. DOAB Academic & remaining sources
            else
            {
                var targetUrl = preferredFormat?.ToLowerInvariant() switch
                {
                    "pdf" when !string.IsNullOrWhiteSpace(book.PdfUrl) => book.PdfUrl,
                    "epub" when !string.IsNullOrWhiteSpace(book.EpubUrl) => book.EpubUrl,
                    _ => book.PdfUrl ?? book.EpubUrl ?? book.FileUrl
                };

                if (string.IsNullOrWhiteSpace(targetUrl))
                {
                    downloadToastIsWarning = true;
                    downloadToastMessage = $"\"{book.Title}\" is a catalog-only record with no downloadable file.";
                    return;
                }

                success = await JSRuntime.InvokeAsync<bool>("EveryPageLibrary.openSourcePage", targetUrl);
                toastText = $"Opened download page for \"{book.Title}\" (1 click to save).";
            }

            if (success)
            {
                downloadToastIsWarning = false;
                downloadToastMessage = toastText;

                var actorName = AuthState.CurrentUser?.Username ?? "Guest reader";
                var actorRole = AuthState.CurrentUser?.Role ?? "reader";
                var persisted = await ArchiveService.RegisterDownloadAsync(book, actorName, actorRole);

                book.Id = persisted.Id;
                book.DownloadCount = persisted.DownloadCount;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Download action failed: {ex.Message}");
            downloadToastIsWarning = true;
            downloadToastMessage = $"Could not open download page for \"{book.Title}\".";
        }
        finally
        {
            downloadingBookKey = null;
            StateHasChanged();
            _ = AutoClearToastAsync();
        }
    }

    private static string? ExtractArchiveIdentifier(Book book)
    {
        if (string.IsNullOrWhiteSpace(book.ExternalId))
            return null;

        if (book.ExternalId.StartsWith("ia-", StringComparison.OrdinalIgnoreCase))
            return book.ExternalId["ia-".Length..];

        if (book.ExternalId.StartsWith("st-", StringComparison.OrdinalIgnoreCase))
            return book.ExternalId["st-".Length..];

        if (book.ExternalId.StartsWith("ol-", StringComparison.OrdinalIgnoreCase) &&
            !book.ExternalId.StartsWith("ol-works/", StringComparison.OrdinalIgnoreCase))
            return book.ExternalId["ol-".Length..];

        return null;
    }

    private async Task AutoClearToastAsync()
    {
        var snapshot = downloadToastMessage;
        await Task.Delay(5000);
        if (downloadToastMessage == snapshot)
        {
            downloadToastMessage = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void TriggerUploadDrawer()
    {
        if (AuthState.IsAuthenticated) isUploadDrawerOpen = true;
        else isAuthModalOpen = true;
    }

    private async Task HandleTomeInscribed(Book newBook) => await LoadFirstPageAsync();
    private void HandleAuthenticated() { isAuthModalOpen = false; StateHasChanged(); }
    private void OpenEditModal(Book book) { bookToEdit = book; isEditModalOpen = true; }
    private async Task HandleBookUpdated(Book updated) { isEditModalOpen = false; await LoadFirstPageAsync(); }
    private void PromptSeal(Book book) { bookToSeal = book; sealReason = "Content moderation"; isSealPromptOpen = true; }

    private async Task ConfirmSealBook()
    {
        if (bookToSeal == null || !AuthState.IsAuditor) return;
        var user = AuthState.CurrentUser!;
        if (await ArchiveService.SoftDeleteBookAsync(bookToSeal.Id, user.Username, user.Role, sealReason))
        {
            isSealPromptOpen = false;
            bookToSeal = null;
            await LoadFirstPageAsync();
        }
    }

    private static string SanitizeFileName(string name)
    {
        var invalid = System.IO.Path.GetInvalidFileNameChars();
        var cleaned = string.Concat(name.Select(c => invalid.Contains(c) ? '_' : c)).Replace(" ", "_");
        return string.IsNullOrWhiteSpace(cleaned) ? "EveryPage_Book" : cleaned;
    }

    public async ValueTask DisposeAsync()
    {
        AuthState.OnChange -= HandleAuthStateChange;
        loadCts?.Cancel();
        loadCts?.Dispose();
        try { await JSRuntime.InvokeVoidAsync("EveryPageLibrary.disconnectSentinel"); }
        catch { }
        dotNetRef?.Dispose();
    }
}