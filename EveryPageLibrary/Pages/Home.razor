@page "/"
@using EveryPageLibrary.Models
@using EveryPageLibrary.Services
@inject ArchiveService ArchiveService
@inject FederatedBookService FederatedBooks
@inject BookDownloadService DownloadService
@inject AuthStateService AuthState
@inject CatalogStateService CatalogState
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<HeroMasthead FeaturedBooks="featuredBooks"
              CanShuffle="@(books.Count > 3)"
              OnShuffle="ShuffleFeaturedBooks"
              OnSelectBook="OpenReader" />

<BookShelfGrid @ref="shelfGrid"
               SelectedCategory="@CatalogState.SelectedCategory"
               Books="FilteredBooks"
               TotalLoadedCount="@books.Count"
               IsInitialLoading="isInitialLoading"
               IsLoadingMore="isLoadingMore"
               HasMorePages="hasMorePages"
               IsAuditor="@AuthState.IsAuditor"
               DownloadingBookKey="@downloadingBookKey"
               GetKey="GetBookKey"
               OnResetFilters="ResetFilters"
               OnRead="OpenReader"
               OnDownload="b => HandleDownloadAsync(b, null)"
               OnEdit="OpenEditModal"
               OnSeal="PromptSeal" />

@if (!string.IsNullOrWhiteSpace(downloadToastMessage))
{
    <div role="status" aria-live="polite"
         class="fixed bottom-5 right-5 z-50 max-w-sm bg-[#FFFDF7] border-2 border-[#1C1917] shadow-[4px_4px_0px_#1C1917] rounded-sm overflow-hidden animate-modal-in">
        <div class="h-1.5 border-b-2 border-[#1C1917] @(downloadToastIsWarning ? "bg-[#D93829]" : "bg-[#F4C430]")"></div>
        <div class="p-3.5 flex items-start gap-3">
            <span class="stamp shrink-0 @(downloadToastIsWarning ? "bg-[#D93829] text-[#FFFDF7]" : "bg-[#F4C430] text-[#1C1917]")">
                @(downloadToastIsWarning ? "Note" : "Done")
            </span>
            <div class="flex-1 text-xs font-mono text-[#1C1917] leading-snug pt-0.5">@downloadToastMessage</div>
            <button type="button" @onclick="() => downloadToastMessage = null" aria-label="Dismiss"
                    class="text-xs font-mono font-bold text-[#57534E] hover:text-[#1C1917]">&#x2715;</button>
        </div>
    </div>
}

<CodexReaderModal Book="selectedBookForReader"
                  IsOpen="isReaderOpen"
                  OnClose="() => isReaderOpen = false"
                  OnDownloadFormat="args => HandleDownloadAsync(args.Book, args.Format)"
                  OnRequestSignIn="() => isAuthModalOpen = true" />

<UploadTomeDrawer IsOpen="isUploadDrawerOpen"
                  OnClose="() => isUploadDrawerOpen = false"
                  OnTomeInscribed="_ => LoadFirstPageAsync()" />

<AuthModal IsOpen="isAuthModalOpen"
           OnClose="() => isAuthModalOpen = false"
           OnAuthenticated="() => { isAuthModalOpen = false; StateHasChanged(); }" />

<EditTomeModal IsOpen="isEditModalOpen"
               Book="bookToEdit"
               OnClose="() => isEditModalOpen = false"
               OnSaved="async _ => { isEditModalOpen = false; await LoadFirstPageAsync(); }" />

<SealBookModal IsOpen="isSealPromptOpen"
               Book="bookToSeal"
               OnCancel="() => isSealPromptOpen = false"
               OnConfirm="ConfirmSealBook" />

@code {
    private BookShelfGrid? shelfGrid;
    private List<Book> books = new();
    private List<Book> featuredBooks = new();

    private bool isInitialLoading = true;
    private bool isLoadingMore = false;
    private bool hasMorePages = true;
    private int currentPage = 1;
    private int loadVersion = 0;

    private string? downloadingBookKey;
    private string? downloadToastMessage;
    private bool downloadToastIsWarning;

    private DotNetObjectReference<Home>? dotNetRef;
    private CancellationTokenSource? loadCts;

    private bool isReaderOpen = false;
    private Book? selectedBookForReader;
    private bool isUploadDrawerOpen = false;
    private bool isAuthModalOpen = false;
    private bool isEditModalOpen = false;
    private Book? bookToEdit;
    private bool isSealPromptOpen = false;
    private Book? bookToSeal;

    private List<Book> FilteredBooks
    {
        get
        {
            var q = CatalogState.SearchQuery.Trim();
            return books.Where(b =>
                (string.IsNullOrEmpty(q) ||
                 b.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                 b.Author.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                 b.Synopsis.Contains(q, StringComparison.OrdinalIgnoreCase)) &&
                (CatalogState.SelectedForm == "All" || b.FormTag.Equals(CatalogState.SelectedForm, StringComparison.OrdinalIgnoreCase)) &&
                (CatalogState.SelectedFactuality == "All" || b.FactualityTag.Equals(CatalogState.SelectedFactuality, StringComparison.OrdinalIgnoreCase)) &&
                (CatalogState.SelectedAudience == "All" || b.AudienceTag.Equals(CatalogState.SelectedAudience, StringComparison.OrdinalIgnoreCase)) &&
                (CatalogState.SelectedEra == "All" || b.EraTag.Equals(CatalogState.SelectedEra, StringComparison.OrdinalIgnoreCase)) &&
                (CatalogState.SelectedRights == "All" || b.RightsTag.Equals(CatalogState.SelectedRights, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += HandleAuthStateChange;
        CatalogState.OnQueryChanged += HandleCatalogQueryChanged;
        CatalogState.OnFacetChanged += HandleCatalogFacetChanged;
        CatalogState.OnUploadRequested += HandleCatalogUploadRequested;
        await LoadFirstPageAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (books.Count > 0 && hasMorePages && shelfGrid != null)
        {
            dotNetRef ??= DotNetObjectReference.Create(this);
            try { await JSRuntime.InvokeVoidAsync("EveryPageLibrary.observeSentinel", shelfGrid.SentinelRef, dotNetRef); }
            catch { }
        }
    }

    [JSInvokable]
    public async Task OnScrollBottomReached()
    {
        if (!isInitialLoading && !isLoadingMore && hasMorePages)
            await LoadNextPageAsync();
    }

    private Task HandleCatalogQueryChanged() => InvokeAsync(LoadFirstPageAsync);
    private void HandleAuthStateChange() => InvokeAsync(StateHasChanged);
    private void HandleCatalogFacetChanged() { CatalogState.UpdateShelfStats(FilteredBooks.Count, isInitialLoading); InvokeAsync(StateHasChanged); }
    private void HandleCatalogUploadRequested()
    {
        if (AuthState.IsAuthenticated) isUploadDrawerOpen = true;
        else isAuthModalOpen = true;
        InvokeAsync(StateHasChanged);
    }

    private static string GetBookKey(Book b) =>
        !string.IsNullOrWhiteSpace(b.ExternalId) ? b.ExternalId! : $"{b.Id}|{b.Title}|{b.Author}";

    private void ShuffleFeaturedBooks()
    {
        featuredBooks = books.Count == 0
            ? new()
            : books.OrderBy(_ => Random.Shared.Next()).Take(3).ToList();
    }

    private async Task LoadFirstPageAsync()
    {
        loadCts?.Cancel();
        loadCts = new CancellationTokenSource();
        var token = loadCts.Token;
        var version = ++loadVersion;

        isInitialLoading = true;
        isLoadingMore = false;
        currentPage = 1;
        hasMorePages = true;
        books.Clear();
        StateHasChanged();

        try
        {
            var localBooks = await ArchiveService.GetBooksAsync(CatalogState.SelectedCategory, CatalogState.SearchQuery, 60);
            if (token.IsCancellationRequested || version != loadVersion) return;

            if (localBooks.Count > 0)
            {
                books = new List<Book>(localBooks);
                if (featuredBooks.Count == 0) ShuffleFeaturedBooks();
                isInitialLoading = false;
                CatalogState.UpdateShelfStats(FilteredBooks.Count, false);
                StateHasChanged();
            }

            _ = FederatedBooks.PrefetchPageAsync(CatalogState.SearchQuery, CatalogState.SelectedCategory, page: 2, token);

            var webBooks = await FederatedBooks.SearchPagedAsync(
                CatalogState.SearchQuery,
                CatalogState.SelectedCategory,
                page: 1,
                onPartialBatchReady: partial =>
                {
                    if (token.IsCancellationRequested || version != loadVersion) return;
                    isInitialLoading = false;
                    MergeBooks(localBooks, partial);
                    if (featuredBooks.Count < 3) ShuffleFeaturedBooks();
                    InvokeAsync(StateHasChanged);
                },
                cancellationToken: token);

            if (token.IsCancellationRequested || version != loadVersion) return;

            isInitialLoading = false;
            MergeBooks(localBooks, webBooks);
            ShuffleFeaturedBooks();
            hasMorePages = webBooks.Count >= 8;
            CatalogState.UpdateShelfStats(FilteredBooks.Count, false);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Console.WriteLine($"Error loading catalog: {ex.Message}"); }
        finally
        {
            if (!token.IsCancellationRequested && version == loadVersion)
            {
                isInitialLoading = false;
                CatalogState.UpdateShelfStats(FilteredBooks.Count, false);
                StateHasChanged();
            }
        }
    }

    private async Task LoadNextPageAsync()
    {
        if (isLoadingMore || isInitialLoading || !hasMorePages) return;
        var version = loadVersion;
        var nextPage = currentPage + 1;
        isLoadingMore = true;
        if (!FederatedBooks.IsCached(CatalogState.SearchQuery, CatalogState.SelectedCategory, nextPage))
            StateHasChanged();

        try
        {
            var moreBooks = await FederatedBooks.SearchPagedAsync(
                CatalogState.SearchQuery, CatalogState.SelectedCategory, nextPage,
                onPartialBatchReady: partial => { if (version == loadVersion) { AppendUniqueBooks(partial); InvokeAsync(StateHasChanged); } });

            if (version != loadVersion) return;
            if (moreBooks.Count == 0) hasMorePages = false;
            else
            {
                currentPage = nextPage;
                AppendUniqueBooks(moreBooks);
                _ = FederatedBooks.PrefetchPageAsync(CatalogState.SearchQuery, CatalogState.SelectedCategory, currentPage + 1);
            }
        }
        catch (Exception ex) { Console.WriteLine($"Error loading page {nextPage}: {ex.Message}"); }
        finally
        {
            if (version == loadVersion)
            {
                isLoadingMore = false;
                CatalogState.UpdateShelfStats(FilteredBooks.Count, false);
                StateHasChanged();
            }
        }
    }

    private void AppendUniqueBooks(List<Book> incoming)
    {
        var existingKeys = new HashSet<string>(books.Select(GetBookKey), StringComparer.OrdinalIgnoreCase);
        foreach (var item in incoming)
            if (existingKeys.Add(GetBookKey(item))) books.Add(item);
    }

    private void MergeBooks(List<Book> localBooks, List<Book> webBooks)
    {
        var seenExternal = new HashSet<string>(
            localBooks.Where(b => !string.IsNullOrWhiteSpace(b.ExternalId)).Select(b => b.ExternalId!),
            StringComparer.OrdinalIgnoreCase);

        var combined = new List<Book>(localBooks.Count + webBooks.Count);
        combined.AddRange(localBooks);
        foreach (var ext in webBooks)
        {
            if (!string.IsNullOrWhiteSpace(ext.ExternalId) && !seenExternal.Add(ext.ExternalId)) continue;
            combined.Add(ext);
        }
        books = combined;
        CatalogState.UpdateShelfStats(FilteredBooks.Count, isInitialLoading);
    }

    private async Task ResetFilters()
    {
        CatalogState.SelectedCategory = "All";
        CatalogState.SelectedForm = "All";
        CatalogState.SelectedFactuality = "All";
        CatalogState.SelectedAudience = "All";
        CatalogState.SelectedEra = "All";
        CatalogState.SelectedRights = "All";
        CatalogState.SearchQuery = "";
        await LoadFirstPageAsync();
    }

    private void OpenReader(Book book) { selectedBookForReader = book; isReaderOpen = true; }
    private void OpenEditModal(Book book) { bookToEdit = book; isEditModalOpen = true; }
    private void PromptSeal(Book book) { bookToSeal = book; isSealPromptOpen = true; }

    private async Task HandleDownloadAsync(Book book, string? preferredFormat)
    {
        var key = GetBookKey(book);
        if (downloadingBookKey == key) return;

        downloadingBookKey = key;
        downloadToastIsWarning = false;
        downloadToastMessage = $"Checking download options for \"{book.Title}\"...";
        StateHasChanged();

        var outcome = await DownloadService.DownloadAsync(book, preferredFormat);
        downloadingBookKey = null;
        downloadToastIsWarning = outcome.IsWarning;
        downloadToastMessage = outcome.Message;
        StateHasChanged();

        var snapshot = downloadToastMessage;
        await Task.Delay(5000);
        if (downloadToastMessage == snapshot) { downloadToastMessage = null; await InvokeAsync(StateHasChanged); }
    }

    private async Task ConfirmSealBook(string reason)
    {
        if (bookToSeal == null || !AuthState.IsAuditor) return;
        var user = AuthState.CurrentUser!;
        if (await ArchiveService.SoftDeleteBookAsync(bookToSeal.Id, user.Username, user.Role, reason))
        {
            isSealPromptOpen = false;
            bookToSeal = null;
            await LoadFirstPageAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        AuthState.OnChange -= HandleAuthStateChange;
        CatalogState.OnQueryChanged -= HandleCatalogQueryChanged;
        CatalogState.OnFacetChanged -= HandleCatalogFacetChanged;
        CatalogState.OnUploadRequested -= HandleCatalogUploadRequested;
        loadCts?.Cancel();
        loadCts?.Dispose();
        try { await JSRuntime.InvokeVoidAsync("EveryPageLibrary.disconnectSentinel"); }
        catch { }
        dotNetRef?.Dispose();
    }
}