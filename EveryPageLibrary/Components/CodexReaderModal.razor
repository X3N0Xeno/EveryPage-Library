@using EveryPageLibrary.Models
@using EveryPageLibrary.Services
@inject ArchiveService ArchiveService
@inject AuthStateService AuthState
@if (IsOpen && Book != null)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#1C1917]/70 flex items-center justify-center p-2 sm:p-4 animate-modal-in"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-label="@Book.Title"
         @onkeydown="HandleKeyDown">

        <div class="relative w-full max-w-6xl h-[92vh] max-h-[920px] flex flex-col rounded-sm border-2 border-[#1C1917] shadow-[6px_6px_0px_#1C1917] overflow-hidden @(IsParchmentMode ? "bg-[#F2EAD8]" : "bg-[#FFFDF7]") text-[#1C1917]">

            <!-- Toolbar -->
            <div class="flex flex-wrap items-center justify-between gap-3 px-4 sm:px-5 py-3 border-b-2 border-[#1C1917] bg-[#FAF6EC] z-10 select-none">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="flex flex-col items-start gap-1 shrink-0">
                        <span class="stamp bg-[#F4C430] text-[#1C1917]">@Book.GenreLabel</span>
                        <span class="hidden sm:inline-block stamp bg-[#FFFDF7] text-[#1C1917]">@Book.SourceBadge</span>
                    </div>
                    <div class="min-w-0 pl-3 border-l-2 border-[#1C1917]/20">
                        <h2 class="font-serif text-lg sm:text-xl font-bold leading-tight truncate text-[#1C1917]">@Book.Title</h2>
                        <span class="block text-xs font-mono text-[#57534E] truncate">By @Book.Author</span>
                    </div>
                </div>

                <div class="flex items-center gap-2 flex-wrap">
                    @if (!HasEmbeddableDocument)
                    {
                        <div role="group" aria-label="Text size"
                             class="flex items-center rounded-sm border-2 border-[#1C1917] bg-[#FFFDF7] shadow-[2px_2px_0px_#1C1917] overflow-hidden text-xs font-mono font-bold">
                            <button type="button" @onclick='() => FontSize = "S"' class='seg-btn @(FontSize == "S" ? "is-active" : "")'>S</button>
                            <button type="button" @onclick='() => FontSize = "M"' class='seg-btn @(FontSize == "M" ? "is-active" : "")'>M</button>
                            <button type="button" @onclick='() => FontSize = "L"' class='seg-btn @(FontSize == "L" ? "is-active" : "")'>L</button>
                        </div>

                        <button type="button"
                                @onclick="() => IsParchmentMode = !IsParchmentMode"
                                class="ink-btn inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono font-bold rounded-sm bg-[#FFFDF7] text-[#1C1917]">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true">
                                <path d="M6 2h9l5 5v15H6z"></path>
                                <path d="M15 2v5h5"></path>
                            </svg>
                            @(IsParchmentMode ? "White Paper" : "Manila Tint")
                        </button>
                    }

                    @if (!string.IsNullOrWhiteSpace(EffectivePdfUrl))
                    {
                        <button type="button" @onclick='() => TriggerFormatDownload("pdf")'
                                class="ink-btn inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-comic font-bold uppercase bg-[#D93829] text-[#FFFDF7] rounded-sm">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                            </svg>
                            Download PDF
                        </button>
                    }

                    @if (!string.IsNullOrWhiteSpace(Book.EpubUrl))
                    {
                        <button type="button" @onclick='() => TriggerFormatDownload("epub")'
                                class="ink-btn inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-comic font-bold uppercase bg-[#F4C430] text-[#1C1917] rounded-sm">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                            </svg>
                            Download EPUB
                        </button>
                    }

                    @if (string.IsNullOrWhiteSpace(EffectivePdfUrl) && string.IsNullOrWhiteSpace(Book.EpubUrl))
                    {
                        <button type="button" @onclick='() => TriggerFormatDownload("txt")'
                                class="ink-btn inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-comic font-bold uppercase bg-[#D93829] text-[#FFFDF7] rounded-sm">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                            </svg>
                            Download Book
                        </button>
                    }

                    <button type="button" @onclick="Close" aria-label="Close reader"
                            class="ink-btn inline-flex items-center justify-center w-8 h-8 bg-[#FFFDF7] hover:bg-[#D93829] hover:text-[#FFFDF7] text-[#1C1917] rounded-sm">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="flex-1 overflow-hidden grid grid-cols-1 lg:grid-cols-3 divide-y-2 lg:divide-y-0 lg:divide-x-2 divide-[#1C1917]">
                <!-- Reading pane -->
                <div class="lg:col-span-2 overflow-y-auto @(HasEmbeddableDocument ? "p-0 bg-[#F2EAD8]" : "px-6 py-8 sm:px-12 sm:py-12")">
                    @if (!string.IsNullOrWhiteSpace(ArchiveEmbedUrl))
                    {
                        <iframe src="@ArchiveEmbedUrl" title="@Book.Title" allowfullscreen class="w-full h-full min-h-[560px] border-0"></iframe>
                    }
                    else if (!string.IsNullOrWhiteSpace(EffectivePdfUrl))
                    {
                        <iframe src="@EffectivePdfUrl" title="@Book.Title" class="w-full h-full min-h-[560px] border-0"></iframe>
                    }
                    else
                    {
                        <div class="max-w-2xl mx-auto mb-10 text-center">
                            @if (!string.IsNullOrWhiteSpace(Book.CoverUrl))
                            {
                                <img src="@Book.CoverUrl" alt="@Book.Title cover" class="w-28 h-40 object-cover mx-auto mb-6 rounded-sm border-2 border-[#1C1917] shadow-[4px_4px_0px_#1C1917]" />
                            }
                            <span class="font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-[#57534E]">@Book.SourceBadge Edition</span>
                            <h1 class="font-serif text-3xl sm:text-4xl font-bold mt-2 mb-2 leading-tight text-[#1C1917]">@Book.Title</h1>
                            <p class="font-comic text-lg text-[#D93829]">By @Book.Author</p>
                            <div class="sacred-divider"><div class="sacred-divider-diamond"></div></div>
                            @if (!string.IsNullOrWhiteSpace(Book.Synopsis))
                            {
                                <div class="text-left bg-[#FFFDF7] border-2 border-[#1C1917] shadow-[3px_3px_0px_#1C1917] rounded-sm overflow-hidden">
                                    <div class="px-4 py-1.5 border-b-2 border-[#D93829] bg-[#FAF6EC] font-mono text-[11px] font-bold uppercase tracking-wider text-[#D93829]">
                                        Library Card Notes
                                    </div>
                                    <p class="px-4 py-3 font-serif text-[15px] leading-relaxed text-[#1C1917]">@Book.Synopsis</p>
                                </div>
                            }
                        </div>

                        <div class="reader-prose mx-auto @GetFontSizeClass() space-y-5 text-[#1C1917]">
                            @if (isLoadingFullText)
                            {
                                <div class="p-6 rounded-sm border-2 border-dashed border-[#1C1917]/40 bg-[#FAF6EC] text-center font-mono text-xs text-[#57534E]">
                                    Pulling full text from @Book.SourceBadge...
                                </div>
                            }
                            else
                            {
                                var paragraphs = (Book.ContentText ?? string.Empty).Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries);
                                @if (paragraphs.Length == 0)
                                {
                                    <div class="p-6 rounded-sm border-2 border-[#1C1917] bg-[#FAF6EC] shadow-[3px_3px_0px_#1C1917] text-center space-y-3 font-hand">
                                        <p class="font-comic text-xl font-bold">Hosted by @Book.SourceBadge</p>
                                        <p class="text-base text-[#57534E]">Click any download button in the top bar or open the source edition directly.</p>
                                        @if (!string.IsNullOrWhiteSpace(Book.FileUrl))
                                        {
                                            <a href="@CleanExternalUrl(Book.FileUrl)" target="_blank" rel="noopener"
                                               class="ink-btn inline-flex items-center gap-1.5 px-4 py-1.5 text-xs font-comic font-bold uppercase bg-[#F4C430] text-[#1C1917] rounded-sm">
                                                Open on @Book.SourceBadge
                                                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <line x1="7" y1="17" x2="17" y2="7"></line>
                                                    <polyline points="8 7 17 7 17 16"></polyline>
                                                </svg>
                                            </a>
                                        }
                                    </div>
                                }
                                else
                                {
                                    @foreach (var p in paragraphs)
                                    {
                                        <p>@p.Trim()</p>
                                    }
                                }
                            }
                        </div>
                    }
                </div>

                <!-- Margin Notes column -->
                <div class="lg:col-span-1 flex flex-col h-full bg-[#FAF6EC] overflow-hidden">
                    <div class="px-4 py-3 border-b-2 border-[#1C1917] bg-[#F2EAD8] flex items-center justify-between">
                        <div class="flex items-center gap-2"><h3 class="font-comic text-lg font-bold text-[#1C1917]">Margin Notes</h3><button type="button" @onclick="() => isNotesOpen = !isNotesOpen" class="md:hidden px-2 py-0.5 text-[10px] font-mono font-bold uppercase border border-[#1C1917] bg-[#E4C438] text-[#1C1917] rounded-sm">@(isNotesOpen ? "Hide ▲" : "View / Write ▼")</button></div>
                        <span class="stamp bg-[#F4C430] text-[#1C1917]">@Comments.Count</span>
                    </div>

                    <div class="@(isNotesOpen ? "flex flex-col flex-1 min-h-0" : "hidden md:flex md:flex-col md:flex-1 md:min-h-0")"><div class="flex-1 overflow-y-auto p-4 space-y-3">
                        @if (isLoadingComments)
                        {
                            <div class="py-8 text-center text-xs font-mono uppercase tracking-wider text-[#57534E]">Reading margin notes&hellip;</div>
                        }
                        else if (Comments.Count == 0)
                        {
                            <div class="speech-bubble mt-4 mb-6 mx-1 px-4 py-5 text-center text-base text-[#57534E]">
                                No margin notes yet. Jot down your thoughts below!
                            </div>
                        }
                        else
                        {
                            @foreach (var comment in Comments)
                            {
                                <div class="relative pl-5 pr-3 py-3 rounded-sm border-2 border-[#1C1917] bg-[#FFFDF7] shadow-[2px_2px_0px_#1C1917] text-sm overflow-hidden">
                                    <span class="absolute left-0 top-0 bottom-0 w-1.5 bg-[#F4C430] border-r-2 border-[#1C1917]" aria-hidden="true"></span>
                                    <div class="flex items-center justify-between gap-2 mb-1">
                                        <span class="font-comic font-bold text-[#D93829] truncate">@comment.AuthorName</span>
                                        <div class="flex items-center gap-2 shrink-0">
                                            <span class="text-[11px] font-mono text-[#57534E]">@comment.CreatedAt.ToUniversalTime().ToString("MMM dd")</span>
                                            @if (CanDeleteComment(comment))
                                            {
                                                <button type="button" @onclick="() => SoftDeleteComment(comment.Id)" aria-label="Delete note"
                                                        class="w-5 h-5 inline-flex items-center justify-center rounded-sm text-[#D93829] hover:bg-[#D93829] hover:text-[#FFFDF7]">
                                                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
                                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                                    </svg>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                    <p class="leading-snug whitespace-pre-wrap text-[15px]">@comment.Body</p>
                                </div>
                            }
                        }
                    </div>

                    <div class="p-4 border-t-2 border-[#1C1917] bg-[#F2EAD8]">
                        @if (AuthState.IsAuthenticated)
                        {
                            <form @onsubmit="SubmitComment" class="space-y-2">
                                <label class="block text-[11px] font-mono font-bold uppercase tracking-wider text-[#57534E]">
                                    Note by <span class="text-[#D93829]">@AuthState.CurrentUser?.Username</span>
                                </label>
                                <textarea @bind="newCommentText" rows="2" placeholder="Write a margin note..." required disabled="@isSubmittingComment"
                                          class="ink-field w-full text-sm p-2.5 rounded-sm resize-none"></textarea>
                                @if (!string.IsNullOrWhiteSpace(commentErrorMessage))
                                {
                                    <p class="text-xs font-mono font-bold text-[#D93829]">@commentErrorMessage</p>
                                }
                                <div class="flex justify-end">
                                    <button type="submit" disabled="@(isSubmittingComment || string.IsNullOrWhiteSpace(newCommentText))"
                                            class="ink-btn px-4 py-1.5 text-xs font-comic font-bold uppercase bg-[#D93829] text-[#FFFDF7] rounded-sm">
                                        @(isSubmittingComment ? "Posting..." : "Post Note")
                                    </button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="text-center p-3 rounded-sm border-2 border-dashed border-[#1C1917]/40 bg-[#FFFDF7]">
                                <p class="text-sm text-[#57534E] mb-2">Sign in with your library card to leave a note.</p>
                                <button type="button" @onclick="() => OnRequestSignIn.InvokeAsync()"
                                        class="ink-btn px-4 py-1 text-xs font-comic font-bold uppercase bg-[#F4C430] text-[#1C1917] rounded-sm">
                                    Sign In
                                </button>
                            </div>
                        }
                    </div>
                </div>
                    </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isNotesOpen = false;

    private static string CleanExternalUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "";
        if (url.Contains("standardebooks.org/ebooks?query=", StringComparison.OrdinalIgnoreCase))
        {
            var idx = url.IndexOf("%20by%20", StringComparison.OrdinalIgnoreCase);
            if (idx < 0) idx = url.IndexOf("+by+", StringComparison.OrdinalIgnoreCase);
            if (idx < 0) idx = url.IndexOf(" by ", StringComparison.OrdinalIgnoreCase);
            if (idx > 0) return url[..idx];
        }
        return url;
    }
    [Parameter] public Book? Book { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<(Book Book, string? Format)> OnDownloadFormat { get; set; }
    [Parameter] public EventCallback OnRequestSignIn { get; set; }

    private bool IsParchmentMode { get; set; } = false;
    private string FontSize { get; set; } = "M";

    private List<BookComment> Comments { get; set; } = new();
    private bool isLoadingComments { get; set; } = false;
    private bool isLoadingFullText { get; set; } = false;
    private string newCommentText { get; set; } = "";
    private bool isSubmittingComment { get; set; } = false;
    private string commentErrorMessage { get; set; } = "";

    private string? EffectivePdfUrl =>
        !string.IsNullOrWhiteSpace(Book?.PdfUrl)
            ? Book!.PdfUrl
            : (Book?.FileUrl?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) == true ? Book.FileUrl : null);

    private string? ArchiveEmbedUrl
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Book?.ExternalId))
                return null;

            if (Book.ExternalId.StartsWith("ia-", StringComparison.OrdinalIgnoreCase))
            {
                var archiveId = Book.ExternalId["ia-".Length..];
                return $"{OpenLibraryBookSource.ArchiveEmbedBaseUrl}{archiveId}";
            }

            if (Book.ExternalId.StartsWith("ol-", StringComparison.OrdinalIgnoreCase) &&
                !Book.ExternalId.StartsWith("ol-works/", StringComparison.OrdinalIgnoreCase))
            {
                var archiveId = Book.ExternalId["ol-".Length..];
                return $"{OpenLibraryBookSource.ArchiveEmbedBaseUrl}{archiveId}";
            }

            return null;
        }
    }

    private bool HasEmbeddableDocument =>
        !string.IsNullOrWhiteSpace(ArchiveEmbedUrl) || !string.IsNullOrWhiteSpace(EffectivePdfUrl);

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && Book != null)
        {
            await LoadCommentsAsync();
        }
    }

    private async Task LoadCommentsAsync()
    {
        if (Book == null || !Book.IsIndexed)
        {
            Comments = new List<BookComment>();
            return;
        }
        isLoadingComments = true;
        try { Comments = await ArchiveService.GetCommentsForBookAsync(Book.Id); }
        finally { isLoadingComments = false; }
    }

    private string GetFontSizeClass() => FontSize switch { "S" => "text-base", "L" => "text-2xl", _ => "text-lg" };

    private bool CanDeleteComment(BookComment comment) =>
        AuthState.IsAuthenticated && (AuthState.IsAuditor || string.Equals(AuthState.CurrentUser?.Username, comment.AuthorName, StringComparison.OrdinalIgnoreCase));

    private async Task SubmitComment()
    {
        if (string.IsNullOrWhiteSpace(newCommentText) || Book == null || !AuthState.IsAuthenticated) return;
        isSubmittingComment = true;
        commentErrorMessage = "";
        try
        {
            if (!Book.IsIndexed) Book = await ArchiveService.EnsureIndexedAsync(Book);
            if (!Book.IsIndexed) { commentErrorMessage = "Could not index book."; return; }

            var user = AuthState.CurrentUser!;
            var result = await ArchiveService.AddCommentAsync(Book.Id, Book.Title, user.Username, user.Role, newCommentText.Trim());
            if (result != null) { newCommentText = ""; await LoadCommentsAsync(); }
        }
        catch (Exception ex) { commentErrorMessage = ex.Message; }
        finally { isSubmittingComment = false; }
    }

    private async Task SoftDeleteComment(long commentId)
    {
        if (Book == null || !AuthState.IsAuthenticated) return;
        var user = AuthState.CurrentUser!;
        if (await ArchiveService.SoftDeleteCommentAsync(commentId, Book.Id, Book.Title, user.Username, user.Role))
            await LoadCommentsAsync();
    }

    private async Task TriggerFormatDownload(string format)
    {
        if (Book != null) await OnDownloadFormat.InvokeAsync((Book, format));
    }

    private async Task Close() => await OnClose.InvokeAsync();
    private async Task HandleKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") await Close(); }
}