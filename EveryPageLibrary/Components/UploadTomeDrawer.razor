@using EveryPageLibrary.Models
@using EveryPageLibrary.Services
@inject ArchiveService ArchiveService
@inject AuthStateService AuthState

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex justify-end bg-[#1C1917]/60">
        <aside class="relative w-full max-w-xl bg-[#FAF6EC] border-l-2 border-[#1C1917] h-full flex flex-col shadow-[-6px_0px_0px_#1C1917] text-[#1C1917] animate-drawer-in"
               role="dialog" aria-modal="true" aria-labelledby="upload-drawer-title">

            <div class="px-6 py-5 bg-[#FFFDF7] flex items-start justify-between gap-4">
                <div>
                    <p class="text-[11px] font-mono font-bold uppercase tracking-[0.18em] text-[#57534E]">Community Shelf</p>
                    <h2 id="upload-drawer-title" class="font-comic text-2xl sm:text-3xl font-bold text-[#1C1917] mt-0.5 leading-tight">Upload PDF Book</h2>
                </div>
                <button type="button" @onclick="Close" disabled="@isSaving" aria-label="Close"
                        class="ink-btn inline-flex items-center justify-center w-8 h-8 bg-[#FFFDF7] hover:bg-[#D93829] hover:text-[#FFFDF7] text-[#1C1917] rounded-sm">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                    </svg>
                </button>
            </div>
            <div class="zigzag-band" aria-hidden="true"></div>

            <form @onsubmit="HandleSubmit" class="flex-1 overflow-y-auto p-6 space-y-5">
                <p class="text-base text-[#57534E]">
                    Contribute original works or rare editions to EveryPage Library. Uploads accept <strong class="text-[#1C1917]">.pdf</strong> files only.
                </p>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div role="alert" class="flex items-start gap-2.5 p-3 bg-[#D93829] border-2 border-[#1C1917] shadow-[2px_2px_0px_#1C1917] rounded-sm text-sm font-bold text-[#FFFDF7]">
                        <svg class="w-4 h-4 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9"></circle>
                            <line x1="12" y1="7.5" x2="12" y2="13"></line>
                            <line x1="12" y1="16.5" x2="12" y2="16.6"></line>
                        </svg>
                        <span>@errorMessage</span>
                    </div>
                }

                <div>
                    <label class="block text-[11px] font-mono font-bold uppercase tracking-wider mb-1.5">PDF File *</label>
                    <label class="group flex flex-col items-center justify-center gap-2 w-full px-4 py-7 border-2 border-dashed border-[#1C1917] hover:bg-[#F2EAD8] bg-[#FFFDF7] rounded-sm cursor-pointer transition-colors text-center">
                        @if (!string.IsNullOrWhiteSpace(pdfFileName))
                        {
                            <svg class="w-9 h-9 text-[#1C1917]" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                                <path d="M8 3h11l6 6v20H8z" fill="#FFFDF7" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                                <path d="M19 3v6h6" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                                <path d="M12 19l3 3 6-7" stroke="#D93829" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span class="text-base font-bold text-[#1C1917] break-all">@pdfFileName</span>
                            <span class="stamp bg-[#F4C430] text-[#1C1917]">@FormatSize(pdfBytes?.Length ?? 0) &mdash; Ready!</span>
                        }
                        else
                        {
                            <svg class="w-9 h-9 text-[#1C1917] transition-transform group-hover:-translate-y-0.5" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                                <path d="M8 3h11l6 6v20H8z" fill="#FFFDF7" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                                <path d="M19 3v6h6" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                                <path d="M16.5 24V14M12.5 18l4-4 4 4" stroke="#D93829" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span class="text-base font-bold text-[#1C1917]">Click to pick a .pdf file</span>
                            <span class="text-xs font-mono text-[#57534E]">PDF only, up to 25 MB</span>
                        }
                        <InputFile OnChange="HandlePdfSelected" accept=".pdf,application/pdf" class="hidden" />
                    </label>
                </div>

                <div>
                    <label class="block text-[11px] font-mono font-bold uppercase tracking-wider mb-1">Book Title *</label>
                    <input type="text" @bind="newBook.Title" required placeholder="e.g., Meditations"
                           class="ink-field w-full px-3.5 py-2 rounded-sm text-base" />
                </div>

                <div>
                    <label class="block text-[11px] font-mono font-bold uppercase tracking-wider mb-1">Author *</label>
                    <input type="text" @bind="newBook.Author" required placeholder="e.g., Marcus Aurelius"
                           class="ink-field w-full px-3.5 py-2 rounded-sm text-base" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[11px] font-mono font-bold uppercase tracking-wider mb-1">Bookshelf / Genre</label>
                        <select @bind="newBook.Category"
                                class="ink-field ink-select w-full pl-3.5 py-2 rounded-sm text-base">
                            @foreach (var genre in BookGenres.Selectable)
                            {
                                <option value="@genre">@genre</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-[11px] font-mono font-bold uppercase tracking-wider mb-1">Year or Era</label>
                        <input type="text" @bind="newBook.PublicationYear" placeholder="e.g., 180 CE or 2026"
                               class="ink-field w-full px-3.5 py-2 rounded-sm text-base" />
                    </div>
                </div>

                <div>
                    <label class="block text-[11px] font-mono font-bold uppercase tracking-wider mb-1">Description</label>
                    <textarea @bind="newBook.Synopsis" rows="3" placeholder="Brief summary or edition notes..."
                              class="ink-field w-full px-3.5 py-2 rounded-sm text-base resize-none"></textarea>
                </div>

                <div>
                    <label class="block text-[11px] font-mono font-bold uppercase tracking-wider mb-1">Cover Image (Optional)</label>
                    <label class="flex items-center justify-between gap-3 w-full px-3.5 py-2 bg-[#FFFDF7] border-2 border-[#1C1917] rounded-sm cursor-pointer hover:bg-[#F2EAD8] transition-colors">
                        <span class="flex items-center gap-2 min-w-0">
                            <svg class="w-4 h-4 shrink-0 text-[#57534E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="4" width="18" height="16" rx="1"></rect>
                                <circle cx="9" cy="10" r="2"></circle>
                                <path d="M21 17l-5-5-8 8"></path>
                            </svg>
                            <span class="text-sm text-[#57534E] truncate">@(string.IsNullOrWhiteSpace(coverFileName) ? "Choose JPG, PNG, or WebP..." : coverFileName)</span>
                        </span>
                        <span class="text-xs font-mono font-bold uppercase text-[#D93829] shrink-0">Browse</span>
                        <InputFile OnChange="HandleCoverSelected" accept="image/png,image/jpeg,image/webp" class="hidden" />
                    </label>
                </div>

                <div class="sticky bottom-0 -mx-6 -mb-6 px-6 py-4 bg-[#FAF6EC] border-t-2 border-[#1C1917] flex items-center justify-end gap-3">
                    <button type="button" @onclick="Close" disabled="@isSaving"
                            class="ink-btn px-4 py-2 text-xs font-mono font-bold uppercase bg-[#FFFDF7] text-[#1C1917] rounded-sm">
                        Cancel
                    </button>
                    <button type="submit" disabled="@isSaving"
                            class="ink-btn px-6 py-2 text-sm font-comic font-bold uppercase bg-[#D93829] text-[#FFFDF7] rounded-sm">
                        @(isSaving ? "Publishing..." : "Publish Book")
                    </button>
                </div>
            </form>
        </aside>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<Book> OnTomeInscribed { get; set; }

    private Book newBook = new() { Category = "Literature", SourceName = "Community PDF" };
    private bool isSaving = false;
    private string errorMessage = "";
    private byte[]? pdfBytes;
    private string? pdfFileName;
    private byte[]? coverBytes;
    private string? coverFileName;

    private void ResetForm()
    {
        newBook = new Book { Category = "Literature", SourceName = "Community PDF" };
        pdfBytes = null; pdfFileName = null; coverBytes = null; coverFileName = null;
        errorMessage = ""; isSaving = false;
    }

    private async Task HandlePdfSelected(InputFileChangeEventArgs e)
    {
        errorMessage = "";
        try
        {
            var file = e.File;
            if (file == null) return;
            if (!file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                pdfBytes = null; pdfFileName = null;
                errorMessage = "Only .pdf files are accepted.";
                return;
            }
            pdfFileName = file.Name;
            using var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            pdfBytes = ms.ToArray();
        }
        catch (Exception ex) { pdfBytes = null; pdfFileName = null; errorMessage = ex.Message; }
    }

    private async Task HandleCoverSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;
            coverFileName = file.Name;
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            coverBytes = ms.ToArray();
        }
        catch (Exception ex) { coverBytes = null; coverFileName = null; errorMessage = ex.Message; }
    }

    private async Task HandleSubmit()
    {
        if (!AuthState.IsAuthenticated) { errorMessage = "Please sign in first."; return; }
        if (pdfBytes == null || pdfBytes.Length == 0 || string.IsNullOrWhiteSpace(pdfFileName)) { errorMessage = "Please select a PDF file."; return; }
        if (string.IsNullOrWhiteSpace(newBook.Title) || string.IsNullOrWhiteSpace(newBook.Author)) { errorMessage = "Title and Author are required."; return; }

        isSaving = true;
        errorMessage = "";
        try
        {
            var actor = AuthState.CurrentUser!;
            newBook.UploadedBy = actor.Username;
            newBook.SourceName = "Community PDF";
            var created = await ArchiveService.UploadPdfBookAsync(newBook, pdfBytes, pdfFileName, coverBytes, coverFileName, actor.Username, actor.Role);
            await OnTomeInscribed.InvokeAsync(created);
            ResetForm();
            await Close();
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { isSaving = false; }
    }

    private async Task Close() { if (!isSaving) await OnClose.InvokeAsync(); }
    private static string FormatSize(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / (1024.0 * 1024.0):0.0} MB" : $"{Math.Max(1, bytes / 1024)} KB";
}
