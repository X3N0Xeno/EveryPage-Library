@using EveryPageLibrary.Models
@using EveryPageLibrary.Services
@inject ArchiveService ArchiveService
@inject AuthStateService AuthState

@if (IsOpen && EditingBook != null)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#1C1917]/60 flex items-center justify-center p-4 animate-modal-in"
         tabindex="-1" role="dialog" aria-modal="true" @onkeydown="HandleKeyDown">
        <div class="relative w-full max-w-xl bg-[#FFFDF7] border-2 border-[#1C1917] shadow-[6px_6px_0px_#1C1917] rounded-sm overflow-hidden text-[#1C1917]">

            <div class="flex items-center justify-between gap-4 px-6 py-4 bg-[#FFFDF7]">
                <div>
                    <span class="font-mono text-[11px] font-bold uppercase tracking-[0.18em] text-[#57534E]">
                        Index Card #@EditingBook.Id.ToString("D4")
                    </span>
                    <h3 class="font-comic text-2xl font-bold leading-tight">Edit Index Card</h3>
                </div>
                <button type="button" @onclick="Close" aria-label="Close"
                        class="ink-btn inline-flex items-center justify-center w-8 h-8 bg-[#FFFDF7] hover:bg-[#D93829] hover:text-[#FFFDF7] rounded-sm">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                    </svg>
                </button>
            </div>
            <div class="zigzag-band" aria-hidden="true"></div>

            <form @onsubmit="SaveTome" class="p-6 space-y-4 bg-[#FAF6EC]">
                <div>
                    <label class="block text-[11px] font-mono font-bold uppercase tracking-wider mb-1">Book Title</label>
                    <input type="text" @bind="EditingBook.Title" required class="ink-field w-full text-base p-2 rounded-sm font-serif" />
                </div>
                <div>
                    <label class="block text-[11px] font-mono font-bold uppercase tracking-wider mb-1">Author</label>
                    <input type="text" @bind="EditingBook.Author" required class="ink-field w-full text-base p-2 rounded-sm" />
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[11px] font-mono font-bold uppercase tracking-wider mb-1">Bookshelf / Genre</label>
                        <select @bind="EditingBook.Category" class="ink-field ink-select w-full text-base pl-2 py-2 rounded-sm">
                            @foreach (var genre in BookGenres.Selectable)
                            {
                                <option value="@genre">@genre</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-[11px] font-mono font-bold uppercase tracking-wider mb-1">Year</label>
                        <input type="text" @bind="EditingBook.PublicationYear" class="ink-field w-full text-base p-2 rounded-sm" />
                    </div>
                </div>
                <div>
                    <label class="block text-[11px] font-mono font-bold uppercase tracking-wider mb-1">Description</label>
                    <textarea @bind="EditingBook.Synopsis" rows="3" class="ink-field w-full text-base p-2 rounded-sm resize-none"></textarea>
                </div>
                <div class="flex items-center justify-end gap-3 pt-4 border-t-2 border-dashed border-[#1C1917]/25">
                    <button type="button" @onclick="Close" class="ink-btn px-4 py-1.5 text-xs font-mono font-bold uppercase bg-[#FFFDF7] rounded-sm">Cancel</button>
                    <button type="submit" disabled="@isSaving" class="ink-btn px-5 py-1.5 text-xs font-comic font-bold uppercase bg-[#D93829] text-[#FFFDF7] rounded-sm">
                        @(isSaving ? "Saving..." : "Save Card")
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public Book? Book { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<Book> OnSaved { get; set; }

    private Book? EditingBook;
    private bool isSaving = false;

    protected override void OnParametersSet()
    {
        if (Book != null)
        {
            EditingBook = new Book
            {
                Id = Book.Id,
                Title = Book.Title,
                Author = Book.Author,
                Category = BookGenres.ToLabel(Book.Category) == BookGenres.General ? "Literature" : BookGenres.ToLabel(Book.Category),
                PublicationYear = Book.PublicationYear,
                Synopsis = Book.Synopsis
            };
        }
    }

    private async Task SaveTome()
    {
        if (EditingBook == null || !AuthState.IsAuditor) return;
        isSaving = true;
        try
        {
            var user = AuthState.CurrentUser!;
            if (await ArchiveService.UpdateBookAsync(EditingBook, user.Username, user.Role))
            {
                await OnSaved.InvokeAsync(EditingBook);
                await Close();
            }
        }
        finally { isSaving = false; }
    }

    private async Task Close() { isSaving = false; await OnClose.InvokeAsync(); }
    private async Task HandleKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") await Close(); }
}
