@namespace EveryPageLibrary.Components
@inject IJSRuntime JS
@implements IAsyncDisposable

<!-- Persistent hidden YouTube full-track audio engine -->
<div class="fixed bottom-0 right-0 w-[200px] h-[200px] opacity-[0.01] pointer-events-none z-0 overflow-hidden" aria-hidden="true">
    <div id="ep-matchbox-yt-host"></div>
</div>

<div class="space-y-3">
    <!-- YouTube Link Input -->
    <div class="space-y-1.5">
        <label class="block text-[10px] font-mono font-bold uppercase tracking-wider text-[#57534E]">
            YouTube Link
        </label>
        <div class="flex gap-1.5">
            <input type="text"
                   @bind="queryInput"
                   @bind:event="oninput"
                   @onkeydown="HandleInputKeyDown"
                   placeholder="Insert YouTube link"
                   class="ink-field flex-1 min-w-0 px-2.5 py-1.5 text-xs font-mono bg-[#FFFDF7] text-[#1C1917] border-2 border-[#1C1917] rounded-sm focus:outline-none" />
            <button type="button"
                    @onclick="SubmitLink"
                    disabled="@isLoading"
                    class="ink-btn px-3 py-1.5 text-xs font-comic font-bold uppercase bg-[#F4C430] hover:bg-[#e5b522] text-[#1C1917] rounded-sm shrink-0">
                @(isLoading ? "..." : "Go")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(validationMessage))
        {
            <div class="p-2 rounded-sm bg-[#F2EAD8] border-2 border-[#D93829] text-xs font-mono text-[#1C1917] leading-snug">
                <span class="font-bold text-[#D93829] uppercase">Invalid Input:</span> @validationMessage
            </div>
        }
    </div>

    <!-- Now Playing Card -->
    <div class="p-2.5 rounded-sm bg-[#F2EAD8] border-2 border-[#1C1917] space-y-2">
        <div class="flex items-start justify-between gap-2">
            <div class="min-w-0">
                <div class="font-mono text-[10px] uppercase font-bold text-[#57534E]">
                    @(isLoading ? "Loading YouTube Link..." : (currentSourceLabel ?? "Idle"))
                </div>
                <div class="font-comic text-sm font-bold text-[#1C1917] truncate">
                    @(currentTrackTitle ?? "Insert a YouTube link above or pick a preset below")
                </div>
                @if (!string.IsNullOrEmpty(currentTrackArtist))
                {
                    <div class="font-mono text-[11px] text-[#57534E] truncate">
                        @currentTrackArtist
                    </div>
                }
            </div>
            <span class="px-1.5 py-0.5 text-[9px] font-mono font-bold uppercase border border-[#1C1917] bg-[#FFFDF7] text-[#1C1917] rounded-sm shrink-0">
                Autoplay
            </span>
        </div>

        <!-- Seekable Progress Bar -->
        <div class="space-y-1">
            <input type="range"
                   min="0"
                   max="@Math.Max(1, durationSec)"
                   value="@currentSec"
                   @onchange="HandleSeek"
                   class="w-full accent-[#1C1917] cursor-pointer h-1.5" />
            <div class="flex justify-between font-mono text-[10px] text-[#57534E]">
                <span>@FormatTime(currentSec)</span>
                <span>@FormatTime(durationSec)</span>
            </div>
        </div>

        <!-- Transport Controls -->
        <div class="flex items-center justify-between pt-1">
            <div class="flex items-center gap-1.5">
                <button type="button"
                        @onclick="PrevTrack"
                        title="Previous"
                        class="ink-btn px-2 py-1 text-xs font-mono font-bold bg-[#FFFDF7] hover:bg-[#F4C430] text-[#1C1917] rounded-sm">
                    |&lt;
                </button>
                <button type="button"
                        @onclick="TogglePlayPause"
                        title="Play / Pause"
                        class="ink-btn px-3 py-1 text-xs font-comic font-bold uppercase bg-[#F4C430] hover:bg-[#e5b522] text-[#1C1917] rounded-sm">
                    @(isPlaying ? "Pause" : "Play")
                </button>
                <button type="button"
                        @onclick="NextTrack"
                        title="Next"
                        class="ink-btn px-2 py-1 text-xs font-mono font-bold bg-[#FFFDF7] hover:bg-[#F4C430] text-[#1C1917] rounded-sm">
                    &gt;|
                </button>
            </div>

            <div class="flex items-center gap-1.5">
                <span class="font-mono text-[10px] font-bold text-[#57534E]">@volume%</span>
                <input type="range"
                       min="0"
                       max="100"
                       value="@volume"
                       @oninput="HandleVolume"
                       class="w-14 accent-[#1C1917] cursor-pointer h-1.5" />
            </div>
        </div>
    </div>

    <!-- Quick Reading Presets -->
    <div>
        <div class="text-[10px] font-mono font-bold uppercase tracking-wider text-[#57534E] mb-1.5">
            Quick Reading Presets
        </div>
        <div class="grid grid-cols-1 gap-1.5">
            @foreach (var preset in ReadingPresets)
            {
                var active = activePresetId == preset.Id;
                <button type="button"
                        @onclick="() => LoadPreset(preset)"
                        class="text-left px-2.5 py-1.5 rounded-sm border-2 text-xs font-comic font-bold transition-all flex items-center justify-between gap-2 @(active ? "border-[#1C1917] bg-[#F4C430] text-[#1C1917] shadow-[2px_2px_0px_#1C1917]" : "border-[#1C1917]/30 bg-[#FFFDF7] hover:bg-[#F2EAD8] text-[#1C1917]")">
                    <span class="truncate">@preset.Name</span>
                    <span class="font-mono text-[9px] font-normal shrink-0 @(active ? "opacity-80" : "text-[#57534E]")">@preset.Tracks.Count tracks</span>
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<string?> OnMoodChanged { get; set; }
    [Parameter] public EventCallback<bool> OnPlayStateChanged { get; set; }

    public sealed record TrackItem(string Title, string Artist, string? VideoId = null, string? PlaylistId = null, string? Duration = null);
    public sealed record ResolveResponse(string Status, string? ErrorMessage, string? SourceLabel, TrackItem[]? Items);
    private sealed record MusicPreset(string Id, string Name, IReadOnlyList<TrackItem> Tracks);

    private static readonly IReadOnlyList<MusicPreset> ReadingPresets = new[]
    {
        new MusicPreset("peaceful-piano", "Peaceful Piano", new[]
        {
            new TrackItem("Nuvole Bianche", "Ludovico Einaudi", "kcihcYEOeic"),
            new TrackItem("River Flows in You", "Yiruma", "7maJOI3QMu0"),
            new TrackItem("Comptine d'un autre été", "Yann Tiersen", "NvryolGa19A"),
            new TrackItem("Clair de Lune", "Claude Debussy", "CvFH_6DNRCY")
        }),
        new MusicPreset("lofi-beats", "Lofi Beats", new[]
        {
            new TrackItem("Lofi Hip Hop Radio - Beats to Relax/Study", "Lofi Girl", "jfKfPfyJRdk"),
            new TrackItem("Affection", "Jinsang", "dIC4j6Rn9s4"),
            new TrackItem("Snowman", "WYS", "2OEL4P1Rz04")
        }),
        new MusicPreset("rainy-jazz", "Rainy Day Jazz", new[]
        {
            new TrackItem("Autumn Leaves", "Bill Evans Trio", "r-Z8KuwI7Gc"),
            new TrackItem("Blue in Green", "Miles Davis", "TLDflhhdPCg"),
            new TrackItem("In a Sentimental Mood", "Duke Ellington & John Coltrane", "sR13ECD71xU")
        }),
        new MusicPreset("classical-focus", "Classical Focus", new[]
        {
            new TrackItem("Gymnopédie No. 1", "Erik Satie", "S-Xm7s9eGxU"),
            new TrackItem("Cello Suite No. 1 in G Major", "J.S. Bach", "1prweT95Mo0"),
            new TrackItem("Nocturne Op. 9 No. 2", "Frédéric Chopin", "9E6b3swbnWg")
        })
    };

    private DotNetObjectReference<AmbienceDrawer>? dotNetRef;
    private bool initialized;
    private bool isPlaying;
    private bool isLoading;
    private string activePresetId = "";
    private string queryInput = "";
    private string? validationMessage;
    private string? currentSourceLabel;
    private string? currentTrackTitle;
    private string? currentTrackArtist;
    private int currentSec;
    private int durationSec;
    private int volume = 10;
    private List<TrackItem> queue = new();
    private int queueIndex;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !initialized)
        {
            initialized = true;
            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("EveryPageMusic.init", dotNetRef, volume);
        }
    }

    private async Task LoadPreset(MusicPreset preset)
    {
        validationMessage = null;
        activePresetId = preset.Id;
        currentSourceLabel = preset.Name;
        queue = preset.Tracks.ToList();
        await PlayQueueIndex(0);
    }

    private async Task HandleInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitLink();
        }
    }

    private async Task SubmitLink()
    {
        var input = queryInput?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(input))
        {
            validationMessage = "Please insert a valid YouTube link (youtube.com or youtu.be).";
            return;
        }

        validationMessage = null;
        isLoading = true;
        StateHasChanged();

        try
        {
            var response = await JS.InvokeAsync<ResolveResponse>("EveryPageMusic.searchOrResolve", input);
            if (response is null || response.Status != "ok" || response.Items is null || response.Items.Length == 0)
            {
                validationMessage = response?.ErrorMessage
                    ?? "Only valid YouTube links (youtube.com or youtu.be) are accepted.";
                return;
            }

            activePresetId = "";
            currentSourceLabel = response.SourceLabel ?? "YouTube Link";
            queue = response.Items.ToList();
            await PlayQueueIndex(0);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task PlayQueueIndex(int index)
    {
        if (queue.Count == 0) return;
        queueIndex = ((index % queue.Count) + queue.Count) % queue.Count;
        var track = queue[queueIndex];

        currentTrackTitle = track.Title;
        currentTrackArtist = track.Artist;
        currentSec = 0;
        durationSec = 0;
        StateHasChanged();

        await JS.InvokeVoidAsync("EveryPageMusic.playDirect", track.VideoId, track.PlaylistId, volume);
        isPlaying = true;
        await OnPlayStateChanged.InvokeAsync(true);
        await OnMoodChanged.InvokeAsync(track.Title);
    }

    public async Task TogglePlayPause()
    {
        if (queue.Count == 0)
        {
            validationMessage = "Insert a valid YouTube link above or pick one of the presets below first.";
            return;
        }
        isPlaying = await JS.InvokeAsync<bool>("EveryPageMusic.togglePlay");
        await OnPlayStateChanged.InvokeAsync(isPlaying);
    }

    private async Task NextTrack()
    {
        if (queue.Count == 0) return;
        if (queue.Count == 1 && !string.IsNullOrEmpty(queue[0].PlaylistId))
        {
            await JS.InvokeVoidAsync("EveryPageMusic.nextInPlaylist");
            return;
        }
        await PlayQueueIndex(queueIndex + 1);
    }

    private async Task PrevTrack()
    {
        if (queue.Count == 0) return;
        if (queue.Count == 1 && !string.IsNullOrEmpty(queue[0].PlaylistId))
        {
            await JS.InvokeVoidAsync("EveryPageMusic.prevInPlaylist");
            return;
        }
        await PlayQueueIndex(queueIndex - 1);
    }

    private async Task HandleSeek(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sec))
        {
            currentSec = sec;
            await JS.InvokeVoidAsync("EveryPageMusic.seekTo", sec);
        }
    }

    private async Task HandleVolume(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var vol))
        {
            volume = vol;
            await JS.InvokeVoidAsync("EveryPageMusic.setVolume", vol);
        }
    }

    [JSInvokable]
    public async Task OnPlayerProgress(int current, int duration, bool playing, string? liveTitle, string? liveArtist)
    {
        currentSec = current;
        durationSec = duration;
        if (isPlaying != playing)
        {
            isPlaying = playing;
            await OnPlayStateChanged.InvokeAsync(playing);
        }

        if (!string.IsNullOrWhiteSpace(liveTitle) && liveTitle != currentTrackTitle)
        {
            currentTrackTitle = liveTitle;
            if (!string.IsNullOrWhiteSpace(liveArtist))
            {
                currentTrackArtist = liveArtist;
            }
            await OnMoodChanged.InvokeAsync(liveTitle);
        }

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnTrackEnded()
    {
        await NextTrack();
    }

    private static string FormatTime(int totalSeconds)
    {
        if (totalSeconds <= 0) return "0:00";
        var mins = totalSeconds / 60;
        var secs = totalSeconds % 60;
        return $"{mins}:{secs:D2}";
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("EveryPageMusic.dispose"); } catch { }
        dotNetRef?.Dispose();
    }
}