@inherits LayoutComponentBase
@using EveryPageLibrary.Services
@using EveryPageLibrary.Components
@inject AuthStateService AuthState
@inject CatalogStateService CatalogState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<div class="min-h-screen paper-sheet bg-[#FAF6EC] text-[#1C1917] flex flex-col font-hand selection:bg-[#F4C430]/50 selection:text-[#1C1917]">
    <header class="sticky top-0 z-40 bg-[#FFFDF7]/95 backdrop-blur-sm border-b-2 border-[#1C1917]">
        <div class="w-full px-3 sm:px-5">
            <div class="grid grid-cols-[auto_1fr_auto] items-center h-14 sm:h-16 gap-3 sm:gap-5">
                <div class="flex items-center justify-start min-w-0">
                    <a href="" @onclick="ResetToHome" @onclick:preventDefault="true" class="flex items-center gap-2.5 group min-w-0">
                        <img src="logo.png" alt="EveryPage Library" class="w-9 h-9 sm:w-10 sm:h-10 shrink-0 object-contain rounded-md group-hover:-translate-y-0.5 transition-transform" />
                        <div class="hidden sm:block min-w-0">
                            <span class="font-comic text-lg sm:text-xl font-bold text-[#1C1917] group-hover:text-[#D93829] transition-colors block leading-none truncate">EveryPage Library</span>
                            <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-[#57534E] block mt-0.5 truncate">Open Paper &amp; Ink Reading Hall</span>
                        </div>
                    </a>
                </div>

                <div class="flex items-center justify-center w-full max-w-2xl mx-auto">
                    <form @onsubmit="HandleHeaderSearch" @onsubmit:preventDefault class="flex items-center w-full gap-1.5">
                        <div class="relative flex-1 flex items-center">
                            <svg class="w-4 h-4 text-[#57534E] absolute left-3 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <input type="text" @bind="CatalogState.SearchQuery" @bind:event="oninput"
                                   placeholder="Search titles, authors, Standard Ebooks, Gutenberg, Open Library..."
                                   aria-label="Search library catalog"
                                   class="ink-field w-full pl-9 pr-8 py-1.5 sm:py-2 text-xs sm:text-sm font-mono bg-[#FFFDF7] text-[#1C1917] border-2 border-[#1C1917] rounded-sm focus:outline-none" />
                            @if (!string.IsNullOrWhiteSpace(CatalogState.SearchQuery))
                            {
                                <button type="button" @onclick="HandleClearHeaderSearch" title="Clear search" class="absolute right-2.5 text-xs font-mono font-bold text-[#57534E] hover:text-[#1C1917]">&#x2715;</button>
                            }
                        </div>
                        <button type="submit" class="ink-btn px-3 sm:px-4 py-1.5 sm:py-2 text-xs font-comic font-bold uppercase bg-[#F4C430] hover:bg-[#e5b522] text-[#1C1917] rounded-sm shrink-0">Search</button>
                    </form>
                </div>

                <div class="flex items-center justify-end gap-2 min-w-0">
                    @if (!string.IsNullOrEmpty(nowPlayingTitle))
                    {
                        <button type="button" @onclick="HandleNowPlayingClick"
                                class="inline-flex items-center gap-2 px-2.5 py-1.5 text-xs font-mono font-bold bg-[#F2EAD8] hover:bg-[#F4C430] text-[#1C1917] border-2 border-[#1C1917] shadow-[2px_2px_0px_#1C1917] rounded-sm max-w-[140px] sm:max-w-[220px] truncate transition-colors">
                            <span class="w-2 h-2 rounded-full @(isAudioPlaying ? "bg-emerald-500 animate-pulse" : "bg-[#57534E]") shrink-0"></span>
                            <span class="truncate">@nowPlayingTitle</span>
                        </button>
                    }
                    else
                    {
                        <span class="hidden md:inline-flex items-center gap-1.5 px-2.5 py-1 text-[10px] font-mono font-bold uppercase tracking-wider text-[#57534E] border border-dashed border-[#1C1917]/30 rounded-sm select-none">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#57534E]/60"></span><span>Audio Idle</span>
                        </span>
                    }
                </div>
            </div>
        </div>
    </header>

    <div class="flex-1 flex items-stretch relative overflow-x-clip">
        @if (isLeftSidebarOpen || isRightSidebarOpen)
        {
            <div class="fixed inset-0 top-14 bg-black/40 z-20 lg:hidden" @onclick="CloseMobileSidebars"></div>
        }

        <div class="relative flex shrink-0 z-30">
            <aside class="@(isLeftSidebarOpen
                    ? "fixed lg:sticky top-14 sm:top-16 left-0 w-80 xl:w-[340px] h-[calc(100vh-3.5rem)] sm:h-[calc(100vh-4rem)] translate-x-0 border-r-2 border-[#1C1917] bg-[#FFFDF7] shadow-[4px_0_0_#1C1917] lg:shadow-none"
                    : "fixed lg:static top-14 sm:top-16 left-0 w-80 h-[calc(100vh-3.5rem)] -translate-x-full lg:w-0 lg:overflow-hidden lg:border-0") transition-all duration-200 flex flex-col">
                <CatalogSidebar @ref="catalogSidebar"
                                OnUploadClick="HandleUploadClick"
                                OnResetFilters="ResetCatalogFilters"
                                OnSelectDomain="SelectDomain"
                                OnSignOut="SignOut"
                                OnOpenAuthModal="() => isAuthModalOpen = true" />
            </aside>

            <button type="button" @onclick="() => isLeftSidebarOpen = !isLeftSidebarOpen"
                    class="fixed top-1/2 -translate-y-1/2 z-50 h-28 px-1.5 flex items-center justify-center gap-1 bg-[#F4C430] hover:bg-[#e5b522] text-[#1C1917] border-2 border-l-0 border-[#1C1917] shadow-[3px_3px_0px_#1C1917] rounded-r-sm font-mono text-[10px] font-bold uppercase tracking-wider transition-all duration-200 [writing-mode:vertical-rl] @(isLeftSidebarOpen ? "left-80 xl:left-[340px]" : "left-0")">
                <span>@(isLeftSidebarOpen ? "◄" : "►")</span><span>Catalog</span>
            </button>
        </div>

        <main class="flex-1 min-w-0 flex flex-col relative">
            <div class="flex-1 w-full px-2 sm:px-4 lg:px-6 py-3 sm:py-5">
                <div class="w-full h-full bg-[#FFFDF7]/60 border-2 border-[#1C1917] shadow-[6px_6px_0px_#1C1917] rounded-sm comic-spread-frame overflow-x-clip">
                    @Body
                </div>
            </div>

            <footer class="border-t-2 border-[#1C1917] bg-[#FFFDF7] py-6 mt-6 text-center select-none">
                <div class="w-full px-4 sm:px-6">
                    <div class="sacred-divider max-w-md mx-auto my-3"><div class="sacred-divider-diamond"></div></div>
                    <p class="font-comic text-lg sm:text-xl font-bold text-[#1C1917] mb-1.5">"Everything Humanity Has Written, Open to Everyone."</p>
                    <div class="text-xs font-mono text-[#57534E] space-y-1">
                        <p>EveryPage Library &bull; Community PDFs, Internet Archive, Open Library, Project Gutenberg, Wikisource &amp; DOAB</p>
                        <p>Typed up fresh on warm paper &mdash; free to read and download without an account</p>
                    </div>
                </div>
            </footer>
        </main>

        <div class="relative flex shrink-0 z-30">
            <button type="button" @onclick="() => isRightSidebarOpen = !isRightSidebarOpen"
                    class="fixed top-1/2 -translate-y-1/2 z-50 h-28 px-1.5 flex items-center justify-center gap-1.5 bg-[#F4C430] hover:bg-[#e5b522] text-[#1C1917] border-2 border-r-0 border-[#1C1917] shadow-[-3px_3px_0px_#1C1917] rounded-l-sm font-mono text-[10px] font-bold uppercase tracking-wider transition-all duration-200 [writing-mode:vertical-rl] @(isRightSidebarOpen ? "right-80 xl:right-[340px]" : "right-0")">
                @if (isAudioPlaying) { <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> }
                <span>@(isRightSidebarOpen ? "►" : "◄")</span><span>Mood</span>
            </button>

            <aside class="@(isRightSidebarOpen
                    ? "fixed lg:sticky top-14 sm:top-16 right-0 w-80 xl:w-[340px] h-[calc(100vh-3.5rem)] sm:h-[calc(100vh-4rem)] translate-x-0 border-l-2 border-[#1C1917] bg-[#FFFDF7] shadow-[-4px_0_0_#1C1917] lg:shadow-none"
                    : "fixed lg:static top-14 sm:top-16 right-0 w-80 h-[calc(100vh-3.5rem)] translate-x-full lg:w-0 lg:overflow-hidden lg:border-0") transition-all duration-200 flex flex-col">
                <MoodSidebar @ref="moodSidebar"
                             IsAudioPlaying="isAudioPlaying"
                             CurrentTheme="@currentTheme"
                             OnMoodChanged="title => nowPlayingTitle = title"
                             OnPlayStateChanged="playing => isAudioPlaying = playing"
                             OnSelectTheme="SelectTheme" />
            </aside>
        </div>
    </div>
</div>

<AuthModal IsOpen="isAuthModalOpen" OnClose="() => isAuthModalOpen = false" OnAuthenticated="() => { isAuthModalOpen = false; StateHasChanged(); }" />

<nav class="lg:hidden fixed bottom-0 inset-x-0 z-50 h-12 bg-[#1C1917] text-[#F5F0E1] border-t-2 border-[#1C1917] grid grid-cols-3 font-mono text-xs font-bold uppercase tracking-wider select-none">
    <button type="button" @onclick="MobileToggleCatalog" class="flex items-center justify-center gap-1.5 border-r border-[#44403C] transition-colors @(isLeftSidebarOpen ? "bg-[#E4C438] text-[#1C1917]" : "active:bg-[#292524]")">
        <span>&#9776;</span><span>Catalog</span>
    </button>
    <button type="button" @onclick="MobileShowBooks" class="flex items-center justify-center border-r border-[#44403C] transition-colors @((!isLeftSidebarOpen && !isRightSidebarOpen) ? "bg-[#E4C438] text-[#1C1917]" : "active:bg-[#292524]")">
        <span>Books</span>
    </button>
    <button type="button" @onclick="MobileToggleMood" class="flex items-center justify-center gap-1.5 transition-colors @(isRightSidebarOpen ? "bg-[#E4C438] text-[#1C1917]" : "active:bg-[#292524]")">
        <span>&#9834;</span><span>Mood</span>
    </button>
</nav>

@code {
    private CatalogSidebar? catalogSidebar;
    private MoodSidebar? moodSidebar;
    private bool isAuthModalOpen;
    private bool isLeftSidebarOpen = true;
    private bool isRightSidebarOpen = true;
    private bool isAudioPlaying;
    private string currentTheme = "charlie-brown";
    private string? nowPlayingTitle;

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += HandleStateChanged;
        CatalogState.OnFacetChanged += HandleStateChanged;
        CatalogState.OnStatsUpdated += HandleStateChanged;
        await AuthState.InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var width = await JS.InvokeAsync<int>("eval", "window.innerWidth");
            if (width < 1024) { isLeftSidebarOpen = false; isRightSidebarOpen = false; }
        }
        catch { }

        try
        {
            var savedTheme = await JS.InvokeAsync<string?>("EveryPageStorage.get", "everypage_peanuts_theme");
            if (savedTheme == "bw-minimal") savedTheme = "snoopy-day";
            if (savedTheme == "peppermint-patty") savedTheme = "charlie-brown";
            if (!string.IsNullOrWhiteSpace(savedTheme) && MoodSidebar.Themes.Any(t => t.Id == savedTheme)) currentTheme = savedTheme;
            await JS.InvokeVoidAsync("EveryPageTheme.set", currentTheme);
        }
        catch { }

        StateHasChanged();
    }

    private async Task ResetToHome()
    {
        isLeftSidebarOpen = false;
        isRightSidebarOpen = false;
        catalogSidebar?.CollapseState();
        await CatalogState.ResetAllAsync();
        Navigation.NavigateTo("/", forceLoad: false);
        try { await JS.InvokeVoidAsync("window.scrollTo", 0, 0); } catch { }
    }

    private void MobileToggleCatalog() { isLeftSidebarOpen = !isLeftSidebarOpen; if (isLeftSidebarOpen) isRightSidebarOpen = false; }
    private void MobileToggleMood() { isRightSidebarOpen = !isRightSidebarOpen; if (isRightSidebarOpen) isLeftSidebarOpen = false; }
    private void MobileShowBooks() { isLeftSidebarOpen = false; isRightSidebarOpen = false; }
    private void CloseMobileSidebars() { isLeftSidebarOpen = false; isRightSidebarOpen = false; }

    private async Task HandleHeaderSearch() { EnsureOnHomeRoute(); await CatalogState.ApplySearchAsync(); }
    private async Task HandleClearHeaderSearch() { EnsureOnHomeRoute(); await CatalogState.ClearSearchAsync(); }
    private async Task SelectDomain(string domain) { EnsureOnHomeRoute(); await CatalogState.SetCategoryAsync(domain); }
    private async Task ResetCatalogFilters() { EnsureOnHomeRoute(); await CatalogState.ResetAllAsync(); }
    private void HandleUploadClick() { EnsureOnHomeRoute(); CatalogState.RequestUpload(); }

    private void EnsureOnHomeRoute()
    {
        if (!string.IsNullOrEmpty(Navigation.ToBaseRelativePath(Navigation.Uri))) Navigation.NavigateTo("/");
    }

    private async Task SelectTheme(string themeId)
    {
        currentTheme = themeId;
        await JS.InvokeVoidAsync("EveryPageTheme.set", currentTheme);
    }

    private async Task HandleNowPlayingClick()
    {
        if (!isRightSidebarOpen) { isRightSidebarOpen = true; return; }
        if (moodSidebar?.AudioDrawer is not null) await moodSidebar.AudioDrawer.TogglePlayPause();
    }

    private async Task SignOut()
    {
        catalogSidebar?.CollapseState();
        await AuthState.SignOutAsync();
        Navigation.NavigateTo("/");
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        AuthState.OnChange -= HandleStateChanged;
        CatalogState.OnFacetChanged -= HandleStateChanged;
        CatalogState.OnStatsUpdated -= HandleStateChanged;
    }
}