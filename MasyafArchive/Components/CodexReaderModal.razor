@using MasyafArchive.Models
@using MasyafArchive.Services
@inject ArchiveService ArchiveService
@inject AuthStateService AuthState

@if (IsOpen && Book != null)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-black/65 flex items-center justify-center p-2 sm:p-4 animate-modal-in"
         tabindex="-1"
         @onkeydown="HandleKeyDown">

        <div class="relative w-full max-w-6xl h-[92vh] max-h-[920px] flex flex-col rounded-sm border-2 border-[#1C1917] shadow-[8px_8px_0px_#1C1917] overflow-hidden @(IsParchmentMode ? "bg-[#F2EAD8]" : "bg-[#FFFDF7]") text-[#1C1917]">
            <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-3.5 border-b-2 border-[#1C1917] bg-[#FAF6EC] z-10 select-none">
                <div class="flex items-center gap-2.5 min-w-0">
                    <span class="px-2 py-0.5 text-xs font-mono font-bold uppercase rounded-sm border-2 border-[#1C1917] bg-[#F4C430]">
                        @Book.GenreLabel
                    </span>
                    <span class="hidden sm:inline-block px-2 py-0.5 text-xs font-mono font-bold uppercase rounded-sm border-2 border-[#1C1917] bg-[#FFFDF7]">
                        @Book.SourceBadge
                    </span>
                    <div class="truncate">
                        <h2 class="font-comic text-lg sm:text-xl font-bold truncate text-[#1C1917]">@Book.Title</h2>
                        <span class="text-xs font-mono text-[#57534E]">By @Book.Author</span>
                    </div>
                </div>

                <div class="flex items-center gap-2 flex-wrap">
                    @if (!HasEmbeddableDocument)
                    {
                        <div class="flex items-center rounded-sm border-2 border-[#1C1917] bg-[#FFFDF7] p-0.5 text-xs font-mono font-bold">
                            <button type="button" @onclick='() => FontSize = "S"' class='px-2 py-0.5 rounded-sm @(FontSize == "S" ? "bg-[#F4C430]" : "")'>S</button>
                            <button type="button" @onclick='() => FontSize = "M"' class='px-2 py-0.5 rounded-sm @(FontSize == "M" ? "bg-[#F4C430]" : "")'>M</button>
                            <button type="button" @onclick='() => FontSize = "L"' class='px-2 py-0.5 rounded-sm @(FontSize == "L" ? "bg-[#F4C430]" : "")'>L</button>
                        </div>

                        <button type="button"
                                @onclick="() => IsParchmentMode = !IsParchmentMode"
                                class="ink-btn px-2.5 py-1 text-xs font-mono font-bold rounded-sm bg-[#FFFDF7] text-[#1C1917]">
                            @(IsParchmentMode ? "White Paper" : "Manila Tint")
                        </button>
                    }

                    @if (!string.IsNullOrWhiteSpace(EffectivePdfUrl))
                    {
                        <button type="button" @onclick='() => TriggerFormatDownload("pdf")'
                                class="ink-btn px-3 py-1.5 text-xs font-comic font-bold uppercase bg-[#D93829] text-[#FFFDF7] rounded-sm">
                            Download PDF
                        </button>
                    }

                    @if (!string.IsNullOrWhiteSpace(Book.EpubUrl))
                    {
                        <button type="button" @onclick='() => TriggerFormatDownload("epub")'
                                class="ink-btn px-3 py-1.5 text-xs font-comic font-bold uppercase bg-[#F4C430] text-[#1C1917] rounded-sm">
                            Download EPUB
                        </button>
                    }

                    @if (string.IsNullOrWhiteSpace(EffectivePdfUrl) && string.IsNullOrWhiteSpace(Book.EpubUrl))
                    {
                        <button type="button" @onclick='() => TriggerFormatDownload("txt")'
                                class="ink-btn px-3 py-1.5 text-xs font-comic font-bold uppercase bg-[#D93829] text-[#FFFDF7] rounded-sm">
                            Download Book
                        </button>
                    }

                    <button type="button" @onclick="Close"
                            class="ink-btn px-2.5 py-1 text-sm font-mono font-bold bg-[#FFFDF7] hover:bg-[#D93829] hover:text-[#FFFDF7] rounded-sm">
                        &#x2715;
                    </button>
                </div>
            </div>

            <div class="flex-1 overflow-hidden grid grid-cols-1 lg:grid-cols-3 divide-y-2 lg:divide-y-0 lg:divide-x-2 divide-[#1C1917]">
                <div class="lg:col-span-2 overflow-y-auto @(HasEmbeddableDocument ? "p-0 bg-[#F2EAD8]" : "p-6 sm:p-10")">
                    @if (!string.IsNullOrWhiteSpace(ArchiveEmbedUrl))
                    {
                        <iframe src="@ArchiveEmbedUrl" title="@Book.Title" allowfullscreen class="w-full h-full min-h-[560px] border-0"></iframe>
                    }
                    else if (!string.IsNullOrWhiteSpace(EffectivePdfUrl))
                    {
                        <iframe src="@EffectivePdfUrl" title="@Book.Title" class="w-full h-full min-h-[560px] border-0"></iframe>
                    }
                    else
                    {
                        <div class="max-w-2xl mx-auto mb-8 text-center">
                            @if (!string.IsNullOrWhiteSpace(Book.CoverUrl))
                            {
                                <img src="@Book.CoverUrl" alt="@Book.Title cover" class="w-28 h-40 object-cover mx-auto mb-5 rounded-sm border-2 border-[#1C1917] shadow-[3px_3px_0px_#1C1917]" />
                            }
                            <div class="sacred-divider"><div class="sacred-divider-diamond"></div></div>
                            <h1 class="font-comic text-3xl sm:text-4xl font-bold mb-2 text-[#1C1917]">@Book.Title</h1>
                            <p class="font-serif italic text-lg mb-4 text-[#D93829]">By @Book.Author</p>
                            @if (!string.IsNullOrWhiteSpace(Book.Synopsis))
                            {
                                <div class="p-4 rounded-sm border-2 border-[#1C1917] bg-[#FAF6EC] text-sm text-left mb-6 shadow-[3px_3px_0px_#1C1917]">
                                    <strong class="font-mono font-bold uppercase text-xs block mb-1 text-[#D93829]">Library Card Notes</strong>
                                    @Book.Synopsis
                                </div>
                            }
                        </div>

                        <div class="max-w-2xl mx-auto @GetFontSizeClass() leading-relaxed space-y-5 font-serif text-[#1C1917]">
                            @{
                                var paragraphs = (Book.ContentText ?? string.Empty).Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries);
                            }
                            @if (paragraphs.Length == 0)
                            {
                                <div class="p-6 rounded-sm border-2 border-[#1C1917] bg-[#FAF6EC] text-center space-y-2 font-hand">
                                    <p class="text-lg font-bold">Hosted by @Book.SourceBadge</p>
                                    <p class="text-base text-[#57534E]">Click any download button in the top bar to save this edition directly to your computer.</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var p in paragraphs)
                                {
                                    <p>@p.Trim()</p>
                                }
                            }
                        </div>
                    }
                </div>

                <!-- Margin Notes Column -->
                <div class="lg:col-span-1 flex flex-col h-full bg-[#FAF6EC] overflow-hidden">
                    <div class="p-4 border-b-2 border-[#1C1917] bg-[#F2EAD8] flex items-center justify-between">
                        <h3 class="font-comic text-lg font-bold uppercase text-[#1C1917]">Margin Notes</h3>
                        <span class="font-mono text-xs font-bold px-2 py-0.5 rounded-sm border-2 border-[#1C1917] bg-[#F4C430]">@Comments.Count</span>
                    </div>

                    <div class="flex-1 overflow-y-auto p-4 space-y-3">
                        @if (isLoadingComments)
                        {
                            <div class="py-8 text-center text-xs font-mono text-[#57534E]">Reading margin notes...</div>
                        }
                        else if (Comments.Count == 0)
                        {
                            <div class="py-10 text-center text-sm text-[#57534E]">No margin notes yet. Jot down your thoughts below!</div>
                        }
                        else
                        {
                            @foreach (var comment in Comments)
                            {
                                <div class="p-3 rounded-sm border-2 border-[#1C1917] bg-[#FFFDF7] shadow-[2px_2px_0px_#1C1917] text-sm">
                                    <div class="flex items-center justify-between mb-1">
                                        <span class="font-comic font-bold text-[#D93829]">@comment.AuthorName</span>
                                        <div class="flex items-center gap-2">
                                            <span class="text-[11px] font-mono text-[#57534E]">@comment.CreatedAt.ToUniversalTime().ToString("MMM dd")</span>
                                            @if (CanDeleteComment(comment))
                                            {
                                                <button type="button" @onclick="() => SoftDeleteComment(comment.Id)" class="text-[#D93829] font-bold text-xs">&#x2715;</button>
                                            }
                                        </div>
                                    </div>
                                    <p class="leading-snug whitespace-pre-wrap">@comment.Body</p>
                                </div>
                            }
                        }
                    </div>

                    <div class="p-4 border-t-2 border-[#1C1917] bg-[#F2EAD8]">
                        @if (AuthState.IsAuthenticated)
                        {
                            <form @onsubmit="SubmitComment" class="space-y-2">
                                <label class="block text-xs font-mono font-bold uppercase text-[#57534E]">
                                    Note by <span class="text-[#D93829]">@AuthState.CurrentUser?.Username</span>
                                </label>
                                <textarea @bind="newCommentText" rows="2" placeholder="Write a margin note..." required disabled="@isSubmittingComment"
                                          class="w-full text-sm p-2.5 rounded-sm border-2 border-[#1C1917] bg-[#FFFDF7] text-[#1C1917] focus:outline-none"></textarea>
                                @if (!string.IsNullOrWhiteSpace(commentErrorMessage))
                                {
                                    <p class="text-xs font-mono text-[#D93829]">@commentErrorMessage</p>
                                }
                                <div class="flex justify-end">
                                    <button type="submit" disabled="@(isSubmittingComment || string.IsNullOrWhiteSpace(newCommentText))"
                                            class="ink-btn px-4 py-1.5 text-xs font-comic font-bold uppercase bg-[#D93829] text-[#FFFDF7] rounded-sm">
                                        @(isSubmittingComment ? "Posting..." : "Post Note")
                                    </button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="text-center p-3 rounded-sm border-2 border-dashed border-[#1C1917]/40 bg-[#FFFDF7]">
                                <p class="text-sm text-[#57534E] mb-2">Sign in with your library card to leave a note.</p>
                                <button type="button" @onclick="() => OnRequestSignIn.InvokeAsync()"
                                        class="ink-btn px-4 py-1 text-xs font-comic font-bold uppercase bg-[#F4C430] text-[#1C1917] rounded-sm">
                                    Sign In
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Book? Book { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<(Book Book, string? Format)> OnDownloadFormat { get; set; }
    [Parameter] public EventCallback OnRequestSignIn { get; set; }

    private bool IsParchmentMode { get; set; } = false;
    private string FontSize { get; set; } = "M";

    private List<BookComment> Comments { get; set; } = new();
    private bool isLoadingComments { get; set; } = false;
    private string newCommentText { get; set; } = "";
    private bool isSubmittingComment { get; set; } = false;
    private string commentErrorMessage { get; set; } = "";

    private string? EffectivePdfUrl =>
        !string.IsNullOrWhiteSpace(Book?.PdfUrl)
            ? Book!.PdfUrl
            : (Book?.FileUrl?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) == true ? Book.FileUrl : null);

    private string? ArchiveEmbedUrl
    {
        get
        {
            if (Book?.ExternalId != null &&
                Book.ExternalId.StartsWith("ol-", StringComparison.OrdinalIgnoreCase) &&
                !Book.ExternalId.StartsWith("ol-works/", StringComparison.OrdinalIgnoreCase))
            {
                var archiveId = Book.ExternalId["ol-".Length..];
                return $"{OpenLibraryBookSource.ArchiveEmbedBaseUrl}{archiveId}";
            }
            return null;
        }
    }

    private bool HasEmbeddableDocument =>
        !string.IsNullOrWhiteSpace(ArchiveEmbedUrl) || !string.IsNullOrWhiteSpace(EffectivePdfUrl);

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && Book != null) await LoadCommentsAsync();
    }

    private async Task LoadCommentsAsync()
    {
        if (Book == null || !Book.IsIndexed)
        {
            Comments = new List<BookComment>();
            return;
        }
        isLoadingComments = true;
        try { Comments = await ArchiveService.GetCommentsForBookAsync(Book.Id); }
        finally { isLoadingComments = false; }
    }

    private string GetFontSizeClass() => FontSize switch { "S" => "text-base", "L" => "text-2xl", _ => "text-lg" };

    private bool CanDeleteComment(BookComment comment) =>
        AuthState.IsAuthenticated && (AuthState.IsAuditor || string.Equals(AuthState.CurrentUser?.Username, comment.AuthorName, StringComparison.OrdinalIgnoreCase));

    private async Task SubmitComment()
    {
        if (string.IsNullOrWhiteSpace(newCommentText) || Book == null || !AuthState.IsAuthenticated) return;
        isSubmittingComment = true;
        commentErrorMessage = "";
        try
        {
            if (!Book.IsIndexed) Book = await ArchiveService.EnsureIndexedAsync(Book);
            if (!Book.IsIndexed) { commentErrorMessage = "Could not index book."; return; }

            var user = AuthState.CurrentUser!;
            var result = await ArchiveService.AddCommentAsync(Book.Id, Book.Title, user.Username, user.Role, newCommentText.Trim());
            if (result != null) { newCommentText = ""; await LoadCommentsAsync(); }
        }
        catch (Exception ex) { commentErrorMessage = ex.Message; }
        finally { isSubmittingComment = false; }
    }

    private async Task SoftDeleteComment(long commentId)
    {
        if (Book == null || !AuthState.IsAuthenticated) return;
        var user = AuthState.CurrentUser!;
        if (await ArchiveService.SoftDeleteCommentAsync(commentId, Book.Id, Book.Title, user.Username, user.Role))
            await LoadCommentsAsync();
    }

    private async Task TriggerFormatDownload(string format)
    {
        if (Book != null) await OnDownloadFormat.InvokeAsync((Book, format));
    }

    private async Task Close() => await OnClose.InvokeAsync();
    private async Task HandleKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") await Close(); }
}
