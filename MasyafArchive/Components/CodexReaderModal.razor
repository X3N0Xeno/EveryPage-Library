@using MasyafArchive.Models
@using MasyafArchive.Services
@inject ArchiveService ArchiveService
@inject AuthStateService AuthState

@if (IsOpen && Book != null)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-black/80 backdrop-blur-sm flex items-center justify-center p-2 sm:p-4 animate-modal-in"
         tabindex="-1"
         @onkeydown="HandleKeyDown">

        <!-- Outer Modal Frame -->
        <div class="relative w-full max-w-5xl h-[92vh] max-h-[900px] flex flex-col rounded-sm border border-[#2E2A25] shadow-2xl overflow-hidden @(IsParchmentMode ? "reader-parchment-mode" : "reader-stone-mode")">
            
            <!-- Top Controls Bar -->
            <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-4 border-b @(IsParchmentMode ? "border-[#D3C5A6] bg-[#EAE2CE]" : "border-[#2E2A25] bg-[#181614]") z-10 select-none">
                
                <!-- Left: Title & Moniker -->
                <div class="flex items-center gap-3 min-w-0">
                    <span class="px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider rounded-sm border @(IsParchmentMode ? "border-[#B5A582] bg-[#F5EEDB] text-[#7A5B22]" : "border-[#2E2A25] bg-[#0F0E0D] text-[#C8963E]")">
                        @Book.Category
                    </span>
                    <div class="truncate">
                        <h2 class="font-serif text-lg sm:text-xl font-bold truncate @(IsParchmentMode ? "text-[#241D17]" : "text-[#EDE6D6]")">
                            @Book.Title
                        </h2>
                        <span class="text-xs @(IsParchmentMode ? "text-[#5C5042]" : "text-[#9E9587]")">
                            By @Book.Author • Inscribed by @Book.UploadedBy
                        </span>
                    </div>
                </div>

                <!-- Right: Tool Controls (Theme, Font Size, View Mode, Download, Close) -->
                <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
                    
                    <!-- Font Size Controls (S / M / L) -->
                    <div class="flex items-center rounded-sm border @(IsParchmentMode ? "border-[#C9BA9B] bg-[#DFD6BF]" : "border-[#2E2A25] bg-[#0F0E0D]") p-0.5 text-xs font-mono">
                        <button type="button"
                                @onclick='() => SetFontSize("S")'
                                class='px-2 py-1 rounded-sm transition-all @(FontSize == "S" ? (IsParchmentMode ? "bg-[#C8963E] text-white" : "bg-[#C8963E] text-[#0F0E0D] font-bold") : "")'
                                title="Small font">
                            S
                        </button>
                        <button type="button"
                                @onclick='() => SetFontSize("M")'
                                class='px-2 py-1 rounded-sm transition-all @(FontSize == "M" ? (IsParchmentMode ? "bg-[#C8963E] text-white" : "bg-[#C8963E] text-[#0F0E0D] font-bold") : "")'
                                title="Medium font">
                            M
                        </button>
                        <button type="button"
                                @onclick='() => SetFontSize("L")'
                                class='px-2 py-1 rounded-sm transition-all @(FontSize == "L" ? (IsParchmentMode ? "bg-[#C8963E] text-white" : "bg-[#C8963E] text-[#0F0E0D] font-bold") : "")'
                                title="Large font">
                            L
                        </button>
                    </div>

                    <!-- Theme Toggle: Parchment vs Dark Stone -->
                    <button type="button"
                            @onclick="ToggleTheme"
                            class="px-2.5 py-1 text-xs font-medium rounded-sm border transition-all flex items-center gap-1.5 @(IsParchmentMode ? "border-[#C9BA9B] bg-[#DFD6BF] text-[#241D17]" : "border-[#2E2A25] bg-[#0F0E0D] text-[#EDE6D6] hover:border-[#8C6D3F]")">
                        @if (IsParchmentMode)
                        {
                            <!-- Candle icon for Stone mode -->
                            <svg class="w-3.5 h-3.5 text-[#C8963E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="5"></circle>
                                <line x1="12" y1="1" x2="12" y2="3"></line>
                                <line x1="12" y1="21" x2="12" y2="23"></line>
                            </svg>
                            <span>Dark Stone</span>
                        }
                        else
                        {
                            <!-- Scroll icon for Parchment mode -->
                            <svg class="w-3.5 h-3.5 text-[#C8963E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                            </svg>
                            <span>Vellum</span>
                        }
                    </button>

                    <!-- PDF Toggle if PDF available -->
                    @if (HasPdf)
                    {
                        <div class="flex items-center rounded-sm border @(IsParchmentMode ? "border-[#C9BA9B] bg-[#DFD6BF]" : "border-[#2E2A25] bg-[#0F0E0D]") p-0.5 text-xs">
                            <button type="button"
                                    @onclick='() => ShowPdfView = false'
                                    class='px-2 py-1 rounded-sm transition-all @(!ShowPdfView ? "bg-[#C8963E] text-[#0F0E0D] font-semibold" : "")'>
                                Codex Text
                            </button>
                            <button type="button"
                                    @onclick='() => ShowPdfView = true'
                                    class='px-2 py-1 rounded-sm transition-all @(ShowPdfView ? "bg-[#C8963E] text-[#0F0E0D] font-semibold" : "")'>
                                PDF Plate
                            </button>
                        </div>
                    }

                    <!-- Download Tome -->
                    <button type="button"
                            @onclick="() => OnDownload.InvokeAsync(Book)"
                            class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold uppercase tracking-wider bg-[#C8963E] hover:bg-[#DDA84B] text-[#0F0E0D] rounded-sm transition-all shadow-sm">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        <span>Download</span>
                    </button>

                    <!-- Close Button -->
                    <button type="button"
                            @onclick="Close"
                            class="p-1 rounded-sm hover:opacity-75 transition-opacity @(IsParchmentMode ? "text-[#5C5042] hover:text-[#241D17]" : "text-[#9E9587] hover:text-[#EDE6D6]")"
                            title="Close Reader (Esc)">
                        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Main Reading & Margin Notes Split Layout -->
            <div class="flex-1 overflow-hidden grid grid-cols-1 lg:grid-cols-3 divide-y lg:divide-y-0 lg:divide-x @(IsParchmentMode ? "divide-[#D3C5A6]" : "divide-[#2E2A25]")">
                
                <!-- Left 2 Cols: Main Manuscript Content -->
                <div class="lg:col-span-2 overflow-y-auto p-6 sm:p-10 reader-content-scroll">
                    @if (ShowPdfView && HasPdf)
                    {
                        <div class="w-full h-full min-h-[500px]">
                            <iframe src="@Book.FileUrl" class="w-full h-full min-h-[580px] rounded border @(IsParchmentMode ? "border-[#C9BA9B]" : "border-[#2E2A25]")"></iframe>
                        </div>
                    }
                    else
                    {
                        <!-- Manuscript Header -->
                        <div class="max-w-2xl mx-auto mb-8 text-center">
                            <div class="sacred-divider">
                                <div class="sacred-divider-diamond"></div>
                            </div>
                            <h1 class="font-serif text-3xl sm:text-4xl font-bold tracking-wide mb-2 @(IsParchmentMode ? "text-[#241D17]" : "text-[#EDE6D6]")">
                                @Book.Title
                            </h1>
                            <p class="font-serif italic text-base sm:text-lg mb-4 @(IsParchmentMode ? "text-[#6A5A48]" : "text-[#C8963E]")">
                                Inscribed by @Book.Author
                            </p>
                            @if (!string.IsNullOrWhiteSpace(Book.Synopsis))
                            {
                                <div class="p-4 rounded border text-sm italic leading-relaxed text-left mb-6 @(IsParchmentMode ? "bg-[#EDE4CD] border-[#D3C5A6] text-[#42382F]" : "bg-[#0F0E0D] border-[#2E2A25] text-[#9E9587]")">
                                    <strong class="font-sans font-semibold not-italic block text-xs tracking-wider uppercase mb-1 text-[#C8963E]">Synopsis</strong>
                                    @Book.Synopsis
                                </div>
                            }
                        </div>

                        <!-- Manuscript Body Text -->
                        <div class="max-w-2xl mx-auto @GetFontSizeClass() leading-relaxed space-y-6 @(IsParchmentMode ? "text-[#262019]" : "text-[#EDE6D6]")">
                            @{
                                var paragraphs = (Book.ContentText ?? string.Empty)
                                    .Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries);
                                bool isFirst = true;
                            }

                            @if (paragraphs.Length == 0)
                            {
                                <p class="italic text-center text-[#9E9587] py-12">
                                    This codex currently contains no inscribed text. Consult the attached parchment or PDF if available.
                                </p>
                            }
                            else
                            {
                                @foreach (var p in paragraphs)
                                {
                                    if (p.Trim().StartsWith("CHAPTER", StringComparison.OrdinalIgnoreCase) ||
                                        p.Trim().StartsWith("SECTION", StringComparison.OrdinalIgnoreCase) ||
                                        p.Trim().StartsWith("ENTRY", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div class="pt-6 pb-2 text-center">
                                            <div class="sacred-divider my-4">
                                                <div class="sacred-divider-diamond"></div>
                                            </div>
                                            <h4 class="font-serif text-xl sm:text-2xl font-bold uppercase tracking-widest text-[#C8963E]">
                                                @p.Trim()
                                            </h4>
                                        </div>
                                    }
                                    else if (isFirst)
                                    {
                                        <p class="drop-cap font-serif text-justify">
                                            @p.Trim()
                                        </p>
                                        isFirst = false;
                                    }
                                    else
                                    {
                                        <p class="font-serif text-justify">
                                            @p.Trim()
                                        </p>
                                    }
                                }
                            }

                            <!-- Colophon / Masyaf Seal Ending -->
                            <div class="pt-12 pb-6 text-center">
                                <div class="sacred-divider">
                                    <div class="sacred-divider-diamond"></div>
                                </div>
                                <p class="font-mono text-xs text-[#9E9587] uppercase tracking-widest">
                                    End of Codex Manuscript • The Masyaf Archive
                                </p>
                            </div>
                        </div>
                    }
                </div>

                <!-- Right Col: Margin Notes (Comments) Column -->
                <div class="lg:col-span-1 flex flex-col h-full @(IsParchmentMode ? "bg-[#EDE5D0]" : "bg-[#181614]") overflow-hidden">
                    
                    <!-- Notes Header -->
                    <div class="p-4 border-b @(IsParchmentMode ? "border-[#D3C5A6]" : "border-[#2E2A25]") flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <svg class="w-4 h-4 text-[#C8963E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 20h9"></path>
                                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                            </svg>
                            <h3 class="font-serif text-base font-bold uppercase tracking-wider @(IsParchmentMode ? "text-[#241D17]" : "text-[#EDE6D6]")">
                                Margin Notes
                            </h3>
                            <span class="font-mono text-xs px-2 py-0.5 rounded-full @(IsParchmentMode ? "bg-[#DFD6BF] text-[#241D17]" : "bg-[#0F0E0D] text-[#C8963E]")">
                                @Comments.Count
                            </span>
                        </div>
                    </div>

                    <!-- Notes List -->
                    <div class="flex-1 overflow-y-auto p-4 space-y-3">
                        @if (isLoadingComments)
                        {
                            <div class="py-8 text-center text-xs font-mono text-[#9E9587]">
                                Reading margin inscriptions...
                            </div>
                        }
                        else if (Comments.Count == 0)
                        {
                            <div class="py-12 text-center text-xs font-mono text-[#9E9587] space-y-2">
                                <p>No margin notes inscribed yet.</p>
                                <p class="text-[11px] opacity-75">Be the first scholar to annotate this parchment.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var comment in Comments)
                            {
                                <div class="p-3 rounded-sm border text-xs transition-all @(IsParchmentMode ? "bg-[#F5EEDB] border-[#D3C5A6] text-[#241D17]" : "bg-[#0F0E0D] border-[#2E2A25] text-[#EDE6D6]")">
                                    <div class="flex items-center justify-between mb-1.5 gap-2">
                                        <div class="flex items-center gap-2">
                                            <span class="font-semibold text-[#C8963E]">@comment.AuthorName</span>
                                            <span class="text-[10px] font-mono text-[#9E9587]">
                                                @comment.CreatedAt.ToUniversalTime().ToString("MMM dd, yyyy HH:mm") UTC
                                            </span>
                                        </div>

                                        <!-- Delete Note if Author or Auditor -->
                                        @if (CanDeleteComment(comment))
                                        {
                                            <button @onclick="() => SoftDeleteComment(comment.Id)"
                                                    title="Seal (Delete) Note"
                                                    class="text-[#9E9587] hover:text-[#9E332D] transition-colors p-1">
                                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                                </svg>
                                            </button>
                                        }
                                    </div>
                                    <p class="leading-relaxed whitespace-pre-wrap font-sans">
                                        @comment.Body
                                    </p>
                                </div>
                            }
                        }
                    </div>

                    <!-- Inscribe Margin Note Input -->
                    <div class="p-4 border-t @(IsParchmentMode ? "border-[#D3C5A6] bg-[#EAE2CE]" : "border-[#2E2A25] bg-[#181614]")">
                        @if (AuthState.IsAuthenticated)
                        {
                            <form @onsubmit="SubmitComment">
                                <div class="mb-2">
                                    <label class="block text-[11px] font-mono uppercase tracking-wider text-[#9E9587] mb-1">
                                        Inscribing as <span class="text-[#C8963E]">@AuthState.CurrentUser?.Username</span> (@AuthState.CurrentUser?.Role)
                                    </label>
                                    <textarea @bind="newCommentText"
                                              rows="2"
                                              placeholder="Inscribe a margin observation..."
                                              required
                                              disabled="@isSubmittingComment"
                                              class="w-full text-xs p-2.5 rounded-sm border focus:outline-none transition-all @(IsParchmentMode ? "bg-[#F5EEDB] border-[#C9BA9B] text-[#241D17] focus:border-[#C8963E]" : "bg-[#0F0E0D] border-[#2E2A25] text-[#EDE6D6] focus:border-[#8C6D3F]")">
                                    </textarea>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(commentErrorMessage))
                                {
                                    <p class="text-xs text-[#9E332D] mb-2 font-mono">@commentErrorMessage</p>
                                }

                                <div class="flex justify-end">
                                    <button type="submit"
                                            disabled="@(isSubmittingComment || string.IsNullOrWhiteSpace(newCommentText))"
                                            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider bg-[#C8963E] hover:bg-[#DDA84B] disabled:opacity-50 text-[#0F0E0D] rounded-sm transition-all shadow-sm">
                                        @if (isSubmittingComment)
                                        {
                                            <span>Inscribing...</span>
                                        }
                                        else
                                        {
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <line x1="22" y1="2" x2="11" y2="13"></line>
                                                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                            </svg>
                                            <span>Inscribe Note</span>
                                        }
                                    </button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <!-- Unauthenticated Gate Prompt -->
                            <div class="text-center p-3 rounded-sm border border-dashed @(IsParchmentMode ? "border-[#C9BA9B] bg-[#F5EEDB]/50" : "border-[#2E2A25] bg-[#0F0E0D]")">
                                <p class="text-xs text-[#9E9587] mb-2 font-sans">
                                    Sign in as a Scholar to inscribe margin notes into this codex.
                                </p>
                                <button type="button"
                                        @onclick="TriggerSignIn"
                                        class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-medium uppercase tracking-wider text-[#C8963E] hover:text-[#DDA84B] border border-[#C8963E]/40 hover:border-[#C8963E] rounded-sm transition-all">
                                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                    </svg>
                                    <span>Enter Sanctuary</span>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Book? Book { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<Book> OnDownload { get; set; }

    [Parameter]
    public EventCallback OnRequestSignIn { get; set; }

    private bool IsParchmentMode { get; set; } = false;
    private string FontSize { get; set; } = "M"; // S, M, L
    private bool ShowPdfView { get; set; } = false;

    private List<BookComment> Comments { get; set; } = new();
    private bool isLoadingComments { get; set; } = false;
    private string newCommentText { get; set; } = "";
    private bool isSubmittingComment { get; set; } = false;
    private string commentErrorMessage { get; set; } = "";

    private bool HasPdf => Book?.FileUrl != null && Book.FileUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && Book != null)
        {
            await LoadCommentsAsync();
        }
    }

    private async Task LoadCommentsAsync()
    {
        if (Book == null) return;
        isLoadingComments = true;
        try
        {
            Comments = await ArchiveService.GetCommentsForBookAsync(Book.Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading comments: {ex.Message}");
        }
        finally
        {
            isLoadingComments = false;
        }
    }

    private void ToggleTheme()
    {
        IsParchmentMode = !IsParchmentMode;
    }

    private void SetFontSize(string size)
    {
        FontSize = size;
    }

    private string GetFontSizeClass() => FontSize switch
    {
        "S" => "text-sm",
        "L" => "text-xl",
        _ => "text-base"
    };

    private bool CanDeleteComment(BookComment comment)
    {
        if (!AuthState.IsAuthenticated) return false;
        if (AuthState.IsAuditor) return true;
        return string.Equals(AuthState.CurrentUser?.Username, comment.AuthorName, StringComparison.OrdinalIgnoreCase);
    }

    private async Task SubmitComment()
    {
        if (string.IsNullOrWhiteSpace(newCommentText) || Book == null || !AuthState.IsAuthenticated) return;

        isSubmittingComment = true;
        commentErrorMessage = "";

        try
        {
            var user = AuthState.CurrentUser!;
            var result = await ArchiveService.AddCommentAsync(
                bookId: Book.Id,
                bookTitle: Book.Title,
                authorName: user.Username,
                authorRole: user.Role,
                body: newCommentText.Trim()
            );

            if (result != null)
            {
                newCommentText = "";
                await LoadCommentsAsync();
            }
            else
            {
                commentErrorMessage = "Failed to inscribe margin note into library stone.";
            }
        }
        catch (Exception ex)
        {
            commentErrorMessage = ex.Message;
        }
        finally
        {
            isSubmittingComment = false;
        }
    }

    private async Task SoftDeleteComment(long commentId)
    {
        if (Book == null || !AuthState.IsAuthenticated) return;

        var user = AuthState.CurrentUser!;
        var success = await ArchiveService.SoftDeleteCommentAsync(commentId, Book.Id, Book.Title, user.Username, user.Role);
        if (success)
        {
            await LoadCommentsAsync();
        }
    }

    private async Task TriggerSignIn()
    {
        await OnRequestSignIn.InvokeAsync();
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await Close();
        }
    }
}
