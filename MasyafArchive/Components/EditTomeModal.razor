@using MasyafArchive.Models
@using MasyafArchive.Services
@inject ArchiveService ArchiveService
@inject AuthStateService AuthState

@if (IsOpen && EditingBook != null)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-black/60 flex items-center justify-center p-4 animate-modal-in"
         tabindex="-1" @onkeydown="HandleKeyDown">
        <div class="relative w-full max-w-xl bg-[#FFFDF7] border-2 border-[#1C1917] shadow-[6px_6px_0px_#1C1917] rounded-sm overflow-hidden text-[#1C1917]">
            <div class="flex items-center justify-between px-6 py-4 border-b-2 border-[#1C1917] bg-[#F4C430]">
                <h3 class="font-comic text-xl font-bold">Edit Index Card #@EditingBook.Id.ToString("D4")</h3>
                <button type="button" @onclick="Close" class="ink-btn px-2 py-0.5 text-xs font-mono font-bold bg-[#FFFDF7] rounded-sm">&#x2715;</button>
            </div>

            <form @onsubmit="SaveTome" class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-mono font-bold uppercase mb-1">Book Title</label>
                    <input type="text" @bind="EditingBook.Title" required class="w-full text-base p-2 rounded-sm bg-[#FAF6EC] border-2 border-[#1C1917]" />
                </div>
                <div>
                    <label class="block text-xs font-mono font-bold uppercase mb-1">Author</label>
                    <input type="text" @bind="EditingBook.Author" required class="w-full text-base p-2 rounded-sm bg-[#FAF6EC] border-2 border-[#1C1917]" />
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-mono font-bold uppercase mb-1">Bookshelf / Genre</label>
                        <select @bind="EditingBook.Category" class="w-full text-base p-2 rounded-sm bg-[#FAF6EC] border-2 border-[#1C1917]">
                            @foreach (var genre in BookGenres.Selectable)
                            {
                                <option value="@genre">@genre</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-mono font-bold uppercase mb-1">Year</label>
                        <input type="text" @bind="EditingBook.PublicationYear" class="w-full text-base p-2 rounded-sm bg-[#FAF6EC] border-2 border-[#1C1917]" />
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-mono font-bold uppercase mb-1">Description</label>
                    <textarea @bind="EditingBook.Synopsis" rows="3" class="w-full text-base p-2 rounded-sm bg-[#FAF6EC] border-2 border-[#1C1917]"></textarea>
                </div>
                <div class="flex items-center justify-end gap-3 pt-3 border-t-2 border-dashed border-[#1C1917]/25">
                    <button type="button" @onclick="Close" class="ink-btn px-4 py-1.5 text-xs font-mono font-bold uppercase bg-[#FFFDF7] rounded-sm">Cancel</button>
                    <button type="submit" disabled="@isSaving" class="ink-btn px-5 py-1.5 text-xs font-comic font-bold uppercase bg-[#D93829] text-[#FFFDF7] rounded-sm">
                        @(isSaving ? "Saving..." : "Save Card")
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public Book? Book { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<Book> OnSaved { get; set; }

    private Book? EditingBook;
    private bool isSaving = false;

    protected override void OnParametersSet()
    {
        if (Book != null)
        {
            EditingBook = new Book
            {
                Id = Book.Id,
                Title = Book.Title,
                Author = Book.Author,
                Category = BookGenres.ToLabel(Book.Category) == BookGenres.General ? "Literature" : BookGenres.ToLabel(Book.Category),
                PublicationYear = Book.PublicationYear,
                Synopsis = Book.Synopsis
            };
        }
    }

    private async Task SaveTome()
    {
        if (EditingBook == null || !AuthState.IsAuditor) return;
        isSaving = true;
        try
        {
            var user = AuthState.CurrentUser!;
            if (await ArchiveService.UpdateBookAsync(EditingBook, user.Username, user.Role))
            {
                await OnSaved.InvokeAsync(EditingBook);
                await Close();
            }
        }
        finally { isSaving = false; }
    }

    private async Task Close() { isSaving = false; await OnClose.InvokeAsync(); }
    private async Task HandleKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") await Close(); }
}
