@using MasyafArchive.Models
@using MasyafArchive.Services
@inject ArchiveService ArchiveService
@inject AuthStateService AuthState

@if (IsOpen && EditingBook != null)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 animate-modal-in"
         tabindex="-1"
         @onkeydown="HandleKeyDown">

        <div class="relative w-full max-w-2xl bg-[#181614] border border-[#2E2A25] shadow-2xl rounded-sm overflow-hidden candle-glow">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[#2E2A25] bg-[#0F0E0D]">
                <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-[#C8963E]"></span>
                    <h3 class="font-serif text-xl font-bold text-[#EDE6D6]">
                        Moderate Tome #@EditingBook.Id.ToString("D4")
                    </h3>
                </div>
                <button type="button" @onclick="Close" class="text-[#9E9587] hover:text-[#EDE6D6] p-1">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <!-- Form -->
            <form @onsubmit="SaveTome" class="p-6 space-y-4">
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="p-3 text-xs font-mono bg-[#9E332D]/10 border border-[#9E332D] text-[#EDE6D6]">
                        @errorMessage
                    </div>
                }

                <div>
                    <label class="block text-xs font-mono uppercase text-[#9E9587] mb-1">Title</label>
                    <input type="text" @bind="EditingBook.Title" required disabled="@isSaving"
                           class="w-full text-sm p-2.5 rounded-sm bg-[#0F0E0D] border border-[#2E2A25] text-[#EDE6D6] focus:border-[#C8963E] focus:outline-none" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-mono uppercase text-[#9E9587] mb-1">Author</label>
                        <input type="text" @bind="EditingBook.Author" required disabled="@isSaving"
                               class="w-full text-sm p-2.5 rounded-sm bg-[#0F0E0D] border border-[#2E2A25] text-[#EDE6D6] focus:border-[#C8963E] focus:outline-none" />
                    </div>
                    <div>
                        <label class="block text-xs font-mono uppercase text-[#9E9587] mb-1">Category</label>
                        <select @bind="EditingBook.Category" disabled="@isSaving"
                                class="w-full text-sm p-2.5 rounded-sm bg-[#0F0E0D] border border-[#2E2A25] text-[#EDE6D6] focus:border-[#C8963E] focus:outline-none">
                            <option value="Codex">Codex</option>
                            <option value="Philosophy">Philosophy</option>
                            <option value="Systems">Systems</option>
                            <option value="History">History</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-mono uppercase text-[#9E9587] mb-1">Synopsis</label>
                    <textarea @bind="EditingBook.Synopsis" rows="2" required disabled="@isSaving"
                              class="w-full text-sm p-2.5 rounded-sm bg-[#0F0E0D] border border-[#2E2A25] text-[#EDE6D6] focus:border-[#C8963E] focus:outline-none"></textarea>
                </div>

                <div>
                    <label class="block text-xs font-mono uppercase text-[#9E9587] mb-1">Manuscript Text</label>
                    <textarea @bind="EditingBook.ContentText" rows="6" required disabled="@isSaving"
                              class="w-full text-xs font-mono p-2.5 rounded-sm bg-[#0F0E0D] border border-[#2E2A25] text-[#EDE6D6] focus:border-[#C8963E] focus:outline-none"></textarea>
                </div>

                <div class="flex items-center justify-end gap-3 pt-4 border-t border-[#2E2A25]">
                    <button type="button" @onclick="Close" disabled="@isSaving"
                            class="px-4 py-2 text-xs font-mono uppercase text-[#9E9587] hover:text-[#EDE6D6]">
                        Cancel
                    </button>
                    <button type="submit" disabled="@isSaving"
                            class="px-5 py-2 text-xs font-semibold uppercase tracking-wider bg-[#C8963E] hover:bg-[#DDA84B] disabled:opacity-50 text-[#0F0E0D] rounded-sm transition-all">
                        @(isSaving ? "Updating Ledger..." : "Save Modifications")
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public Book? Book { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<Book> OnSaved { get; set; }

    private Book? EditingBook;
    private bool isSaving = false;
    private string errorMessage = "";

    protected override void OnParametersSet()
    {
        if (Book != null)
        {
            EditingBook = new Book
            {
                Id = Book.Id,
                Title = Book.Title,
                Author = Book.Author,
                Category = Book.Category,
                Synopsis = Book.Synopsis,
                ContentText = Book.ContentText,
                FileUrl = Book.FileUrl,
                UploadedBy = Book.UploadedBy,
                DownloadCount = Book.DownloadCount,
                DeletedAt = Book.DeletedAt,
                CreatedAt = Book.CreatedAt
            };
        }
    }

    private async Task SaveTome()
    {
        if (EditingBook == null || !AuthState.IsAuditor) return;

        isSaving = true;
        errorMessage = "";

        try
        {
            var user = AuthState.CurrentUser!;
            var ok = await ArchiveService.UpdateBookAsync(EditingBook, user.Username, user.Role);
            if (ok)
            {
                await OnSaved.InvokeAsync(EditingBook);
                await Close();
            }
            else
            {
                errorMessage = "Failed to update tome metadata in the database.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task Close()
    {
        isSaving = false;
        errorMessage = "";
        await OnClose.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await Close();
        }
    }
}
