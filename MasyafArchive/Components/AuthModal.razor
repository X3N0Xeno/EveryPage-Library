@using MasyafArchive.Models
@using MasyafArchive.Services
@inject AuthStateService AuthState

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 animate-modal-in"
         tabindex="-1"
         @onkeydown="HandleKeyDown">

        <div class="relative w-full max-w-md bg-[#181614] border border-[#2E2A25] shadow-2xl rounded-sm overflow-hidden candle-glow">
            <div class="px-6 pt-6 pb-4 border-b border-[#2E2A25] bg-[#0F0E0D] text-center relative">
                <button type="button"
                        @onclick="Close"
                        class="absolute top-4 right-4 text-[#9E9587] hover:text-[#EDE6D6] p-1 rounded-sm transition-colors">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>

                <div class="w-12 h-12 mx-auto mb-3 rounded-full border border-[#C8963E]/40 flex items-center justify-center text-[#C8963E] bg-[#181614]">
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"></path>
                        <path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"></path>
                    </svg>
                </div>

                <h3 class="font-serif text-2xl font-bold text-[#EDE6D6] tracking-wide">
                    @(isRegisterMode ? "Create Library Account" : "Sign In to EveryPage")
                </h3>
                <p class="text-xs font-mono text-[#9E9587] mt-1">
                    Upload PDF editions and post reader notes
                </p>

                <div class="flex border-t border-[#2E2A25] mt-4 pt-2 -mx-6 px-6 bg-[#141210]">
                    <button type="button"
                            @onclick="() => isRegisterMode = false"
                            class="flex-1 py-2 text-xs font-mono uppercase tracking-wider transition-colors border-b-2 @(!isRegisterMode ? "border-[#C8963E] text-[#C8963E] font-bold" : "border-transparent text-[#9E9587] hover:text-[#EDE6D6]")">
                        Sign In
                    </button>
                    <button type="button"
                            @onclick="() => isRegisterMode = true"
                            class="flex-1 py-2 text-xs font-mono uppercase tracking-wider transition-colors border-b-2 @(isRegisterMode ? "border-[#C8963E] text-[#C8963E] font-bold" : "border-transparent text-[#9E9587] hover:text-[#EDE6D6]")">
                        Create Account
                    </button>
                </div>
            </div>

            <div class="p-6 space-y-4">
                @if (!string.IsNullOrWhiteSpace(statusMessage))
                {
                    <div class="p-3 rounded-sm border text-xs font-mono @(isSuccess ? "border-[#C8963E] bg-[#C8963E]/10 text-[#EDE6D6]" : "border-[#9E332D] bg-[#9E332D]/10 text-[#EDE6D6]")">
                        @statusMessage
                    </div>
                }

                <div class="p-3 rounded-sm border border-[#2E2A25] bg-[#0F0E0D]">
                    <span class="block text-[10px] font-mono uppercase tracking-widest text-[#9E9587] mb-2">
                        Quick Demo Credentials:
                    </span>
                    <div class="flex items-center gap-2">
                        <button type="button"
                                @onclick='() => DemoFill("Altair", "masyaf1191")'
                                class="flex-1 px-2.5 py-1.5 text-[11px] font-mono border border-[#C8963E]/40 hover:border-[#C8963E] text-[#C8963E] bg-[#181614] rounded-sm transition-all hover:bg-[#201E1A] text-left">
                            <span class="font-bold block">Auditor (Altair)</span>
                            <span class="text-[9px] text-[#9E9587]">Moderator &bull; masyaf1191</span>
                        </button>
                        <button type="button"
                                @onclick='() => DemoFill("Niccolo", "venice1257")'
                                class="flex-1 px-2.5 py-1.5 text-[11px] font-mono border border-[#2E2A25] hover:border-[#8C6D3F] text-[#EDE6D6] bg-[#181614] rounded-sm transition-all hover:bg-[#201E1A] text-left">
                            <span class="font-bold block">Contributor (Niccolo)</span>
                            <span class="text-[9px] text-[#9E9587]">Uploader &bull; venice1257</span>
                        </button>
                    </div>
                </div>

                <form @onsubmit="HandleSubmit" class="space-y-4">
                    <div>
                        <label class="block text-xs font-mono uppercase tracking-wider text-[#9E9587] mb-1">
                            Username
                        </label>
                        <input type="text"
                               @bind="username"
                               placeholder="Enter username"
                               required
                               disabled="@isLoading"
                               class="w-full text-sm p-2.5 rounded-sm bg-[#0F0E0D] border border-[#2E2A25] text-[#EDE6D6] focus:border-[#C8963E] focus:outline-none transition-colors" />
                    </div>

                    <div>
                        <label class="block text-xs font-mono uppercase tracking-wider text-[#9E9587] mb-1">
                            Password
                        </label>
                        <input type="password"
                               @bind="passcode"
                               placeholder="Enter password"
                               required
                               disabled="@isLoading"
                               class="w-full text-sm p-2.5 rounded-sm bg-[#0F0E0D] border border-[#2E2A25] text-[#EDE6D6] focus:border-[#C8963E] focus:outline-none transition-colors" />
                    </div>

                    <div class="pt-2">
                        <button type="submit"
                                disabled="@isLoading"
                                class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 text-xs font-semibold uppercase tracking-wider bg-[#C8963E] hover:bg-[#DDA84B] disabled:opacity-50 text-[#0F0E0D] rounded-sm transition-all shadow-md">
                            @if (isLoading)
                            {
                                <div class="w-3.5 h-3.5 border-2 border-[#0F0E0D] border-t-transparent rounded-full animate-spin"></div>
                                <span>@(isRegisterMode ? "Creating Account..." : "Signing In...")</span>
                            }
                            else
                            {
                                <span>@(isRegisterMode ? "Create Account" : "Sign In")</span>
                            }
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnAuthenticated { get; set; }

    private bool isRegisterMode = false;
    private string username = "";
    private string passcode = "";
    private bool isLoading = false;
    private string statusMessage = "";
    private bool isSuccess = false;

    private void DemoFill(string u, string p)
    {
        username = u;
        passcode = p;
        isRegisterMode = false;
        statusMessage = $"Filled credentials for {u}. Click Sign In to continue.";
        isSuccess = true;
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(passcode))
        {
            statusMessage = "Both username and password are required.";
            isSuccess = false;
            return;
        }

        isLoading = true;
        statusMessage = "";

        try
        {
            var (success, msg) = isRegisterMode
                ? await AuthState.RegisterAsync(username, passcode)
                : await AuthState.SignInAsync(username, passcode);

            statusMessage = msg;
            isSuccess = success;

            if (success)
            {
                await Task.Delay(300);
                await OnAuthenticated.InvokeAsync();
                await Close();
            }
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Close()
    {
        statusMessage = "";
        username = "";
        passcode = "";
        isLoading = false;
        await OnClose.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await Close();
    }
}
