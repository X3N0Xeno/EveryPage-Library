@using EveryPageLibrary.Models
@using EveryPageLibrary.Services
@inject AuthStateService AuthState

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-[#1C1917]/60 flex items-center justify-center p-4 animate-modal-in"
         tabindex="-1" role="dialog" aria-modal="true" @onkeydown="HandleKeyDown">
        <div class="relative w-full max-w-md bg-[#FFFDF7] border-2 border-[#1C1917] shadow-[6px_6px_0px_#1C1917] rounded-sm overflow-hidden text-[#1C1917]">

            <!-- Library card header -->
            <div class="relative px-6 pt-6 pb-5 text-center">
                <button type="button" @onclick="Close" aria-label="Close"
                        class="absolute top-3.5 right-3.5 ink-btn inline-flex items-center justify-center w-7 h-7 bg-[#FFFDF7] hover:bg-[#D93829] hover:text-[#FFFDF7] rounded-sm">
                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                    </svg>
                </button>
                <svg class="w-14 h-11 mx-auto mb-3" viewBox="0 0 56 44" fill="none" aria-hidden="true">
                    <rect x="2" y="2" width="52" height="40" rx="2" fill="#F2EAD8" stroke="#1C1917" stroke-width="2.5"/>
                    <rect x="2" y="2" width="52" height="9" fill="#D93829" stroke="#1C1917" stroke-width="2.5"/>
                    <line x1="9" y1="20" x2="34" y2="20" stroke="#1C1917" stroke-width="2"/>
                    <line x1="9" y1="27" x2="30" y2="27" stroke="#1C1917" stroke-width="2"/>
                    <line x1="9" y1="34" x2="26" y2="34" stroke="#1C1917" stroke-width="2"/>
                    <circle cx="44" cy="29" r="6.5" fill="#F4C430" stroke="#1C1917" stroke-width="2"/>
                </svg>
                <h3 class="font-comic text-2xl font-bold">@(isRegisterMode ? "New Library Card" : "Library Card Sign In")</h3>
                <p class="text-xs font-mono text-[#57534E] mt-1">Sign in to upload PDFs &amp; write margin notes</p>
            </div>
            <div class="zigzag-band" aria-hidden="true"></div>

            <!-- Tabs -->
            <div class="flex border-b-2 border-[#1C1917] bg-[#F2EAD8]" role="tablist">
                <button type="button" role="tab" aria-selected="@(!isRegisterMode ? "true" : "false")" @onclick="() => isRegisterMode = false"
                        class="flex-1 py-2.5 text-xs font-mono font-bold uppercase tracking-wider transition-colors @(!isRegisterMode ? "bg-[#FFFDF7] text-[#D93829]" : "text-[#57534E] hover:text-[#1C1917]")">
                    Sign In
                </button>
                <button type="button" role="tab" aria-selected="@(isRegisterMode ? "true" : "false")" @onclick="() => isRegisterMode = true"
                        class="flex-1 py-2.5 text-xs font-mono font-bold uppercase tracking-wider border-l-2 border-[#1C1917] transition-colors @(isRegisterMode ? "bg-[#FFFDF7] text-[#D93829]" : "text-[#57534E] hover:text-[#1C1917]")">
                    Create Card
                </button>
            </div>

            <div class="p-6 space-y-4">
                @if (!string.IsNullOrWhiteSpace(statusMessage))
                {
                    <div role="status" class="p-3 rounded-sm border-2 border-[#1C1917] text-xs font-mono font-bold @(isSuccess ? "bg-[#F4C430]/40" : "bg-[#D93829] text-[#FFFDF7]")">
                        @statusMessage
                    </div>
                }

                <div class="p-3 rounded-sm border-2 border-dashed border-[#1C1917]/40 bg-[#FAF6EC]">
                    <span class="block text-[11px] font-mono font-bold uppercase tracking-wider text-[#57534E] mb-2">Quick Demo Cards</span>
                    <div class="flex items-stretch gap-2">
                        <button type="button" @onclick='() => DemoFill("Altair", "masyaf1191")'
                                class="ink-btn flex-1 px-2.5 py-1.5 text-xs font-mono bg-[#FFFDF7] hover:bg-[#F4C430]/40 text-left rounded-sm">
                            <span class="font-bold block text-[#D93829]">Auditor (Altair)</span>
                            <span class="text-[10px] text-[#57534E]">masyaf1191</span>
                        </button>
                        <button type="button" @onclick='() => DemoFill("Niccolo", "venice1257")'
                                class="ink-btn flex-1 px-2.5 py-1.5 text-xs font-mono bg-[#FFFDF7] hover:bg-[#F4C430]/40 text-left rounded-sm">
                            <span class="font-bold block">Contributor (Niccolo)</span>
                            <span class="text-[10px] text-[#57534E]">venice1257</span>
                        </button>
                    </div>
                </div>

                <form @onsubmit="HandleSubmit" class="space-y-4">
                    <div>
                        <label class="block text-[11px] font-mono font-bold uppercase tracking-wider mb-1">Username</label>
                        <input type="text" @bind="username" required disabled="@isLoading" autocomplete="username"
                               class="ink-field w-full text-base p-2.5 rounded-sm" />
                    </div>
                    <div>
                        <label class="block text-[11px] font-mono font-bold uppercase tracking-wider mb-1">Password</label>
                        <input type="password" @bind="passcode" required disabled="@isLoading" autocomplete="current-password"
                               class="ink-field w-full text-base p-2.5 rounded-sm" />
                    </div>
                    <button type="submit" disabled="@isLoading"
                            class="ink-btn w-full py-2.5 px-4 text-sm font-comic font-bold uppercase bg-[#D93829] hover:bg-[#c22e20] text-[#FFFDF7] rounded-sm">
                        @(isLoading ? "Checking card..." : (isRegisterMode ? "Issue Library Card" : "Sign In"))
                    </button>
                </form>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnAuthenticated { get; set; }

    private bool isRegisterMode = false;
    private string username = "";
    private string passcode = "";
    private bool isLoading = false;
    private string statusMessage = "";
    private bool isSuccess = false;

    private void DemoFill(string u, string p) { username = u; passcode = p; isRegisterMode = false; statusMessage = $"Filled {u}. Click Sign In!"; isSuccess = true; }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(passcode)) { statusMessage = "Username and password required."; isSuccess = false; return; }
        isLoading = true; statusMessage = "";
        try
        {
            var (success, msg) = isRegisterMode ? await AuthState.RegisterAsync(username, passcode) : await AuthState.SignInAsync(username, passcode);
            statusMessage = msg; isSuccess = success;
            if (success) { await Task.Delay(250); await OnAuthenticated.InvokeAsync(); await Close(); }
        }
        catch (Exception ex) { statusMessage = ex.Message; isSuccess = false; }
        finally { isLoading = false; }
    }

    private async Task Close() { statusMessage = ""; username = ""; passcode = ""; isLoading = false; await OnClose.InvokeAsync(); }
    private async Task HandleKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") await Close(); }
}