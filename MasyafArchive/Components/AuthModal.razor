@using EverydayLibrary.Models
@using EverydayLibrary.Services
@inject AuthStateService AuthState

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-black/60 flex items-center justify-center p-4 animate-modal-in"
         tabindex="-1" @onkeydown="HandleKeyDown">
        <div class="relative w-full max-w-md bg-[#FFFDF7] border-2 border-[#1C1917] shadow-[6px_6px_0px_#1C1917] rounded-sm overflow-hidden text-[#1C1917]">
            <div class="px-6 pt-5 pb-4 border-b-2 border-[#1C1917] bg-[#F4C430] text-center relative">
                <button type="button" @onclick="Close" class="absolute top-3.5 right-3.5 ink-btn px-2 py-0.5 text-xs font-mono font-bold bg-[#FFFDF7] rounded-sm">&#x2715;</button>
                <h3 class="font-comic text-2xl font-bold">@(isRegisterMode ? "New Library Card" : "Library Card Sign In")</h3>
                <p class="text-xs font-mono mt-1">Sign in to upload PDFs &amp; write margin notes</p>
            </div>

            <div class="flex border-b-2 border-[#1C1917] bg-[#FAF6EC]">
                <button type="button" @onclick="() => isRegisterMode = false"
                        class="flex-1 py-2 text-xs font-mono font-bold uppercase @(!isRegisterMode ? "bg-[#FFFDF7] text-[#D93829]" : "text-[#57534E]")">
                    Sign In
                </button>
                <button type="button" @onclick="() => isRegisterMode = true"
                        class="flex-1 py-2 text-xs font-mono font-bold uppercase border-l-2 border-[#1C1917] @(isRegisterMode ? "bg-[#FFFDF7] text-[#D93829]" : "text-[#57534E]")">
                    Create Card
                </button>
            </div>

            <div class="p-6 space-y-4">
                @if (!string.IsNullOrWhiteSpace(statusMessage))
                {
                    <div class="p-3 rounded-sm border-2 border-[#1C1917] text-xs font-mono font-bold @(isSuccess ? "bg-[#F4C430]/40" : "bg-[#D93829] text-[#FFFDF7]")">
                        @statusMessage
                    </div>
                }

                <div class="p-3 rounded-sm border-2 border-dashed border-[#1C1917]/40 bg-[#FAF6EC]">
                    <span class="block text-[11px] font-mono font-bold uppercase text-[#57534E] mb-2">Quick Demo Cards:</span>
                    <div class="flex items-center gap-2">
                        <button type="button" @onclick='() => DemoFill("Altair", "masyaf1191")'
                                class="ink-btn flex-1 px-2.5 py-1.5 text-xs font-mono bg-[#FFFDF7] text-left rounded-sm">
                            <span class="font-bold block text-[#D93829]">Auditor (Altair)</span>
                            <span class="text-[10px] text-[#57534E]">masyaf1191</span>
                        </button>
                        <button type="button" @onclick='() => DemoFill("Niccolo", "venice1257")'
                                class="ink-btn flex-1 px-2.5 py-1.5 text-xs font-mono bg-[#FFFDF7] text-left rounded-sm">
                            <span class="font-bold block">Contributor (Niccolo)</span>
                            <span class="text-[10px] text-[#57534E]">venice1257</span>
                        </button>
                    </div>
                </div>

                <form @onsubmit="HandleSubmit" class="space-y-4">
                    <div>
                        <label class="block text-xs font-mono font-bold uppercase mb-1">Username</label>
                        <input type="text" @bind="username" required disabled="@isLoading"
                               class="w-full text-base p-2.5 rounded-sm bg-[#FAF6EC] border-2 border-[#1C1917] focus:outline-none" />
                    </div>
                    <div>
                        <label class="block text-xs font-mono font-bold uppercase mb-1">Password</label>
                        <input type="password" @bind="passcode" required disabled="@isLoading"
                               class="w-full text-base p-2.5 rounded-sm bg-[#FAF6EC] border-2 border-[#1C1917] focus:outline-none" />
                    </div>
                    <button type="submit" disabled="@isLoading"
                            class="ink-btn w-full py-2.5 px-4 text-sm font-comic font-bold uppercase bg-[#D93829] text-[#FFFDF7] rounded-sm">
                        @(isLoading ? "Checking card..." : (isRegisterMode ? "Issue Library Card" : "Sign In"))
                    </button>
                </form>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnAuthenticated { get; set; }

    private bool isRegisterMode = false;
    private string username = "";
    private string passcode = "";
    private bool isLoading = false;
    private string statusMessage = "";
    private bool isSuccess = false;

    private void DemoFill(string u, string p) { username = u; passcode = p; isRegisterMode = false; statusMessage = $"Filled {u}. Click Sign In!"; isSuccess = true; }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(passcode)) { statusMessage = "Username and password required."; isSuccess = false; return; }
        isLoading = true; statusMessage = "";
        try
        {
            var (success, msg) = isRegisterMode ? await AuthState.RegisterAsync(username, passcode) : await AuthState.SignInAsync(username, passcode);
            statusMessage = msg; isSuccess = success;
            if (success) { await Task.Delay(250); await OnAuthenticated.InvokeAsync(); await Close(); }
        }
        catch (Exception ex) { statusMessage = ex.Message; isSuccess = false; }
        finally { isLoading = false; }
    }

    private async Task Close() { statusMessage = ""; username = ""; passcode = ""; isLoading = false; await OnClose.InvokeAsync(); }
    private async Task HandleKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") await Close(); }
}
