@using MasyafArchive.Models
@using MasyafArchive.Services
@inject ArchiveService ArchiveService
@inject AuthStateService AuthState

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex justify-end bg-black/75 backdrop-blur-sm">
        <div class="relative w-full max-w-xl bg-[#141210] border-l border-[#2E2924] h-full flex flex-col shadow-2xl">
            <!-- Header -->
            <div class="px-6 py-5 border-b border-[#2E2924] flex items-center justify-between bg-[#181614]">
                <div>
                    <p class="text-[11px] font-mono uppercase tracking-[0.2em] text-[#C8963E]">Community Shelf</p>
                    <h2 class="font-serif text-2xl font-semibold text-[#EDE6D6] mt-0.5">Upload PDF Book</h2>
                </div>
                <button type="button"
                        @onclick="Close"
                        disabled="@isSaving"
                        class="p-2 text-[#9E9587] hover:text-[#EDE6D6] transition-colors rounded-sm">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <!-- Form Body -->
            <form @onsubmit="HandleSubmit" class="flex-1 overflow-y-auto p-6 space-y-5">
                <p class="text-xs text-[#9E9587] leading-relaxed">
                    Contribute original works or hard-to-find editions to the EveryPage Library. Uploads are restricted to PDF documents to preserve original page layout and typography.
                </p>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="p-3.5 bg-red-950/60 border border-red-800/70 rounded-sm text-xs text-red-200">
                        @errorMessage
                    </div>
                }

                <!-- PDF File Picker (Required) -->
                <div>
                    <label class="block text-xs font-mono uppercase tracking-wider text-[#EDE6D6] mb-1.5">
                        PDF Document <span class="text-[#C8963E]">*</span>
                    </label>
                    <label class="flex flex-col items-center justify-center w-full px-4 py-5 border border-dashed border-[#3A332C] hover:border-[#C8963E] bg-[#181614] rounded-sm cursor-pointer transition-colors">
                        <svg class="w-6 h-6 text-[#C8963E] mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <path d="M12 18v-6"></path>
                            <path d="m9 15 3-3 3 3"></path>
                        </svg>
                        @if (!string.IsNullOrWhiteSpace(pdfFileName))
                        {
                            <span class="text-xs font-medium text-[#EDE6D6] text-center break-all">@pdfFileName</span>
                            <span class="text-[11px] font-mono text-[#C8963E] mt-1">@FormatSize(pdfBytes?.Length ?? 0) — Ready</span>
                        }
                        else
                        {
                            <span class="text-xs text-[#EDE6D6]">Select a .pdf file from your device</span>
                            <span class="text-[11px] font-mono text-[#9E9587] mt-1">PDF only, up to 25 MB</span>
                        }
                        <InputFile OnChange="HandlePdfSelected" accept=".pdf,application/pdf" class="hidden" />
                    </label>
                </div>

                <!-- Title -->
                <div>
                    <label class="block text-xs font-mono uppercase tracking-wider text-[#EDE6D6] mb-1.5">
                        Book Title <span class="text-[#C8963E]">*</span>
                    </label>
                    <input type="text"
                           @bind="newBook.Title"
                           required
                           placeholder="e.g., Meditations"
                           class="w-full px-3.5 py-2.5 bg-[#181614] border border-[#2E2924] focus:border-[#C8963E] focus:outline-none rounded-sm text-sm text-[#EDE6D6] placeholder-[#6E675F]" />
                </div>

                <!-- Author -->
                <div>
                    <label class="block text-xs font-mono uppercase tracking-wider text-[#EDE6D6] mb-1.5">
                        Author <span class="text-[#C8963E]">*</span>
                    </label>
                    <input type="text"
                           @bind="newBook.Author"
                           required
                           placeholder="e.g., Marcus Aurelius"
                           class="w-full px-3.5 py-2.5 bg-[#181614] border border-[#2E2924] focus:border-[#C8963E] focus:outline-none rounded-sm text-sm text-[#EDE6D6] placeholder-[#6E675F]" />
                </div>

                <!-- Genre & Publication Year -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-mono uppercase tracking-wider text-[#EDE6D6] mb-1.5">
                            Genre
                        </label>
                        <select @bind="newBook.Category"
                                class="w-full px-3.5 py-2.5 bg-[#181614] border border-[#2E2924] focus:border-[#C8963E] focus:outline-none rounded-sm text-sm text-[#EDE6D6]">
                            <option value="Literature">Literature</option>
                            <option value="Philosophy">Philosophy</option>
                            <option value="History">History</option>
                            <option value="Science">Science</option>
                            <option value="Fiction">Fiction</option>
                            <option value="Technology">Technology</option>
                            <option value="Biography">Biography</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-mono uppercase tracking-wider text-[#EDE6D6] mb-1.5">
                            Year or Era
                        </label>
                        <input type="text"
                               @bind="newBook.PublicationYear"
                               placeholder="e.g., 180 CE or 2026"
                               class="w-full px-3.5 py-2.5 bg-[#181614] border border-[#2E2924] focus:border-[#C8963E] focus:outline-none rounded-sm text-sm text-[#EDE6D6] placeholder-[#6E675F]" />
                    </div>
                </div>

                <!-- Description / Synopsis -->
                <div>
                    <label class="block text-xs font-mono uppercase tracking-wider text-[#EDE6D6] mb-1.5">
                        Description
                    </label>
                    <textarea @bind="newBook.Synopsis"
                              rows="3"
                              placeholder="Brief summary, edition notes, or historical context..."
                              class="w-full px-3.5 py-2.5 bg-[#181614] border border-[#2E2924] focus:border-[#C8963E] focus:outline-none rounded-sm text-sm text-[#EDE6D6] placeholder-[#6E675F] resize-none"></textarea>
                </div>

                <!-- Optional Cover Image -->
                <div>
                    <label class="block text-xs font-mono uppercase tracking-wider text-[#EDE6D6] mb-1.5">
                        Cover Image <span class="text-[#9E9587] normal-case">(Optional)</span>
                    </label>
                    <label class="flex items-center justify-between w-full px-3.5 py-2.5 bg-[#181614] border border-[#2E2924] hover:border-[#C8963E] rounded-sm cursor-pointer transition-colors">
                        <span class="text-xs text-[#9E9587] truncate">
                            @(string.IsNullOrWhiteSpace(coverFileName) ? "Choose JPG, PNG, or WebP cover art..." : coverFileName)
                        </span>
                        <span class="text-[11px] font-mono uppercase text-[#C8963E] ml-3 shrink-0">Browse</span>
                        <InputFile OnChange="HandleCoverSelected" accept="image/png,image/jpeg,image/webp" class="hidden" />
                    </label>
                </div>

                <!-- Footer Actions -->
                <div class="pt-4 border-t border-[#2E2924] flex items-center justify-end gap-3">
                    <button type="button"
                            @onclick="Close"
                            disabled="@isSaving"
                            class="px-4 py-2 text-xs font-mono uppercase tracking-wider text-[#9E9587] hover:text-[#EDE6D6] transition-colors">
                        Cancel
                    </button>

                    <button type="submit"
                            disabled="@isSaving"
                            class="inline-flex items-center gap-2 px-6 py-2.5 text-xs font-semibold uppercase tracking-wider bg-[#C8963E] hover:bg-[#DDA84B] disabled:opacity-50 disabled:cursor-not-allowed text-[#0F0E0D] rounded-sm transition-all shadow-md">
                        @if (isSaving)
                        {
                            <div class="w-3.5 h-3.5 border-2 border-[#0F0E0D] border-t-transparent rounded-full animate-spin"></div>
                            <span>Publishing...</span>
                        }
                        else
                        {
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                                <polyline points="7 3 7 8 15 8"></polyline>
                            </svg>
                            <span>Publish Book</span>
                        }
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<Book> OnTomeInscribed { get; set; }

    private Book newBook = new()
    {
        Category = "Literature",
        SourceName = "Community PDF"
    };

    private bool isSaving = false;
    private string errorMessage = "";
    private byte[]? pdfBytes;
    private string? pdfFileName;
    private byte[]? coverBytes;
    private string? coverFileName;

    private void ResetForm()
    {
        newBook = new Book
        {
            Category = "Literature",
            SourceName = "Community PDF"
        };
        pdfBytes = null;
        pdfFileName = null;
        coverBytes = null;
        coverFileName = null;
        errorMessage = "";
        isSaving = false;
    }

    private async Task HandlePdfSelected(InputFileChangeEventArgs e)
    {
        errorMessage = "";
        try
        {
            var file = e.File;
            if (file == null) return;

            if (!file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                pdfBytes = null;
                pdfFileName = null;
                errorMessage = "Only .pdf files are accepted for community book uploads.";
                return;
            }

            pdfFileName = file.Name;
            using var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            pdfBytes = ms.ToArray();
        }
        catch (Exception ex)
        {
            pdfBytes = null;
            pdfFileName = null;
            errorMessage = $"Error reading PDF: {ex.Message}";
        }
    }

    private async Task HandleCoverSelected(InputFileChangeEventArgs e)
    {
        errorMessage = "";
        try
        {
            var file = e.File;
            if (file == null) return;

            coverFileName = file.Name;
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            coverBytes = ms.ToArray();
        }
        catch (Exception ex)
        {
            coverBytes = null;
            coverFileName = null;
            errorMessage = $"Error reading cover image: {ex.Message}";
        }
    }

    private async Task HandleSubmit()
    {
        if (!AuthState.IsAuthenticated)
        {
            errorMessage = "Please sign in to upload books.";
            return;
        }

        if (pdfBytes == null || pdfBytes.Length == 0 || string.IsNullOrWhiteSpace(pdfFileName))
        {
            errorMessage = "Please select a PDF file to upload.";
            return;
        }

        if (!pdfFileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "Only .pdf files are allowed.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newBook.Title) || string.IsNullOrWhiteSpace(newBook.Author))
        {
            errorMessage = "Title and Author are required.";
            return;
        }

        isSaving = true;
        errorMessage = "";

        try
        {
            var actor = AuthState.CurrentUser!;
            newBook.UploadedBy = actor.Username;
            newBook.SourceName = "Community PDF";

            var created = await ArchiveService.UploadPdfBookAsync(
                book: newBook,
                pdfBytes: pdfBytes,
                pdfFileName: pdfFileName,
                coverBytes: coverBytes,
                coverFileName: coverFileName,
                actorName: actor.Username,
                actorRole: actor.Role
            );

            if (created != null)
            {
                await OnTomeInscribed.InvokeAsync(created);
                ResetForm();
                await Close();
            }
            else
            {
                errorMessage = "Failed to publish book. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task Close()
    {
        if (!isSaving)
        {
            await OnClose.InvokeAsync();
        }
    }

    private static string FormatSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
            return $"{bytes / (1024.0 * 1024.0):0.0} MB";
        return $"{Math.Max(1, bytes / 1024)} KB";
    }
}
