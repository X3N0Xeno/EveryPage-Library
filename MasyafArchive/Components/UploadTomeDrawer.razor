@using MasyafArchive.Models
@using MasyafArchive.Services
@inject ArchiveService ArchiveService
@inject AuthStateService AuthState

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 overflow-hidden bg-black/75 backdrop-blur-sm flex justify-end animate-modal-in"
         tabindex="-1"
         @onkeydown="HandleKeyDown">

        <!-- Slide-over Drawer -->
        <div class="w-full max-w-xl h-full bg-[#181614] border-l border-[#2E2A25] shadow-2xl flex flex-col animate-drawer-in">
            
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-5 border-b border-[#2E2A25] bg-[#0F0E0D]">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-sm bg-[#C8963E]/10 border border-[#C8963E]/40 flex items-center justify-center text-[#C8963E]">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 20h9"></path>
                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                        </svg>
                    </div>
                    <div>
                        <h2 class="font-serif text-xl font-bold text-[#EDE6D6] tracking-wide">
                            Inscribe Tome
                        </h2>
                        <p class="text-xs font-mono text-[#9E9587]">
                            Inscribing as <span class="text-[#C8963E]">@AuthState.CurrentUser?.Username</span> (@AuthState.CurrentUser?.Role)
                        </p>
                    </div>
                </div>

                <button type="button"
                        @onclick="Close"
                        class="p-1 text-[#9E9587] hover:text-[#EDE6D6] rounded-sm transition-colors">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <!-- Form Content (Scrollable) -->
            <form @onsubmit="HandleSubmit" class="flex-1 overflow-y-auto p-6 space-y-5">
                
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="p-3 rounded-sm border border-[#9E332D] bg-[#9E332D]/10 text-xs text-[#EDE6D6] font-mono">
                        @errorMessage
                    </div>
                }

                <!-- Tome Title -->
                <div>
                    <label class="block text-xs font-mono uppercase tracking-wider text-[#9E9587] mb-1.5">
                        Tome Title <span class="text-[#C8963E]">*</span>
                    </label>
                    <input type="text"
                           @bind="newBook.Title"
                           placeholder="e.g. Codex Altaïr: On the Hidden Blade"
                           required
                           disabled="@isSaving"
                           class="w-full text-sm p-3 rounded-sm bg-[#0F0E0D] border border-[#2E2A25] text-[#EDE6D6] focus:border-[#C8963E] focus:outline-none transition-colors" />
                </div>

                <!-- Author & Category Row -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-mono uppercase tracking-wider text-[#9E9587] mb-1.5">
                            Author / Master Scribe <span class="text-[#C8963E]">*</span>
                        </label>
                        <input type="text"
                               @bind="newBook.Author"
                               placeholder="e.g. Altaïr Ibn-La'Ahad"
                               required
                               disabled="@isSaving"
                               class="w-full text-sm p-3 rounded-sm bg-[#0F0E0D] border border-[#2E2A25] text-[#EDE6D6] focus:border-[#C8963E] focus:outline-none transition-colors" />
                    </div>

                    <div>
                        <label class="block text-xs font-mono uppercase tracking-wider text-[#9E9587] mb-1.5">
                            Category Alcove <span class="text-[#C8963E]">*</span>
                        </label>
                        <select @bind="newBook.Category"
                                disabled="@isSaving"
                                class="w-full text-sm p-3 rounded-sm bg-[#0F0E0D] border border-[#2E2A25] text-[#EDE6D6] focus:border-[#C8963E] focus:outline-none transition-colors cursor-pointer">
                            <option value="Codex">Codex</option>
                            <option value="Philosophy">Philosophy</option>
                            <option value="Systems">Systems</option>
                            <option value="History">History</option>
                        </select>
                    </div>
                </div>

                <!-- Synopsis -->
                <div>
                    <label class="block text-xs font-mono uppercase tracking-wider text-[#9E9587] mb-1.5">
                        Synopsis <span class="text-[#C8963E]">*</span>
                    </label>
                    <textarea @bind="newBook.Synopsis"
                              rows="2"
                              placeholder="A concise summary of the knowledge preserved within this parchment..."
                              required
                              disabled="@isSaving"
                              class="w-full text-sm p-3 rounded-sm bg-[#0F0E0D] border border-[#2E2A25] text-[#EDE6D6] focus:border-[#C8963E] focus:outline-none transition-colors"></textarea>
                </div>

                <!-- Manuscript Content Text -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-xs font-mono uppercase tracking-wider text-[#9E9587]">
                            Manuscript Content (Parchment Text) <span class="text-[#C8963E]">*</span>
                        </label>
                        <span class="text-[10px] font-mono text-[#9E9587]">Use CHAPTER I, SECTION 1, etc.</span>
                    </div>
                    <textarea @bind="newBook.ContentText"
                              rows="8"
                              placeholder="CHAPTER I: PRESERVATION&#10;&#10;Inscribe the full manuscript text here..."
                              required
                              disabled="@isSaving"
                              class="w-full text-xs font-mono p-3 rounded-sm bg-[#0F0E0D] border border-[#2E2A25] text-[#EDE6D6] focus:border-[#C8963E] focus:outline-none transition-colors leading-relaxed"></textarea>
                </div>

                <!-- Optional File Upload or PDF URL -->
                <div class="p-4 rounded-sm border border-[#2E2A25] bg-[#0F0E0D] space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-mono uppercase tracking-wider text-[#C8963E]">
                            Archival Attachment (Optional)
                        </span>
                        <span class="text-[10px] font-mono text-[#9E9587]">PDF, TXT, or MD</span>
                    </div>

                    <!-- File input -->
                    <div>
                        <label class="block text-xs text-[#9E9587] mb-1">Upload to Vault Storage (Public bucket "tomes"):</label>
                        <InputFile OnChange="HandleFileSelected"
                                   disabled="@isSaving"
                                   class="text-xs text-[#9E9587] file:mr-3 file:py-1.5 file:px-3 file:rounded-sm file:border-0 file:text-xs file:font-semibold file:bg-[#201E1A] file:text-[#C8963E] hover:file:bg-[#2E2A25] file:cursor-pointer" />
                        @if (!string.IsNullOrWhiteSpace(uploadedFileName))
                        {
                            <p class="text-xs font-mono text-[#C8963E] mt-1">
                                Selected: @uploadedFileName (@(uploadedFileBytes?.Length ?? 0) bytes)
                            </p>
                        }
                    </div>

                    <!-- Or External URL -->
                    <div class="pt-2 border-t border-[#2E2A25]">
                        <label class="block text-xs text-[#9E9587] mb-1">Or external document URL:</label>
                        <input type="url"
                               @bind="newBook.FileUrl"
                               placeholder="https://.../manuscript.pdf"
                               disabled="@isSaving"
                               class="w-full text-xs p-2 rounded-sm bg-[#181614] border border-[#2E2A25] text-[#EDE6D6] focus:border-[#C8963E] focus:outline-none" />
                    </div>
                </div>

                <!-- Action Buttons: Disabled when isSaving == true -->
                <div class="pt-4 border-t border-[#2E2A25] flex items-center justify-end gap-3">
                    <button type="button"
                            @onclick="Close"
                            disabled="@isSaving"
                            class="px-4 py-2 text-xs font-mono uppercase tracking-wider text-[#9E9587] hover:text-[#EDE6D6] transition-colors">
                        Cancel
                    </button>

                    <button type="submit"
                            disabled="@isSaving"
                            class="inline-flex items-center gap-2 px-6 py-2.5 text-xs font-semibold uppercase tracking-wider bg-[#C8963E] hover:bg-[#DDA84B] disabled:opacity-50 disabled:cursor-not-allowed text-[#0F0E0D] rounded-sm transition-all shadow-md">
                        @if (isSaving)
                        {
                            <div class="w-3.5 h-3.5 border-2 border-[#0F0E0D] border-t-transparent rounded-full animate-spin"></div>
                            <span>Inscribing into Stone...</span>
                        }
                        else
                        {
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                                <polyline points="7 3 7 8 15 8"></polyline>
                            </svg>
                            <span>Inscribe Tome</span>
                        }
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<Book> OnTomeInscribed { get; set; }

    private Book newBook = new()
    {
        Category = "Codex"
    };

    private bool isSaving = false;
    private string errorMessage = "";
    private byte[]? uploadedFileBytes;
    private string? uploadedFileName;

    private void ResetForm()
    {
        newBook = new Book { Category = "Codex" };
        uploadedFileBytes = null;
        uploadedFileName = null;
        errorMessage = "";
        isSaving = false;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                uploadedFileName = file.Name;
                using var stream = file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024); // 15MB max
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                uploadedFileBytes = ms.ToArray();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error reading archival file: {ex.Message}";
        }
    }

    private async Task HandleSubmit()
    {
        if (!AuthState.IsAuthenticated)
        {
            errorMessage = "You must enter the sanctuary as a Scholar to inscribe tomes.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newBook.Title) || string.IsNullOrWhiteSpace(newBook.Author))
        {
            errorMessage = "Title and Author are required.";
            return;
        }

        isSaving = true;
        errorMessage = "";

        try
        {
            var actor = AuthState.CurrentUser!;
            var inscribed = await ArchiveService.InscribeBookAsync(
                book: newBook,
                fileBytes: uploadedFileBytes,
                fileName: uploadedFileName,
                actorName: actor.Username,
                actorRole: actor.Role
            );

            if (inscribed != null)
            {
                await OnTomeInscribed.InvokeAsync(inscribed);
                ResetForm();
                await Close();
            }
            else
            {
                errorMessage = "Failed to inscribe tome into the library.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Sanctuary error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task Close()
    {
        ResetForm();
        await OnClose.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await Close();
        }
    }
}
