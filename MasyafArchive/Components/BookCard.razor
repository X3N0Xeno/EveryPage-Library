@using MasyafArchive.Models

<div class="alcove-card group relative bg-[#181614] border border-[#2E2A25] rounded-sm p-5 flex flex-col justify-between hover:border-[#8C6D3F] transition-all duration-300">
    <div>
        <!-- Top Badges: Genre & Source -->
        <div class="flex items-center justify-between gap-2 mb-4">
            <span class="inline-flex items-center px-2.5 py-0.5 text-[11px] font-mono tracking-wider uppercase rounded-sm border border-[#2E2A25] bg-[#0F0E0D] text-[#C8963E]">
                @Book.GenreLabel
            </span>
            <span class="inline-flex items-center px-2 py-0.5 text-[10px] font-mono tracking-wider uppercase rounded-sm border @GetSourceBadgeClass()">
                @Book.SourceBadge
            </span>
        </div>

        <!-- Cover + Bibliographic Header -->
        <div class="flex gap-4 mb-3">
            @if (!string.IsNullOrWhiteSpace(Book.CoverUrl) && !coverLoadFailed)
            {
                <img src="@Book.CoverUrl"
                     alt="@Book.Title cover"
                     loading="lazy"
                     @onerror="() => coverLoadFailed = true"
                     class="w-16 h-24 object-cover rounded-sm border border-[#2E2A25] bg-[#0F0E0D] shrink-0 shadow-md" />
            }
            else
            {
                <div class="w-16 h-24 rounded-sm border border-[#2E2A25] bg-gradient-to-b from-[#201E1A] to-[#0F0E0D] p-1.5 flex flex-col justify-between shrink-0 select-none">
                    <span class="text-[8px] font-mono uppercase tracking-widest text-[#C8963E]/80 truncate">@Book.GenreLabel</span>
                    <span class="font-serif text-[11px] font-bold leading-tight text-[#EDE6D6] line-clamp-3">@Book.Title</span>
                    <span class="text-[8px] font-mono text-[#9E9587] truncate">@(string.IsNullOrWhiteSpace(Book.PublicationYear) ? "EP" : Book.PublicationYear)</span>
                </div>
            }

            <div class="min-w-0 flex-1">
                <h3 class="font-serif text-xl font-bold text-[#EDE6D6] group-hover:text-[#DDA84B] transition-colors leading-snug line-clamp-2 mb-1">
                    @Book.Title
                </h3>
                <p class="text-xs font-medium text-[#EDE6D6]/85 truncate">
                    @Book.Author
                </p>
                <p class="text-[11px] font-mono text-[#9E9587] mt-1">
                    @if (!string.IsNullOrWhiteSpace(Book.PublicationYear))
                    {
                        <span>@Book.PublicationYear</span>
                        <span class="mx-1.5 text-[#2E2A25]">&bull;</span>
                    }
                    <span>@(Book.IsIndexed ? $"#{Book.Id:D4}" : "Web Catalog")</span>
                </p>
            </div>
        </div>

        <!-- Synopsis -->
        <p class="text-xs sm:text-sm text-[#9E9587] line-clamp-3 leading-relaxed mb-4 font-sans">
            @(string.IsNullOrWhiteSpace(Book.Synopsis) ? "Open-access edition available to read online or download directly." : Book.Synopsis)
        </p>
    </div>

    <!-- Bottom Stats & Actions -->
    <div class="pt-3.5 border-t border-[#2E2A25]/60 mt-2">
        <div class="flex items-center justify-between text-[11px] font-mono text-[#9E9587] mb-3.5">
            <span class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-[#C8963E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                @Book.DownloadCount.ToString("N0") downloads
            </span>

            <div class="flex items-center gap-1">
                @if (HasPdf)
                {
                    <span class="px-1.5 py-0.5 rounded-sm bg-[#2E2A25]/60 text-[#C8963E] text-[10px] uppercase">PDF</span>
                }
                @if (!string.IsNullOrWhiteSpace(Book.EpubUrl))
                {
                    <span class="px-1.5 py-0.5 rounded-sm bg-[#2E2A25]/60 text-[#EDE6D6]/80 text-[10px] uppercase">EPUB</span>
                }
                @if (HasTextDownload)
                {
                    <span class="px-1.5 py-0.5 rounded-sm bg-[#2E2A25]/60 text-[#9E9587] text-[10px] uppercase">TXT</span>
                }
            </div>
        </div>

        <div class="flex items-center gap-2">
            <button type="button"
                    @onclick="() => OnRead.InvokeAsync(Book)"
                    class="flex-1 inline-flex items-center justify-center gap-2 px-3 py-2 text-xs font-semibold tracking-wide uppercase bg-[#C8963E] hover:bg-[#DDA84B] text-[#0F0E0D] rounded-sm transition-all shadow-sm">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                </svg>
                <span>Read Online</span>
            </button>

            <button type="button"
                    @onclick="() => OnDownload.InvokeAsync(Book)"
                    title="Download directly"
                    class="inline-flex items-center justify-center gap-1.5 px-3 py-2 text-xs font-mono uppercase bg-[#0F0E0D] hover:bg-[#201E1A] text-[#EDE6D6] hover:text-[#C8963E] border border-[#2E2A25] hover:border-[#8C6D3F] rounded-sm transition-all">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
            </button>

            @if (IsAuditor && Book.IsIndexed)
            {
                <button type="button"
                        @onclick="() => OnEdit.InvokeAsync(Book)"
                        title="Edit Metadata"
                        class="inline-flex items-center justify-center p-2 text-xs bg-[#0F0E0D] hover:bg-[#201E1A] text-[#9E9587] hover:text-[#EDE6D6] border border-[#2E2A25] rounded-sm transition-all">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                </button>

                <button type="button"
                        @onclick="() => OnSeal.InvokeAsync(Book)"
                        title="Delete Book"
                        class="inline-flex items-center justify-center p-2 text-xs bg-[#0F0E0D] hover:bg-[#9E332D]/20 text-[#9E332D] border border-[#2E2A25] hover:border-[#9E332D] rounded-sm transition-all">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Book Book { get; set; } = default!;
    [Parameter] public bool IsAuditor { get; set; }
    [Parameter] public EventCallback<Book> OnRead { get; set; }
    [Parameter] public EventCallback<Book> OnDownload { get; set; }
    [Parameter] public EventCallback<Book> OnEdit { get; set; }
    [Parameter] public EventCallback<Book> OnSeal { get; set; }

    private bool coverLoadFailed = false;

    private bool HasPdf =>
        !string.IsNullOrWhiteSpace(Book.PdfUrl) ||
        (Book.FileUrl?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) == true);

    private bool HasTextDownload =>
        !string.IsNullOrWhiteSpace(Book.ContentText) ||
        (Book.FileUrl?.EndsWith(".txt", StringComparison.OrdinalIgnoreCase) == true);

    private string GetSourceBadgeClass() => Book.SourceBadge switch
    {
        "Community PDF" => "border-[#C8963E]/50 bg-[#C8963E]/15 text-[#DDA84B]",
        "Project Gutenberg" => "border-[#2E2A25] bg-[#0F0E0D] text-[#EDE6D6]/85",
        "Open Library" => "border-[#2E2A25] bg-[#0F0E0D] text-[#9E9587]",
        _ => "border-[#2E2A25] bg-[#0F0E0D] text-[#9E9587]"
    };
}
