@using MasyafArchive.Models

<div class="alcove-card group relative bg-[#181614] border border-[#2E2A25] rounded-sm p-6 flex flex-col justify-between hover:border-[#8C6D3F] transition-all duration-300">
    <!-- Top Row: Category & Catalog Number -->
    <div>
        <div class="flex items-center justify-between gap-2 mb-3">
            <span class="inline-flex items-center px-2.5 py-0.5 text-xs font-mono tracking-wider uppercase rounded-sm border border-[#2E2A25] bg-[#0F0E0D] text-[#C8963E]">
                @(Book.Category == "Codex" ? "General" : Book.Category)
            </span>
            <span class="font-mono text-xs text-[#9E9587] tracking-widest">
                #@Book.Id.ToString("D4")
            </span>
        </div>

        <!-- Book Title -->
        <h3 class="font-serif text-xl sm:text-2xl font-bold text-[#EDE6D6] group-hover:text-[#DDA84B] transition-colors leading-tight mb-2">
            @Book.Title
        </h3>

        <!-- Author & Uploader -->
        <div class="flex items-center gap-2 text-xs text-[#9E9587] mb-3">
            <span class="font-medium text-[#EDE6D6]/80">@Book.Author</span>
            <span class="text-[#2E2A25]">•</span>
            <span>Uploaded by @Book.UploadedBy</span>
        </div>

        <!-- Synopsis / Description Excerpt -->
        <p class="text-sm text-[#9E9587] line-clamp-3 leading-relaxed mb-4 font-sans">
            @Book.Synopsis
        </p>
    </div>

    <!-- Bottom Section: Stats & Action Buttons -->
    <div class="pt-4 border-t border-[#2E2A25]/60 mt-2">
        <div class="flex items-center justify-between text-xs font-mono text-[#9E9587] mb-4">
            <span class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-[#C8963E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                @Book.DownloadCount downloads
            </span>
            @if (Book.FileUrl != null && Book.FileUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                <span class="px-1.5 py-0.5 rounded-sm bg-[#2E2A25]/50 text-[#C8963E] text-[10px] uppercase tracking-wider">
                    PDF Attached
                </span>
            }
        </div>

        <div class="flex items-center gap-2">
            <!-- Read Online (Primary Golden CTA) -->
            <button @onclick="() => OnRead.InvokeAsync(Book)"
                    class="flex-1 inline-flex items-center justify-center gap-2 px-3 py-2 text-xs font-medium tracking-wide uppercase bg-[#C8963E] hover:bg-[#DDA84B] text-[#0F0E0D] font-semibold rounded-sm transition-all shadow-sm">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                </svg>
                Read Online
            </button>

            <!-- Download Button -->
            <button @onclick="() => OnDownload.InvokeAsync(Book)"
                    title="Download"
                    class="inline-flex items-center justify-center p-2 text-xs uppercase bg-[#0F0E0D] hover:bg-[#201E1A] text-[#EDE6D6] hover:text-[#C8963E] border border-[#2E2A25] hover:border-[#8C6D3F] rounded-sm transition-all">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
            </button>

            <!-- Auditor Controls if logged in as Auditor -->
            @if (IsAuditor)
            {
                <button @onclick="() => OnEdit.InvokeAsync(Book)"
                        title="Edit Book"
                        class="inline-flex items-center justify-center p-2 text-xs bg-[#0F0E0D] hover:bg-[#201E1A] text-[#9E9587] hover:text-[#EDE6D6] border border-[#2E2A25] rounded-sm transition-all">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                </button>

                <button @onclick="() => OnSeal.InvokeAsync(Book)"
                        title="Delete Book"
                        class="inline-flex items-center justify-center p-2 text-xs bg-[#0F0E0D] hover:bg-[#9E332D]/20 text-[#9E332D] border border-[#2E2A25] hover:border-[#9E332D] rounded-sm transition-all">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Book Book { get; set; } = default!;

    [Parameter]
    public bool IsAuditor { get; set; }

    [Parameter]
    public EventCallback<Book> OnRead { get; set; }

    [Parameter]
    public EventCallback<Book> OnDownload { get; set; }

    [Parameter]
    public EventCallback<Book> OnEdit { get; set; }

    [Parameter]
    public EventCallback<Book> OnSeal { get; set; }
}
