@using EverydayLibrary.Models

<div class="comic-panel group relative rounded-sm p-5 flex flex-col justify-between">
    <div>
        <!-- Top Stamp Row: Axis 3 Primary Domain + Source Stamp -->
        <div class="flex items-center justify-between gap-2 mb-2.5">
            <span class="inline-flex items-center px-2.5 py-0.5 text-[11px] font-mono font-bold tracking-wide uppercase rounded-sm border-2 border-[#1C1917] bg-[#F4C430] text-[#1C1917] truncate">
                @Book.DomainTag
            </span>
            <span class="inline-flex items-center px-2 py-0.5 text-[11px] font-mono font-bold tracking-wide uppercase rounded-sm border-2 border-[#1C1917] shrink-0 @GetSourceBadgeClass()">
                @Book.SourceBadge
            </span>
        </div>

        <!-- Faceted Taxonomy Micro-Badges (Axes 1, 5, 6) -->
        <div class="flex flex-wrap items-center gap-1 mb-3">
            <span class="px-1.5 py-0.5 text-[10px] font-mono bg-[#FAF6EC] border border-[#1C1917]/40 text-[#1C1917] rounded-sm" title="Axis 1: Form & Structure">
                @Book.FormTag
            </span>
            <span class="px-1.5 py-0.5 text-[10px] font-mono bg-[#FAF6EC] border border-[#1C1917]/40 text-[#57534E] rounded-sm" title="Axis 5: Era of Origin">
                @Book.EraTag
            </span>
            <span class="px-1.5 py-0.5 text-[10px] font-mono bg-[#F2EAD8] border border-[#1C1917]/40 text-[#1C1917] rounded-sm" title="Axis 6: Rights & Access Status">
                @Book.RightsTag
            </span>
        </div>

        <div class="flex gap-4 mb-3">
            @if (!string.IsNullOrWhiteSpace(Book.CoverUrl) && !coverLoadFailed)
            {
                <img src="@Book.CoverUrl"
                     alt="@Book.Title cover"
                     loading="lazy"
                     @onerror="() => coverLoadFailed = true"
                     class="w-16 h-24 object-cover rounded-sm border-2 border-[#1C1917] bg-[#F2EAD8] shrink-0 shadow-[2px_2px_0px_#1C1917]" />
            }
            else
            {
                <div class="w-16 h-24 rounded-sm border-2 border-[#1C1917] bg-[#F2EAD8] p-1.5 flex flex-col justify-between shrink-0 select-none shadow-[2px_2px_0px_#1C1917]">
                    <span class="text-[8px] font-mono font-bold uppercase text-[#D93829] truncate">@Book.FormTag</span>
                    <span class="font-comic text-[11px] font-bold leading-tight text-[#1C1917] line-clamp-3">@Book.Title</span>
                    <span class="text-[8px] font-mono text-[#57534E] truncate">@Book.EraTag</span>
                </div>
            }

            <div class="min-w-0 flex-1">
                <h3 class="font-comic text-lg sm:text-xl font-bold text-[#1C1917] group-hover:text-[#D93829] transition-colors leading-snug line-clamp-2 mb-1">
                    @Book.Title
                </h3>
                <p class="text-sm font-bold text-[#1C1917]/85 truncate">
                    @Book.Author
                </p>
                <p class="text-xs font-mono text-[#57534E] mt-1 truncate">
                    @Book.FactualityTag &bull; @Book.AudienceTag
                </p>
            </div>
        </div>

        <p class="text-sm text-[#57534E] line-clamp-3 leading-snug mb-4 font-hand">
            @(string.IsNullOrWhiteSpace(Book.Synopsis) ? "Open-access edition ready to read online or download." : Book.Synopsis)
        </p>
    </div>

    <div class="pt-3 border-t-2 border-dashed border-[#1C1917]/25 mt-2">
        <div class="flex items-center justify-between text-xs font-mono text-[#57534E] mb-3">
            <span class="flex items-center gap-1.5 font-bold">
                <svg class="w-3.5 h-3.5 text-[#D93829]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                @Book.DownloadCount.ToString("N0") @GetMetricLabel()
            </span>

            <div class="flex items-center gap-1">
                @if (HasPdf)
                {
                    <span class="px-1.5 py-0.5 rounded-sm border border-[#1C1917] bg-[#F2EAD8] text-[#1C1917] text-[10px] font-bold uppercase">PDF</span>
                }
                @if (!string.IsNullOrWhiteSpace(Book.EpubUrl))
                {
                    <span class="px-1.5 py-0.5 rounded-sm border border-[#1C1917] bg-[#F2EAD8] text-[#1C1917] text-[10px] font-bold uppercase">EPUB</span>
                }
                @if (HasTextDownload)
                {
                    <span class="px-1.5 py-0.5 rounded-sm border border-[#1C1917] bg-[#F2EAD8] text-[#1C1917] text-[10px] font-bold uppercase">TXT</span>
                }
                @if (!HasAnyDownload)
                {
                    <span class="px-1.5 py-0.5 rounded-sm border border-[#1C1917]/40 bg-[#FAF6EC] text-[#57534E] text-[10px] font-bold uppercase">CATALOG</span>
                }
            </div>
        </div>

        <div class="flex items-center gap-2">
            <button type="button"
                    @onclick="() => OnRead.InvokeAsync(Book)"
                    class="ink-btn flex-1 inline-flex items-center justify-center gap-2 px-3 py-2 text-sm font-comic font-bold tracking-wide uppercase bg-[#D93829] hover:bg-[#c22e20] text-[#FFFDF7] rounded-sm">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                </svg>
                <span>Read Book</span>
            </button>

            <button type="button"
                    @onclick="() => OnDownload.InvokeAsync(Book)"
                    disabled="@(IsDownloading || !HasAnyDownload)"
                    title="@(HasAnyDownload ? "Download or open 1-click download page" : "No downloadable file available for this catalog record")"
                    class='ink-btn inline-flex items-center justify-center px-3 py-2 rounded-sm @(HasAnyDownload ? "bg-[#FFFDF7] hover:bg-[#F4C430] text-[#1C1917]" : "bg-[#F2EAD8] text-[#57534E]/50 opacity-60 cursor-not-allowed")'>
                @if (IsDownloading)
                {
                    <svg class="w-4 h-4 animate-spin text-[#D93829]" viewBox="0 0 24 24" fill="none">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
                        <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                    </svg>
                }
                else
                {
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                }
            </button>

            @if (IsAuditor && Book.IsIndexed)
            {
                <button type="button"
                        @onclick="() => OnEdit.InvokeAsync(Book)"
                        title="Edit Card"
                        class="ink-btn inline-flex items-center justify-center p-2 bg-[#FFFDF7] hover:bg-[#F2EAD8] text-[#1C1917] rounded-sm">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                </button>

                <button type="button"
                        @onclick="() => OnSeal.InvokeAsync(Book)"
                        title="Delete Book"
                        class="ink-btn inline-flex items-center justify-center p-2 bg-[#FFFDF7] hover:bg-[#D93829] text-[#D93829] hover:text-[#FFFDF7] rounded-sm">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Book Book { get; set; } = default!;
    [Parameter] public bool IsAuditor { get; set; }
    [Parameter] public bool IsDownloading { get; set; }
    [Parameter] public EventCallback<Book> OnRead { get; set; }
    [Parameter] public EventCallback<Book> OnDownload { get; set; }
    [Parameter] public EventCallback<Book> OnEdit { get; set; }
    [Parameter] public EventCallback<Book> OnSeal { get; set; }

    private bool coverLoadFailed = false;

    private bool HasPdf =>
        !string.IsNullOrWhiteSpace(Book.PdfUrl) ||
        (Book.FileUrl?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) == true);

    private bool HasTextDownload =>
        !string.IsNullOrWhiteSpace(Book.ContentText) ||
        (Book.FileUrl?.Contains("txt", StringComparison.OrdinalIgnoreCase) == true);

    private bool HasAnyDownload =>
        HasPdf || !string.IsNullOrWhiteSpace(Book.EpubUrl) || HasTextDownload;

    private string GetMetricLabel() => Book.SourceBadge switch
    {
        "Open Library" => "editions",
        "Wikibooks" => "words",
        _ => "reads"
    };

    private string GetSourceBadgeClass() => Book.SourceBadge switch
    {
        "Community PDF" => "bg-[#D93829] text-[#FFFDF7]",
        "Standard Ebooks" => "bg-[#1C1917] text-[#F4C430]",
        "Internet Archive" => "bg-[#6BA4B8] text-[#1C1917]",
        "Project Gutenberg" => "bg-[#FFFDF7] text-[#1C1917]",
        "Wikibooks" => "bg-[#FEF08A] text-[#1C1917]",
        "Sacred Texts" => "bg-[#F3E8FF] text-[#1C1917]",
        "DOAB Academic" => "bg-[#DCFCE7] text-[#1C1917]",
        _ => "bg-[#F2EAD8] text-[#1C1917]"
    };
}
