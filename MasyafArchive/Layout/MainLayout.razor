@inherits LayoutComponentBase
@using MasyafArchive.Models
@using MasyafArchive.Services
@using MasyafArchive.Components
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@implements IDisposable

<div class="min-h-screen bg-[#0F0E0D] text-[#EDE6D6] flex flex-col font-sans selection:bg-[#C8963E]/30 selection:text-[#EDE6D6]">
    <header class="sticky top-0 z-40 bg-[#0F0E0D]/95 backdrop-blur-md border-b border-[#2E2A25]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 sm:h-20">
                <div class="flex items-center gap-4">
                    <a href="/" class="flex items-center gap-3 group">
                        <div class="w-10 h-10 rounded-sm bg-[#181614] border border-[#2E2A25] group-hover:border-[#C8963E] flex items-center justify-center text-[#C8963E] transition-all duration-300">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"></path>
                                <path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"></path>
                            </svg>
                        </div>
                        <div>
                            <span class="font-serif text-lg sm:text-xl font-bold tracking-[0.16em] uppercase text-[#EDE6D6] group-hover:text-[#DDA84B] transition-colors block leading-tight">
                                EveryPage Library
                            </span>
                            <span class="font-mono text-[10px] tracking-widest uppercase text-[#9E9587] block">
                                Open Global Reading Hall
                            </span>
                        </div>
                    </a>

                    <nav class="hidden md:flex items-center gap-1 ml-6 border-l border-[#2E2A25] pl-6 font-mono text-xs uppercase tracking-wider">
                        <NavLink href="" Match="NavLinkMatch.All"
                                 class="px-3 py-2 rounded-sm text-[#9E9587] hover:text-[#EDE6D6] hover:bg-[#181614] transition-all"
                                 ActiveClass="text-[#C8963E] bg-[#181614] font-bold border-b border-[#C8963E]">
                            Browse Books
                        </NavLink>

                        <NavLink href="audit-sanctum"
                                 class="px-3 py-2 rounded-sm text-[#9E9587] hover:text-[#EDE6D6] hover:bg-[#181614] transition-all flex items-center gap-1.5"
                                 ActiveClass="text-[#C8963E] bg-[#181614] font-bold border-b border-[#C8963E]">
                            <span>Site Audit</span>
                            @if (AuthState.IsAuditor)
                            {
                                <span class="w-1.5 h-1.5 rounded-full bg-[#9E332D]"></span>
                            }
                            else
                            {
                                <svg class="w-3 h-3 text-[#9E9587]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            }
                        </NavLink>
                    </nav>
                </div>

                <div class="flex items-center gap-3">
                    @if (AuthState.IsAuthenticated)
                    {
                        <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-sm bg-[#181614] border border-[#2E2A25]">
                            <div class="w-2 h-2 rounded-full @(AuthState.IsAuditor ? "bg-[#9E332D]" : "bg-[#C8963E]") animate-pulse"></div>
                            <span class="text-xs text-[#9E9587]">Signed in as</span>
                            <span class="text-xs font-semibold text-[#EDE6D6]">@AuthState.CurrentUser?.Username</span>
                            <span class="text-[10px] font-mono uppercase px-1.5 py-0.5 rounded-sm @(AuthState.IsAuditor ? "bg-[#9E332D]/30 text-[#EDE6D6] border border-[#9E332D]" : "bg-[#201E1A] text-[#9E9587]")">
                                @(AuthState.IsAuditor ? "Auditor" : "Contributor")
                            </span>
                        </div>

                        <button type="button"
                                @onclick="SignOut"
                                title="Sign out of your account"
                                class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono uppercase tracking-wider text-[#9E9587] hover:text-[#EDE6D6] hover:bg-[#181614] border border-transparent hover:border-[#2E2A25] rounded-sm transition-all">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            <span>Sign Out</span>
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                @onclick="() => isAuthModalOpen = true"
                                class="inline-flex items-center gap-2 px-3.5 py-1.5 text-xs font-mono uppercase tracking-wider text-[#EDE6D6] hover:text-[#C8963E] bg-[#181614] hover:bg-[#201E1A] border border-[#2E2A25] hover:border-[#8C6D3F] rounded-sm transition-all">
                            <svg class="w-3.5 h-3.5 text-[#C8963E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            <span>Sign In</span>
                        </button>
                    }
                </div>
            </div>

            <div class="flex md:hidden items-center justify-around py-2 border-t border-[#2E2A25] text-xs font-mono uppercase">
                <NavLink href="" Match="NavLinkMatch.All" class="py-1 px-3 text-[#9E9587] hover:text-[#EDE6D6]">
                    Browse Books
                </NavLink>
                <NavLink href="audit-sanctum" class="py-1 px-3 text-[#9E9587] hover:text-[#EDE6D6] flex items-center gap-1">
                    <span>Site Audit</span>
                    @if (AuthState.IsAuditor)
                    {
                        <span class="w-1.5 h-1.5 rounded-full bg-[#9E332D]"></span>
                    }
                </NavLink>
            </div>
        </div>
    </header>

    <main class="flex-1">
        @Body
    </main>

    <footer class="border-t border-[#2E2A25] bg-[#0F0E0D] py-10 mt-16 text-center select-none">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="sacred-divider max-w-xl mx-auto my-6">
                <div class="sacred-divider-diamond"></div>
            </div>

            <p class="font-serif italic text-lg sm:text-xl text-[#EDE6D6] tracking-wide mb-3">
                "Everything Humanity Has Written, Open to Everyone."
            </p>

            <div class="text-xs font-mono text-[#9E9587]/70 space-y-1">
                <p>EveryPage Library &bull; Community PDFs, Project Gutenberg &amp; Open Library in One Place</p>
                <p>Free to browse, read online, and download without an account</p>
            </div>
        </div>
    </footer>
</div>

<AuthModal IsOpen="isAuthModalOpen"
           OnClose="() => isAuthModalOpen = false"
           OnAuthenticated="HandleAuthenticated" />

@code {
    private bool isAuthModalOpen = false;

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += HandleAuthStateChanged;
        await AuthState.InitializeAsync();
    }

    private void HandleAuthStateChanged() => InvokeAsync(StateHasChanged);

    private async Task SignOut()
    {
        await AuthState.SignOutAsync();
        Navigation.NavigateTo("/");
    }

    private void HandleAuthenticated()
    {
        isAuthModalOpen = false;
        StateHasChanged();
    }

    public void Dispose() => AuthState.OnChange -= HandleAuthStateChanged;
}
