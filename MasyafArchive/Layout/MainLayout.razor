@inherits LayoutComponentBase
@using EverydayLibrary.Models
@using EverydayLibrary.Services
@using EverydayLibrary.Components
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@implements IDisposable

<div class="min-h-screen paper-sheet bg-[#FAF6EC] text-[#1C1917] flex flex-col font-hand selection:bg-[#F4C430]/50 selection:text-[#1C1917]">
    <header class="sticky top-0 z-40 bg-[#FFFDF7]/95 backdrop-blur-sm border-b-2 border-[#1C1917]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 sm:h-20">
                <div class="flex items-center gap-4">
                    <a href="/" class="flex items-center gap-3 group">
                        <div class="w-10 h-10 rounded-sm bg-[#D93829] border-2 border-[#1C1917] shadow-[2px_2px_0px_#1C1917] flex items-center justify-center text-[#FFFDF7] group-hover:-translate-y-0.5 transition-transform">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                <path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"></path>
                                <path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"></path>
                            </svg>
                        </div>
                        <div>
                            <span class="font-comic text-xl sm:text-2xl font-bold text-[#1C1917] group-hover:text-[#D93829] transition-colors block leading-none">
                                Everyday Library
                            </span>
                            <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-[#57534E] block mt-0.5">
                                Open Paper &amp; Ink Reading Hall
                            </span>
                        </div>
                    </a>

                    <nav class="hidden md:flex items-center gap-2 ml-6 border-l-2 border-dashed border-[#1C1917]/30 pl-6 font-comic text-sm font-bold uppercase">
                        <NavLink href="" Match="NavLinkMatch.All"
                                 class="px-3 py-1.5 rounded-sm border-2 border-transparent text-[#57534E] hover:text-[#1C1917] hover:bg-[#F2EAD8] transition-all"
                                 ActiveClass="!border-[#1C1917] !bg-[#F4C430] !text-[#1C1917] shadow-[2px_2px_0px_#1C1917]">
                            Browse Books
                        </NavLink>

                        <NavLink href="audit-sanctum"
                                 class="px-3 py-1.5 rounded-sm border-2 border-transparent text-[#57534E] hover:text-[#1C1917] hover:bg-[#F2EAD8] transition-all flex items-center gap-1.5"
                                 ActiveClass="!border-[#1C1917] !bg-[#F4C430] !text-[#1C1917] shadow-[2px_2px_0px_#1C1917]">
                            <span>Site Audit</span>
                            @if (AuthState.IsAuditor)
                            {
                                <span class="w-2 h-2 rounded-full bg-[#D93829] border border-[#1C1917]"></span>
                            }
                        </NavLink>
                    </nav>
                </div>

                <div class="flex items-center gap-3">
                    @if (AuthState.IsAuthenticated)
                    {
                        <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-sm bg-[#F2EAD8] border-2 border-[#1C1917]">
                            <div class="w-2.5 h-2.5 rounded-full @(AuthState.IsAuditor ? "bg-[#D93829]" : "bg-[#F4C430]") border border-[#1C1917]"></div>
                            <span class="text-sm font-bold text-[#1C1917]">@AuthState.CurrentUser?.Username</span>
                            <span class="text-[10px] font-mono font-bold uppercase px-1.5 py-0.5 rounded-sm border border-[#1C1917] @(AuthState.IsAuditor ? "bg-[#D93829] text-[#FFFDF7]" : "bg-[#FFFDF7] text-[#1C1917]")">
                                @(AuthState.IsAuditor ? "Auditor" : "Contributor")
                            </span>
                        </div>

                        <button type="button"
                                @onclick="SignOut"
                                class="ink-btn inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-comic font-bold uppercase bg-[#FFFDF7] hover:bg-[#F2EAD8] text-[#1C1917] rounded-sm">
                            <span>Sign Out</span>
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                @onclick="() => isAuthModalOpen = true"
                                class="ink-btn inline-flex items-center gap-2 px-3.5 py-1.5 text-xs font-comic font-bold uppercase bg-[#F4C430] hover:bg-[#e5b522] text-[#1C1917] rounded-sm">
                            <span>Library Card Sign In</span>
                        </button>
                    }
                </div>
            </div>

            <div class="flex md:hidden items-center justify-around py-2 border-t-2 border-dashed border-[#1C1917]/20 text-xs font-comic font-bold uppercase">
                <NavLink href="" Match="NavLinkMatch.All" class="py-1 px-3 text-[#1C1917]">Browse Books</NavLink>
                <NavLink href="audit-sanctum" class="py-1 px-3 text-[#1C1917]">Site Audit</NavLink>
            </div>
        </div>
    </header>

    <main class="flex-1">
        @Body
    </main>

    <footer class="border-t-2 border-[#1C1917] bg-[#FFFDF7] py-8 mt-16 text-center select-none">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="sacred-divider max-w-md mx-auto my-4">
                <div class="sacred-divider-diamond"></div>
            </div>

            <p class="font-comic text-xl font-bold text-[#1C1917] mb-2">
                "Everything Humanity Has Written, Open to Everyone."
            </p>

            <div class="text-xs font-mono text-[#57534E] space-y-1">
                <p>Everyday Library &bull; Community PDFs, Internet Archive, Open Library, Project Gutenberg, Wikisource &amp; DOAB</p>
                <p>Typed up fresh on warm paper &mdash; free to read and download without an account</p>
            </div>
        </div>
    </footer>
</div>

<AuthModal IsOpen="isAuthModalOpen"
           OnClose="() => isAuthModalOpen = false"
           OnAuthenticated="HandleAuthenticated" />

@code {
    private bool isAuthModalOpen = false;

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += HandleAuthStateChanged;
        await AuthState.InitializeAsync();
    }

    private void HandleAuthStateChanged() => InvokeAsync(StateHasChanged);

    private async Task SignOut()
    {
        await AuthState.SignOutAsync();
        Navigation.NavigateTo("/");
    }

    private void HandleAuthenticated()
    {
        isAuthModalOpen = false;
        StateHasChanged();
    }

    public void Dispose() => AuthState.OnChange -= HandleAuthStateChanged;
}

