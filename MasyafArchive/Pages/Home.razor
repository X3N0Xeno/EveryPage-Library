    private async Task ConfirmSealBook()
    {
        if (bookToSeal == null || !AuthState.IsAuditor) return;
        var user = AuthState.CurrentUser!;
        if (await ArchiveService.SoftDeleteBookAsync(bookToSeal.Id, user.Username, user.Role, sealReason))
        {
            isSealPromptOpen = false;
            bookToSeal = null;
            await LoadFirstPageAsync();
        }
    }

    private static string SanitizeFileName(string name)
    {
        var invalid = System.IO.Path.GetInvalidFileNameChars();
        var cleaned = string.Concat(name.Select(c => invalid.Contains(c) ? '_' : c)).Replace(" ", "_");
        return string.IsNullOrWhiteSpace(cleaned) ? "Everyday_Book" : cleaned;
    }

    public async ValueTask DisposeAsync()
    {
        AuthState.OnChange -= HandleAuthStateChange;
        loadCts?.Cancel();
        loadCts?.Dispose();
        try { await JSRuntime.InvokeVoidAsync("EverydayLibrary.disconnectSentinel"); }
        catch { }
        dotNetRef?.Dispose();
    }
