    </div>
</div>

<!-- Main Reading Hall -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mb-6">
        <form @onsubmit="ApplySearch" class="flex-1 flex items-center gap-2">
            <div class="relative flex-1">
                <svg class="w-4 h-4 text-[#57534E] absolute left-3.5 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text"
                       @bind="searchQuery"
                       placeholder="Search Standard Ebooks, Project Gutenberg, Open Library, Internet Archive, Wikibooks, Sacred Texts..."
                       class="w-full text-base pl-10 pr-9 py-2.5 rounded-sm bg-[#FFFDF7] border-2 border-[#1C1917] text-[#1C1917] placeholder-[#57534E] shadow-[2px_2px_0px_#1C1917] focus:bg-[#FFFDF7] focus:outline-none" />
                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <button type="button"
                            @onclick="ClearSearch"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-[#57534E] hover:text-[#1C1917] font-bold">
                        &#x2715;
                    </button>
                }
            </div>
            <button type="submit"
                    class="ink-btn px-5 py-2.5 text-sm font-comic font-bold uppercase bg-[#F4C430] hover:bg-[#e5b522] text-[#1C1917] rounded-sm">
                Search
            </button>
        </form>

        <button type="button"
                @onclick="TriggerUploadDrawer"
                class="ink-btn inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm font-comic font-bold uppercase bg-[#D93829] hover:bg-[#c22e20] text-[#FFFDF7] rounded-sm whitespace-nowrap">
            <span>+ Upload PDF</span>
        </button>
    </div>

    <!-- Mutually Exclusive 6-Axis Master Tagging System -->
    <div class="mb-8 pb-5 border-b-2 border-dashed border-[#1C1917]/25 space-y-4">
        <!-- Axis 3: Primary Domain / Subject -->
        <div>
            <div class="flex items-center justify-between mb-2">
                <span class="font-mono text-xs font-bold uppercase tracking-wider text-[#57534E]">
                    Axis 3 &mdash; Primary Domain / Subject (@BookGenres.DomainTags.Count Non-Overlapping Domains):
                </span>
                <button type="button"
                        @onclick="() => showAllTags = !showAllTags"
                        class="font-mono text-xs font-bold text-[#D93829] hover:underline">
                    @(showAllTags ? "Compact Domains \u25B2" : "Show All 15 Domains \u25BC")
                </button>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                @foreach (var domain in VisibleDomains)
                {
                    <button type="button"
                            @onclick="() => SelectCategory(domain)"
                            class='ink-btn px-3 py-1 rounded-sm text-xs font-mono font-bold transition-all @(selectedCategory == domain ? "bg-[#1C1917] text-[#F4C430]" : "bg-[#FFFDF7] hover:bg-[#F4C430]/40 text-[#1C1917]")'>
                        @domain
                    </button>
                }
            </div>
        </div>

        <!-- Axes 1, 2, 4, 5, 6: Independent Faceted Selectors -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5 pt-2">
            <div>
                <label class="block font-mono text-[10px] font-bold uppercase text-[#57534E] mb-1">Axis 1: Form &amp; Structure</label>
                <select @bind="selectedForm" class="w-full text-xs font-mono p-2 rounded-sm bg-[#FFFDF7] border-2 border-[#1C1917] text-[#1C1917]">
                    <option value="All">All Forms</option>
                    @foreach (var tag in BookGenres.FormTags)
                    {
                        <option value="@tag">@tag</option>
                    }
                </select>
            </div>

            <div>
                <label class="block font-mono text-[10px] font-bold uppercase text-[#57534E] mb-1">Axis 2: Factuality</label>
                <select @bind="selectedFactuality" class="w-full text-xs font-mono p-2 rounded-sm bg-[#FFFDF7] border-2 border-[#1C1917] text-[#1C1917]">
                    <option value="All">All Factuality</option>
                    @foreach (var tag in BookGenres.FactualityTags)
                    {
                        <option value="@tag">@tag</option>
                    }
                </select>
            </div>

            <div>
                <label class="block font-mono text-[10px] font-bold uppercase text-[#57534E] mb-1">Axis 4: Target Audience</label>
                <select @bind="selectedAudience" class="w-full text-xs font-mono p-2 rounded-sm bg-[#FFFDF7] border-2 border-[#1C1917] text-[#1C1917]">
                    <option value="All">All Audiences</option>
                    @foreach (var tag in BookGenres.AudienceTags)
                    {
                        <option value="@tag">@tag</option>
                    }
                </select>
            </div>

            <div>
                <label class="block font-mono text-[10px] font-bold uppercase text-[#57534E] mb-1">Axis 5: Era of Origin</label>
                <select @bind="selectedEra" class="w-full text-xs font-mono p-2 rounded-sm bg-[#FFFDF7] border-2 border-[#1C1917] text-[#1C1917]">
                    <option value="All">All Eras</option>
                    @foreach (var tag in BookGenres.EraTags)
                    {
                        <option value="@tag">@tag</option>
                    }
                </select>
            </div>

            <div>
                <label class="block font-mono text-[10px] font-bold uppercase text-[#57534E] mb-1">Axis 6: Rights &amp; Access</label>
                <select @bind="selectedRights" class="w-full text-xs font-mono p-2 rounded-sm bg-[#FFFDF7] border-2 border-[#1C1917] text-[#1C1917]">
                    <option value="All">All Access Tiers</option>
                    @foreach (var tag in BookGenres.RightsTags)
                    {
                        <option value="@tag">@tag</option>
                    }
                </select>
            </div>
        </div>
    </div>

    @if (HasActiveFilters)
    {
        <div class="flex items-center justify-between mb-5 px-4 py-2.5 bg-[#F2EAD8] border-2 border-[#1C1917] rounded-sm text-xs font-mono">
            <span>
                Active Facets: <strong class="text-[#D93829]">@selectedCategory</strong>
                @if (selectedForm != "All") { <span> &bull; @selectedForm</span> }
                @if (selectedFactuality != "All") { <span> &bull; @selectedFactuality</span> }
                @if (selectedAudience != "All") { <span> &bull; @selectedAudience</span> }
                @if (selectedEra != "All") { <span> &bull; @selectedEra</span> }
                @if (selectedRights != "All") { <span> &bull; @selectedRights</span> }
                @if (!string.IsNullOrWhiteSpace(searchQuery)) { <span> &bull; Query: "<strong>@searchQuery</strong>"</span> }
                <span> (@FilteredBooks.Count matching editions)</span>
            </span>
            <button type="button"
                    @onclick="ResetFilters"
                    class="font-bold text-[#D93829] hover:underline uppercase">
                Reset All
            </button>
        </div>
    }

    @if (isInitialLoading && books.Count == 0)
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @for (int i = 0; i < 12; i++)
            {
                <BookCardSkeleton />
            }
        </div>
    }
    else if (FilteredBooks.Count == 0)
    {
        <div class="max-w-md mx-auto my-12 p-8 bg-[#FFFDF7] border-2 border-[#1C1917] shadow-[4px_4px_0px_#1C1917] rounded-sm text-center">
            <h3 class="font-comic text-2xl font-bold text-[#1C1917] mb-2">No Index Cards Match These Axes</h3>
            <p class="text-base text-[#57534E] mb-5">
                No editions match that exact combination of facets. Loosen one of the 6 taxonomy filters or load more cards!
            </p>
            <button type="button"
                    @onclick="ResetFilters"
                    class="ink-btn px-5 py-2 text-sm font-comic font-bold uppercase bg-[#F4C430] text-[#1C1917] rounded-sm">
                Reset Facet Filters
            </button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var book in FilteredBooks)
            {
                <BookCard Book="book"
                          IsAuditor="@AuthState.IsAuditor"
                          IsDownloading="@(downloadingBookKey == GetBookKey(book))"
                          OnRead="OpenReader"
                          OnDownload="b => DownloadBook(b, null)"
                          OnEdit="OpenEditModal"
                          OnSeal="PromptSeal" />
            }

            @if (isLoadingMore)
            {
                @for (int i = 0; i < 6; i++)
                {
                    <BookCardSkeleton />
                }
            }
        </div>

        <div @ref="scrollSentinel" class="h-12 mt-6 flex items-center justify-center">
            @if (!hasMorePages)
            {
                <p class="font-mono text-xs text-[#57534E]">
                    &mdash; End of shelf (@FilteredBooks.Count books) &mdash;
                </p>
            }
        </div>
    }
</div>

<!-- Paper-Ink Download Status Toast -->
@if (!string.IsNullOrWhiteSpace(downloadToastMessage))
{
    <div class="fixed bottom-5 right-5 z-50 max-w-sm bg-[#FFFDF7] border-2 border-[#1C1917] shadow-[4px_4px_0px_#1C1917] rounded-sm p-3.5 flex items-start gap-3 animate-modal-in">
        <span class="w-2.5 h-2.5 mt-1.5 rounded-full shrink-0 @(downloadToastIsWarning ? "bg-[#D93829]" : "bg-[#F4C430]") border border-[#1C1917]"></span>
        <div class="flex-1 text-xs font-mono text-[#1C1917] leading-snug">
            @downloadToastMessage
        </div>
        <button type="button" @onclick="() => downloadToastMessage = null" class="text-xs font-mono font-bold text-[#57534E] hover:text-[#1C1917]">&#x2715;</button>
    </div>
}

<CodexReaderModal Book="selectedBookForReader"
                  IsOpen="isReaderOpen"
                  OnClose="() => isReaderOpen = false"
                  OnDownloadFormat="args => DownloadBook(args.Book, args.Format)"
                  OnRequestSignIn="() => isAuthModalOpen = true" />

<UploadTomeDrawer IsOpen="isUploadDrawerOpen"
                  OnClose="() => isUploadDrawerOpen = false"
                  OnTomeInscribed="HandleTomeInscribed" />

<AuthModal IsOpen="isAuthModalOpen"
           OnClose="() => isAuthModalOpen = false"
           OnAuthenticated="HandleAuthenticated" />

<EditTomeModal IsOpen="isEditModalOpen"
               Book="bookToEdit"
               OnClose="() => isEditModalOpen = false"
               OnSaved="HandleBookUpdated" />

@if (isSealPromptOpen && bookToSeal != null)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-black/60 flex items-center justify-center p-4 animate-modal-in">
        <div class="w-full max-w-md bg-[#FFFDF7] border-2 border-[#1C1917] shadow-[6px_6px_0px_#1C1917] rounded-sm p-6 space-y-4">
            <h3 class="font-comic text-2xl font-bold text-[#D93829]">Remove Index Card?</h3>
            <p class="text-base text-[#1C1917]">
                Deleting <strong>@bookToSeal.Title</strong> removes it from the public shelf. You can restore it anytime from Site Audit.
            </p>
            <div>
                <label class="block text-xs font-mono font-bold uppercase text-[#57534E] mb-1">Reason:</label>
                <input type="text"
                       @bind="sealReason"
                       class="w-full text-sm p-2.5 rounded-sm bg-[#FAF6EC] border-2 border-[#1C1917] text-[#1C1917] focus:outline-none" />
            </div>
            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button" @onclick="() => isSealPromptOpen = false" class="ink-btn px-4 py-1.5 text-xs font-mono font-bold uppercase bg-[#FFFDF7] text-[#1C1917] rounded-sm">Cancel</button>
                <button type="button" @onclick="ConfirmSealBook" class="ink-btn px-4 py-1.5 text-xs font-mono font-bold uppercase bg-[#D93829] text-[#FFFDF7] rounded-sm">Confirm Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<Book> books = new();
    private (int TotalBooks, int CommunityPdfs, int TotalDownloads, int TotalLogs) stats = (0, 0, 0, 0);

    private string selectedCategory = "All";
    private string selectedForm = "All";
    private string selectedFactuality = "All";
    private string selectedAudience = "All";
    private string selectedEra = "All";
    private string selectedRights = "All";

    private string searchQuery = "";
    private bool showAllTags = false;

    private bool isInitialLoading = true;
    private bool isLoadingMore = false;
    private bool hasMorePages = true;
    private int currentPage = 1;
    private int loadVersion = 0;

    private string? downloadingBookKey;
    private string? downloadToastMessage;
    private bool downloadToastIsWarning;

    private ElementReference scrollSentinel;
    private DotNetObjectReference<Home>? dotNetRef;
    private CancellationTokenSource? loadCts;

    private bool isReaderOpen = false;
    private Book? selectedBookForReader;

    private bool isUploadDrawerOpen = false;
    private bool isAuthModalOpen = false;

    private bool isEditModalOpen = false;
    private Book? bookToEdit;

    private bool isSealPromptOpen = false;
    private Book? bookToSeal;
    private string sealReason = "";

    private IEnumerable<string> VisibleDomains =>
        showAllTags ? BookGenres.Filters : BookGenres.Filters.Take(9);

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchQuery) ||
        selectedCategory != "All" ||
        selectedForm != "All" ||
        selectedFactuality != "All" ||
        selectedAudience != "All" ||
        selectedEra != "All" ||
        selectedRights != "All";

    private List<Book> FilteredBooks => books.Where(b =>
        (selectedForm == "All" || b.FormTag.Equals(selectedForm, StringComparison.OrdinalIgnoreCase)) &&
        (selectedFactuality == "All" || b.FactualityTag.Equals(selectedFactuality, StringComparison.OrdinalIgnoreCase)) &&
        (selectedAudience == "All" || b.AudienceTag.Equals(selectedAudience, StringComparison.OrdinalIgnoreCase)) &&
        (selectedEra == "All" || b.EraTag.Equals(selectedEra, StringComparison.OrdinalIgnoreCase)) &&
        (selectedRights == "All" || b.RightsTag.Equals(selectedRights, StringComparison.OrdinalIgnoreCase))
    ).ToList();

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += HandleAuthStateChange;
        await LoadFirstPageAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (books.Count > 0 && hasMorePages)
        {
            dotNetRef ??= DotNetObjectReference.Create(this);
            try
            {
                await JSRuntime.InvokeVoidAsync("EverydayLibrary.observeSentinel", scrollSentinel, dotNetRef);
            }
            catch { }
        }
    }

    [JSInvokable]
    public async Task OnScrollBottomReached()
    {
        if (!isInitialLoading && !isLoadingMore && hasMorePages)
        {
            await LoadNextPageAsync();
        }
    }

    private void HandleAuthStateChange() => InvokeAsync(StateHasChanged);

    private static string GetBookKey(Book b) =>
        !string.IsNullOrWhiteSpace(b.ExternalId) ? b.ExternalId! : $"{b.Id}|{b.Title}|{b.Author}";

    private async Task LoadFirstPageAsync()
    {
        loadCts?.Cancel();
        loadCts = new CancellationTokenSource();
        var token = loadCts.Token;
        var version = ++loadVersion;

        isInitialLoading = true;
        isLoadingMore = false;
        currentPage = 1;
        hasMorePages = true;
        books.Clear();
        StateHasChanged();

        try
        {
            var localTask = ArchiveService.GetBooksAsync(selectedCategory, searchQuery, 60);
            var statsTask = ArchiveService.GetArchiveStatsAsync();

            var localBooks = await localTask;
            if (token.IsCancellationRequested || version != loadVersion) return;

            if (localBooks.Count > 0)
            {
                books = new List<Book>(localBooks);
                isInitialLoading = false;
                StateHasChanged();
            }

            _ = FederatedBooks.PrefetchPageAsync(searchQuery, selectedCategory, page: 2, token);

            var webBooks = await FederatedBooks.SearchPagedAsync(
                searchQuery,
                selectedCategory,
                page: 1,
                onPartialBatchReady: partial =>
                {
                    if (token.IsCancellationRequested || version != loadVersion) return;
                    isInitialLoading = false;
                    MergeAndRender(localBooks, partial);
                },
                cancellationToken: token);

            if (token.IsCancellationRequested || version != loadVersion) return;

            isInitialLoading = false;
            MergeAndRender(localBooks, webBooks);
            hasMorePages = webBooks.Count >= 8;
            stats = await statsTask;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading catalog: {ex.Message}");
        }
        finally
        {
            if (!token.IsCancellationRequested && version == loadVersion)
            {
                isInitialLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task LoadNextPageAsync()
    {
        if (isLoadingMore || isInitialLoading || !hasMorePages) return;

        var version = loadVersion;
        var nextPage = currentPage + 1;
        var isAlreadyCached = FederatedBooks.IsCached(searchQuery, selectedCategory, nextPage);

        isLoadingMore = true;
        if (!isAlreadyCached) StateHasChanged();

        try
        {
            var moreBooks = await FederatedBooks.SearchPagedAsync(
                searchQuery,
                selectedCategory,
                nextPage,
                onPartialBatchReady: partial =>
                {
                    if (version != loadVersion) return;
                    AppendUniqueBooks(partial);
                    InvokeAsync(StateHasChanged);
                });

            if (version != loadVersion) return;

            if (moreBooks.Count == 0)
            {
                hasMorePages = false;
            }
            else
            {
                currentPage = nextPage;
                AppendUniqueBooks(moreBooks);
                _ = FederatedBooks.PrefetchPageAsync(searchQuery, selectedCategory, currentPage + 1);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading page {nextPage}: {ex.Message}");
        }
        finally
        {
            if (version == loadVersion)
            {
                isLoadingMore = false;
                StateHasChanged();
            }
        }
    }

    private void AppendUniqueBooks(List<Book> incoming)
    {
        var existingKeys = new HashSet<string>(books.Select(GetBookKey), StringComparer.OrdinalIgnoreCase);
        foreach (var item in incoming)
        {
            if (existingKeys.Add(GetBookKey(item)))
            {
                books.Add(item);
            }
        }
    }

    private void MergeAndRender(List<Book> localBooks, List<Book> webBooks)
    {
        var seenExternal = new HashSet<string>(
            localBooks.Where(b => !string.IsNullOrWhiteSpace(b.ExternalId)).Select(b => b.ExternalId!),
            StringComparer.OrdinalIgnoreCase);

        var combined = new List<Book>(localBooks.Count + webBooks.Count);
        combined.AddRange(localBooks);

        foreach (var ext in webBooks)
        {
            if (!string.IsNullOrWhiteSpace(ext.ExternalId) && !seenExternal.Add(ext.ExternalId))
                continue;

            combined.Add(ext);
        }

        books = combined;
        InvokeAsync(StateHasChanged);
    }

