@page "/audit-sanctum"
@using EverydayLibrary.Models
@using EverydayLibrary.Services
@inject ArchiveService ArchiveService
@inject AuthStateService AuthState
@implements IDisposable

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-[#1C1917]">
    @if (!AuthState.IsAuthenticated || !AuthState.IsAuditor)
    {
        <div class="max-w-md mx-auto my-16 p-8 bg-[#FFFDF7] border-2 border-[#1C1917] shadow-[6px_6px_0px_#1C1917] rounded-sm text-center">
            <h2 class="font-comic text-3xl font-bold mb-2">Librarian Desk Only</h2>
            <p class="text-base text-[#57534E] mb-6">Only accounts with the <strong>auditor</strong> role can view the site log and moderate cards.</p>
            <button type="button" @onclick="SignInAsAltair"
                    class="ink-btn w-full py-2.5 px-4 text-sm font-comic font-bold uppercase bg-[#F4C430] text-[#1C1917] rounded-sm mb-4">
                Demo: Sign in as Librarian (Altair)
            </button>
            <a href="/" class="block text-xs font-mono font-bold underline">Back to Library</a>
        </div>
    }
    else
    {
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8 pb-6 border-b-2 border-[#1C1917]">
            <div>
                <span class="inline-block px-2 py-0.5 text-xs font-mono font-bold uppercase bg-[#D93829] text-[#FFFDF7] border border-[#1C1917] mb-1">
                    Auditor: @AuthState.CurrentUser?.Username
                </span>
                <h1 class="font-comic text-3xl sm:text-4xl font-bold">Site Audit &amp; Card Moderation</h1>
            </div>

            <div class="flex items-center gap-2 font-mono text-xs font-bold">
                <button type="button" @onclick='() => activeTab = "ledger"'
                        class='ink-btn px-4 py-2 uppercase rounded-sm @(activeTab == "ledger" ? "bg-[#F4C430]" : "bg-[#FFFDF7]")'>
                    Audit Log (@auditLogs.Count)
                </button>
                <button type="button" @onclick='() => activeTab = "moderation"'
                        class='ink-btn px-4 py-2 uppercase rounded-sm @(activeTab == "moderation" ? "bg-[#F4C430]" : "bg-[#FFFDF7]")'>
                    Books (@activeBooks.Count Active, @sealedBooks.Count Deleted)
                </button>
            </div>
        </div>

        @if (activeTab == "ledger")
        {
            <div class="space-y-4">
                <div class="flex flex-wrap items-center justify-between gap-3 p-4 bg-[#FFFDF7] border-2 border-[#1C1917] shadow-[3px_3px_0px_#1C1917] rounded-sm">
                    <div class="flex items-center gap-2 flex-wrap text-xs font-mono font-bold">
                        @foreach (var filter in actionFilters)
                        {
                            <button type="button" @onclick="() => FilterByAction(filter.Key)"
                                    class='ink-btn px-2.5 py-1 rounded-sm uppercase @(selectedAction == filter.Key ? "bg-[#1C1917] text-[#F4C430]" : "bg-[#FAF6EC]")'>
                                @filter.Value
                            </button>
                        }
                    </div>
                    <button type="button" @onclick="LoadDataAsync" class="ink-btn px-3 py-1.5 text-xs font-mono font-bold uppercase bg-[#F4C430] rounded-sm">
                        Refresh
                    </button>
                </div>

                <div class="bg-[#FFFDF7] border-2 border-[#1C1917] shadow-[4px_4px_0px_#1C1917] rounded-sm overflow-x-auto">
                    <table class="w-full text-left text-xs font-mono">
                        <thead class="bg-[#F2EAD8] border-b-2 border-[#1C1917] uppercase">
                            <tr>
                                <th class="py-3 px-4">UTC Time</th>
                                <th class="py-3 px-4">User</th>
                                <th class="py-3 px-4">Action</th>
                                <th class="py-3 px-4">Book</th>
                                <th class="py-3 px-4">Details</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[#1C1917]/20">
                            @foreach (var log in auditLogs)
                            {
                                <tr class="hover:bg-[#FAF6EC]">
                                    <td class="py-2.5 px-4 whitespace-nowrap">@log.CreatedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="py-2.5 px-4 font-bold">@log.ActorName (@log.ActorRole)</td>
                                    <td class="py-2.5 px-4"><span class="px-2 py-0.5 border border-[#1C1917] bg-[#F4C430] font-bold">@log.Action</span></td>
                                    <td class="py-2.5 px-4 font-bold text-[#D93829]">@log.TargetTitle</td>
                                    <td class="py-2.5 px-4 font-hand text-sm">@log.Details</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="space-y-8">
                <div class="bg-[#FFFDF7] border-2 border-[#1C1917] shadow-[4px_4px_0px_#1C1917] rounded-sm overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-[#F2EAD8] border-b-2 border-[#1C1917] font-mono text-xs uppercase">
                            <tr>
                                <th class="py-3 px-4">ID</th>
                                <th class="py-3 px-4">Title</th>
                                <th class="py-3 px-4">Author</th>
                                <th class="py-3 px-4">Source</th>
                                <th class="py-3 px-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[#1C1917]/20">
                            @foreach (var book in activeBooks)
                            {
                                <tr>
                                    <td class="py-2.5 px-4 font-mono text-xs">#@book.Id.ToString("D4")</td>
                                    <td class="py-2.5 px-4 font-comic font-bold">@book.Title</td>
                                    <td class="py-2.5 px-4">@book.Author</td>
                                    <td class="py-2.5 px-4 font-mono text-xs">@book.SourceBadge</td>
                                    <td class="py-2.5 px-4 text-right space-x-2">
                                        <button type="button" @onclick="() => OpenEditModal(book)" class="ink-btn px-2.5 py-1 text-xs font-mono font-bold bg-[#FFFDF7] rounded-sm">Edit</button>
                                        <button type="button" @onclick="() => PromptSeal(book)" class="ink-btn px-2.5 py-1 text-xs font-mono font-bold bg-[#D93829] text-[#FFFDF7] rounded-sm">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (sealedBooks.Count > 0)
                {
                    <div class="bg-[#FFFDF7] border-2 border-[#1C1917] shadow-[4px_4px_0px_#1C1917] rounded-sm overflow-x-auto">
                        <table class="w-full text-left text-sm">
                            <thead class="bg-[#D93829] text-[#FFFDF7] border-b-2 border-[#1C1917] font-mono text-xs uppercase">
                                <tr>
                                    <th class="py-3 px-4">Deleted Title</th>
                                    <th class="py-3 px-4">Author</th>
                                    <th class="py-3 px-4 text-right">Restore</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-[#1C1917]/20">
                                @foreach (var book in sealedBooks)
                                {
                                    <tr>
                                        <td class="py-2.5 px-4 font-comic font-bold">@book.Title</td>
                                        <td class="py-2.5 px-4">@book.Author</td>
                                        <td class="py-2.5 px-4 text-right">
                                            <button type="button" @onclick="() => RestoreBook(book.Id)" class="ink-btn px-3 py-1 text-xs font-mono font-bold bg-[#F4C430] rounded-sm">Restore</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    }
</div>

@if (isSealPromptOpen && bookToSeal != null)
{
    <div class="fixed inset-0 z-50 bg-black/60 flex items-center justify-center p-4">
        <div class="w-full max-w-md bg-[#FFFDF7] border-2 border-[#1C1917] shadow-[6px_6px_0px_#1C1917] rounded-sm p-6 space-y-4">
            <h3 class="font-comic text-xl font-bold text-[#D93829]">Delete @bookToSeal.Title?</h3>
            <input type="text" @bind="sealReason" class="w-full text-sm p-2 rounded-sm bg-[#FAF6EC] border-2 border-[#1C1917]" />
            <div class="flex justify-end gap-2">
                <button type="button" @onclick="() => isSealPromptOpen = false" class="ink-btn px-3 py-1 text-xs font-mono font-bold bg-[#FFFDF7] rounded-sm">Cancel</button>
                <button type="button" @onclick="ConfirmSealBook" class="ink-btn px-4 py-1 text-xs font-mono font-bold bg-[#D93829] text-[#FFFDF7] rounded-sm">Delete</button>
            </div>
        </div>
    </div>
}

<EditTomeModal IsOpen="isEditModalOpen" Book="bookToEdit" OnClose="() => isEditModalOpen = false" OnSaved="HandleBookUpdated" />

@code {
    private string activeTab = "ledger";
    private string selectedAction = "All";
    private List<AuditLog> auditLogs = new();
    private List<Book> activeBooks = new();
    private List<Book> sealedBooks = new();
    private bool isSealPromptOpen = false;
    private Book? bookToSeal;
    private string sealReason = "";
    private bool isEditModalOpen = false;
    private Book? bookToEdit;

    private readonly Dictionary<string, string> actionFilters = new()
    {
        { "All", "All" }, { "UPLOAD_BOOK", "Uploads" }, { "DOWNLOAD_BOOK", "Downloads" },
        { "EDIT_BOOK", "Edits" }, { "DELETE_BOOK", "Deletions" }, { "RESTORE_BOOK", "Restores" },
        { "POST_COMMENT", "Notes" }, { "SCHOLAR_SIGN_IN", "Sign Ins" }
    };

    protected override async Task OnInitializedAsync() { AuthState.OnChange += HandleAuthChange; await LoadDataAsync(); }
    private void HandleAuthChange() => InvokeAsync(async () => { await LoadDataAsync(); StateHasChanged(); });

    private async Task LoadDataAsync()
    {
        if (!AuthState.IsAuditor) return;
        auditLogs = await ArchiveService.GetAuditLogsAsync(selectedAction);
        activeBooks = await ArchiveService.GetBooksAsync("All", null, 100);
        sealedBooks = await ArchiveService.GetSealedBooksAsync(100);
    }

    private async Task FilterByAction(string action) { selectedAction = action; auditLogs = await ArchiveService.GetAuditLogsAsync(selectedAction); }
    private void PromptSeal(Book book) { bookToSeal = book; sealReason = "Content moderation"; isSealPromptOpen = true; }

    private async Task ConfirmSealBook()
    {
        if (bookToSeal == null || !AuthState.IsAuditor) return;
        var u = AuthState.CurrentUser!;
        if (await ArchiveService.SoftDeleteBookAsync(bookToSeal.Id, u.Username, u.Role, sealReason))
        {
            isSealPromptOpen = false; bookToSeal = null; await LoadDataAsync();
        }
    }

    private async Task RestoreBook(long id)
    {
        if (!AuthState.IsAuditor) return;
        var u = AuthState.CurrentUser!;
        if (await ArchiveService.RestoreBookAsync(id, u.Username, u.Role)) await LoadDataAsync();
    }

    private void OpenEditModal(Book book) { bookToEdit = book; isEditModalOpen = true; }
    private async Task HandleBookUpdated(Book updated) { isEditModalOpen = false; await LoadDataAsync(); }
    private async Task SignInAsAltair() { await AuthState.SignInAsync("Altair", "masyaf1191"); await LoadDataAsync(); }
    public void Dispose() => AuthState.OnChange -= HandleAuthChange;
}
